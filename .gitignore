# Rust
/target
**/*.rs.bk
Cargo.lock.bak

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Env + secrets
.env
.env.local
*.pem
*.key

# Local data (generated at runtime)
/artifacts/
/logs/
/backups/
/data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Everything in /config/ and /profile/ is generated by `careerai init`
# from embedded templates in crates/careerai-core/src/templates/.
# Source of truth is the crate, never the working tree.
/config/
/profile/
/.env.example

# Hook working dir
/.remember/logs/

# Python leftovers (belt-and-suspenders; deleted in M0)
__pycache__/
*.py[oc]
.venv/
