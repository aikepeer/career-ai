#!/usr/bin/env bash
set -euo pipefail

SERVICE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if [ "${CAREERAI_ENVDIR_LOADED:-}" != "1" ] && [ -d "${SERVICE_DIR}/env" ]; then
  export CAREERAI_ENVDIR_LOADED=1
  exec chpst -e "${SERVICE_DIR}/env" "$0" "$@"
fi

CAREERAI_LOG_USER="${CAREERAI_LOG_USER:?CAREERAI_LOG_USER must be set}"
CAREERAI_LOG_DIR="${CAREERAI_LOG_DIR:-./main}"

exec chpst -u "${CAREERAI_LOG_USER}" svlogd "${CAREERAI_LOG_DIR}"
