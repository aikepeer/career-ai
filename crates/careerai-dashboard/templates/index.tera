  { name: 'Spearbit', url: 'https://spearbit.com', category: 'web3', reward: 'Crypto + retainer', desc: 'Decentralized security researcher collective with audit contests.', api: false }
];

function renderBountyCards(platforms) {
  var grid = document.getElementById('bounty-grid');
  if (!grid) return;
  var countEl = document.getElementById('bounty-platform-count');
  var totalEl = document.getElementById('bounty-total-count');
  if (countEl) countEl.textContent = BOUNTY_PLATFORMS.length;
  if (totalEl) totalEl.textContent = BOUNTY_PLATFORMS.length;

  if (!platforms || platforms.length === 0) {
    grid.innerHTML = '<div class="bounty-empty">No platforms match your filter. Try a different category or search term.</div>';
    return;
  }

  var categoryIcons = {
    'bug-bounty': '🐛', 'hackathon': '🏆', 'coding': '💻',
    'opensource': '📦', 'ai-ml': '🧠', 'web3': '⛓️'
  };
  var categoryLabels = {
    'bug-bounty': 'Bug Bounty', 'hackathon': 'Hackathon', 'coding': 'Coding',
    'opensource': 'Open Source', 'ai-ml': 'AI / ML', 'web3': 'Web3'
  };

  grid.innerHTML = platforms.map(function(p) {
    var icon = categoryIcons[p.category] || '⭐';
    var label = categoryLabels[p.category] || p.category;
    var apiBadge = p.api ? '<span class="bounty-api-badge">API</span>' : '';
    return '<a href="' + p.url + '" target="_blank" rel="noopener noreferrer" class="bounty-card bounty-cat-' + p.category + '" data-category="' + p.category + '" data-name="' + p.name.toLowerCase() + '">'
      + '<div class="bounty-card-header">'
        + '<span class="bounty-card-icon">' + icon + '</span>'
        + '<span class="bounty-card-cat">' + label + '</span>'
        + apiBadge
      + '</div>'
      + '<h3 class="bounty-card-name">' + escapeHtml(p.name) + '</h3>'
      + '<p class="bounty-card-desc">' + escapeHtml(p.desc) + '</p>'
      + '<div class="bounty-card-footer">'
        + '<span class="bounty-card-reward">' + escapeHtml(p.reward) + '</span>'
        + '<span class="bounty-card-cta">Visit ↗</span>'
      + '</div>'
    + '</a>';
  }).join('');
}

function filterBountyCategory(category, el) {
  document.querySelectorAll('#tab-bounties .filter-pill').forEach(function(p) { p.classList.remove('active'); });
  if (el) el.classList.add('active');
  var filtered = category === 'all' ? BOUNTY_PLATFORMS : BOUNTY_PLATFORMS.filter(function(p) { return p.category === category; });
  renderBountyCards(filtered);
}

function filterBountyCards(query) {
  var q = (query || '').trim().toLowerCase();
  if (!q) { renderBountyCards(BOUNTY_PLATFORMS); return; }
  var filtered = BOUNTY_PLATFORMS.filter(function(p) {
    return p.name.toLowerCase().includes(q) || p.desc.toLowerCase().includes(q) || p.reward.toLowerCase().includes(q) || p.category.includes(q);
  });
  renderBountyCards(filtered);
}

document.addEventListener('DOMContentLoaded', function() {
  renderBountyCards(BOUNTY_PLATFORMS);
});

// PWA service worker registration
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('/sw.js').catch(function() {});
}
</script>
</body>
</html>
