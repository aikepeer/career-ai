  { name: 'CodeChef', url: 'https://www.codechef.com', category: 'coding', reward: 'Cash + rating', desc: 'Competitive programming contests with monthly cook-offs and lunchtimes.', api: true },
  { name: 'LeetCode Contests', url: 'https://leetcode.com/contest', category: 'coding', reward: 'Cash + leetcode coins', desc: 'Weekly and biweekly contests with cash prizes for top performers.', api: false },
