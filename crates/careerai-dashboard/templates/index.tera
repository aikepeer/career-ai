function runBatchTailorSequence(ids, btn) {
  var orig = btn ? btn.innerHTML : '';
  if (btn) { btn.disabled = true; btn.innerHTML = '⏳ Tailoring ' + ids.length + '...'; }
  var nextIndex = 0;
  var failed = [];
  function processNext() {
    if (nextIndex >= ids.length) {
      if (failed.length === 0) {
        if (btn) btn.innerHTML = '✅ All ' + ids.length + ' Tailored!';
      } else {
        if (btn) btn.innerHTML = '⚠️ ' + failed.length + '/' + ids.length + ' failed';
        console.warn('Batch tailor failures:', failed);
      }
      setTimeout(function() { location.reload(); }, 1500);
      return;
    }
    var id = ids[nextIndex];
    if (btn) btn.innerHTML = '⏳ Tailoring (' + (nextIndex + 1) + '/' + ids.length + ')...';
    fetch('/api/v1/cli/run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ command: 'tailor', args: { listing_id: id } })
    })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (d.status !== 'success') {
        failed.push({ id: id, error: d.error || d.message || 'unknown' });
        console.error('Tailor failed for', id, ':', d.error || d.message);
      }
      nextIndex++;
      processNext();
    })
    .catch(function(err) {
      failed.push({ id: id, error: String(err) });
      nextIndex++;
      processNext();
    });
  }
  processNext();
}

