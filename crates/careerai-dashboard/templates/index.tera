function batchRollback(fromState, toState, btn) {
  if (!confirm('Are you sure you want to rollback all ' + fromState + ' jobs to ' + toState + '?')) return;
  var orig = btn ? btn.innerHTML : '';
  if (btn) { btn.disabled = true; btn.innerHTML = '⏳ Rolling back...'; }
  fetch('/api/v1/cli/run', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ command: 'rollback', args: { all: true, from_state: fromState, to: toState } })
  })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    if (d.status === 'success') {
      if (btn) btn.innerHTML = '✅ Rolled back!';
      setTimeout(function() { location.reload(); }, 1000);
    } else {
      if (btn) btn.innerHTML = '❌ ' + (d.error || d.message || 'Failed');
      setTimeout(function() { if (btn) { btn.disabled = false; btn.innerHTML = orig; } }, 3000);
    }
  })
  .catch(function(err) {
    if (btn) btn.innerHTML = '❌ Error';
    setTimeout(function() { if (btn) { btn.disabled = false; btn.innerHTML = orig; } }, 3000);
  });
}

function runBatchRenderSequence(ids, btn) {
  var orig = btn ? btn.innerHTML : '';
  if (btn) { btn.disabled = true; btn.innerHTML = '⏳ Rendering ' + ids.length + '...'; }
  var nextIndex = 0;
  function processNext() {
    if (nextIndex >= ids.length) {
      if (btn) btn.innerHTML = '✅ All Rendered!';
      setTimeout(function() { location.reload(); }, 1200);
      return;
    }
    var id = ids[nextIndex];
    if (btn) btn.innerHTML = '⏳ Rendering (' + (nextIndex + 1) + '/' + ids.length + ')...';
    fetch('/api/v1/cli/run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ command: 'render', args: { application_id: id } })
    })
    .then(function() {
      nextIndex++;
      processNext();
    })
    .catch(function() {
      nextIndex++;
      processNext();
    });
  }
  processNext();
}

