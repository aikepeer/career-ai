function runBatchApplySequence(ids, btn) {
  var live = confirm("🚀 Submit " + ids.length + " selected applications LIVE to company job boards?\n\n• Click OK for LIVE Submission (submits and moves to Applied column)\n• Click Cancel for DRY-RUN Preview");
  var orig = btn ? btn.innerHTML : '';
  if (btn) { btn.disabled = true; btn.innerHTML = live ? '⏳ Submitting Live (' + ids.length + ')...' : '⏳ Dry-Run (' + ids.length + ')...'; }
  var notif = createNotificationToast(
    live ? 'Live Submitting Applications' : 'Dry-Run Submitting Applications',
    'Processing ' + ids.length + ' selected applications...',
    '🚀'
  );
  var nextIndex = 0;
  function processNext() {
    if (nextIndex >= ids.length) {
      if (btn) btn.innerHTML = '✅ Done!';
      notif.success(live ? 'All ' + ids.length + ' applications submitted live!' : 'All ' + ids.length + ' applications validated!');
      setTimeout(function() { location.reload(); }, 1200);
      return;
    }
    var id = ids[nextIndex];
    if (btn) btn.innerHTML = '⏳ (' + (nextIndex + 1) + '/' + ids.length + ')...';
    notif.update('Processing application ' + (nextIndex + 1) + ' of ' + ids.length + '...');
    fetch('/api/v1/cli/run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ command: 'apply', args: { application_id: id, auto_submit: live } })
    })
    .then(function() {
      nextIndex++;
      processNext();
    })
    .catch(function() {
      nextIndex++;
      processNext();
    });
  }
  processNext();
}

function toggleKeyword(kw) {
  fetch('/api/v1/config/keywords', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ keyword: kw, action: 'remove' })
  })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    if (d.status === 'success') {
      document.querySelectorAll('.kw-chip, .keyword-orbit-node').forEach(function(el) {
        if ((el.dataset.keyword || '') === kw) el.remove();
      });
      updateKeywordSignalCount(-1);
      if (window.layoutDiscoveryWorld) window.layoutDiscoveryWorld();
    }
  })
  .catch(function(err) { console.warn('Toggle keyword failed:', err); });
}

function sortKeywordsContainer() {
  var container = document.getElementById('keywords-container');
  if (!container) return;
  var chips = Array.from(container.querySelectorAll('.kw-chip'));
  chips.sort(function(a, b) {
    return a.textContent.trim().toLowerCase().localeCompare(b.textContent.trim().toLowerCase());
  });
  chips.forEach(function(c) { container.appendChild(c); });
}

function addCustomKeyword() {
  var inp = document.getElementById('new-kw-input');
  var kw = (inp.value || '').trim();
  if (!kw) return;
  fetch('/api/v1/config/keywords', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ keyword: kw, action: 'add' })
  })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    if (d.status === 'success') {
      inp.value = '';
      var container = document.getElementById('keywords-container');
      var chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'kw-chip';
      chip.dataset.keyword = kw;
      chip.title = 'Remove ' + kw;
      chip.addEventListener('click', function() { toggleKeyword(kw); });
      chip.innerHTML = '<span><i></i>' + escapeHtml(kw) + '</span><b aria-hidden="true">×</b>';
      container.appendChild(chip);
      var constellation = document.getElementById('signal-constellation');
      if (constellation && constellation.querySelectorAll('.keyword-orbit-node:not(.keyword-orbit-secondary)').length < 28) {
        var node = document.createElement('button');
        node.type = 'button';
        node.className = 'keyword-orbit-node';
        node.dataset.keyword = kw;
        node.dataset.keywordIndex = String(constellation.children.length);
        node.title = kw + ' · click to remove';
        node.addEventListener('click', function() { toggleKeyword(kw); });
        node.innerHTML = '<i aria-hidden="true"></i><span>' + escapeHtml(kw) + '</span>';
        constellation.appendChild(node);
      }
      sortKeywordsContainer();
      updateKeywordSignalCount(1);
      if (window.layoutDiscoveryWorld) window.layoutDiscoveryWorld();
    }
  })
  .catch(function(err) { console.warn('Add keyword failed:', err); });
}

function updateKeywordSignalCount(delta) {
  var value = document.querySelector('.globe-core-copy strong');
  if (value) value.textContent = Math.max(0, (parseInt(value.textContent, 10) || 0) + delta);
  var summary = document.querySelector('.keyword-vault summary > strong');
  if (summary) {
    var count = Math.max(0, (parseInt(summary.textContent, 10) || 0) + delta);
    summary.firstChild.textContent = count + ' signals ';
  }
}

function filterKeywordVault(query) {
  var q = (query || '').trim().toLowerCase();
  document.querySelectorAll('#keywords-container .kw-chip').forEach(function(chip) {
    chip.hidden = q && !(chip.dataset.keyword || '').toLowerCase().includes(q);
  });
}

function filterExplorerBySource(srcName) {
  switchTab('explorer');
  var inp = document.getElementById('explorer-search-input');
  if (inp) {
    inp.value = srcName;
    try { sessionStorage.setItem('careerai-exp-search', srcName); } catch(e) {}
  }
  filterExplorerTable();
}

function runCliCommand(command, args, btn) {
  var originalText = btn ? btn.innerHTML : '';
  if (btn) { btn.disabled = true; btn.innerHTML = '⏳ Running...'; }

  var meta = getCommandMeta(command, args);
  var notif = createNotificationToast(meta.title, meta.desc, meta.icon);

  var contentCommands = ['interview', 'email', 'negotiate', 'upskill', 'review', 'patterns'];

  fetch('/api/v1/cli/run', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ command: command, args: args || {} })
  })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (d.status === 'success') {
        if (btn) btn.innerHTML = '✅ Done!';
        notif.success('Execution completed successfully!');

        if (contentCommands.indexOf(command) !== -1 && d.message) {
          showCommandOutput(meta.title, d.message, meta.icon);
        }

        setTimeout(function() {
          if (btn) { btn.disabled = false; btn.innerHTML = originalText; }
          refreshExplorerListings();
          if (contentCommands.indexOf(command) === -1 && command !== 'discover') location.reload();
        }, 1500);
      } else {
        var message = d.status === 'busy' ? 'Busy — another run is in progress' : (d.error || d.message || 'Failed');
        if (btn) btn.innerHTML = '❌ ' + message;
        notif.error(message);
        setTimeout(function() {
          if (btn) { btn.disabled = false; btn.innerHTML = originalText; }
        }, 3000);
      }
    })
    .catch(function(err) {
      if (btn) btn.innerHTML = '❌ Error';
      notif.error(err.message || 'Network error executing command');
      setTimeout(function() {
        if (btn) { btn.disabled = false; btn.innerHTML = originalText; }
      }, 3000);
    });
}

function showCommandOutput(title, output, icon) {
  var overlay = document.createElement('div');
  overlay.className = 'cmd-output-overlay';
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:9999;display:flex;align-items:center;justify-content:center;padding:24px;';

  var modal = document.createElement('div');
  modal.className = 'cmd-output-modal';
  modal.style.cssText = 'background:var(--bg-card);border:1px solid var(--border);border-radius:12px;max-width:760px;width:100%;max-height:80vh;display:flex;flex-direction:column;box-shadow:0 24px 64px rgba(0,0,0,0.4);';

  var header = document.createElement('div');
  header.style.cssText = 'display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid var(--border);';
  header.innerHTML = '<div style="display:flex;align-items:center;gap:8px;"><span style="font-size:18px;">' + icon + '</span><strong style="font-size:14px;">' + escapeHtml(title) + '</strong></div>';

  var closeBtn = document.createElement('button');
  closeBtn.textContent = '✕';
  closeBtn.style.cssText = 'background:none;border:none;color:var(--text-secondary);font-size:18px;cursor:pointer;padding:4px 8px;';
  closeBtn.onclick = function() { overlay.remove(); };
  header.appendChild(closeBtn);

  var body = document.createElement('pre');
  body.style.cssText = 'padding:20px;overflow:auto;font-family:var(--mono);font-size:13px;line-height:1.5;color:var(--text-primary);white-space:pre-wrap;word-break:break-word;';
  body.textContent = output;

  modal.appendChild(header);
  modal.appendChild(body);
  overlay.appendChild(modal);
  overlay.addEventListener('click', function(e) { if (e.target === overlay) overlay.remove(); });
  document.body.appendChild(overlay);
}

// Commands-tab runner for cards that need an id argument. `tailor`
// takes a listing id; render/apply/retry/inspect take an application
// id. A blank id on `apply` means --all (dry-run still applies).
function runCliCommandWithId(command, inputEl, btn) {
  var id = ((inputEl && inputEl.value) || '').trim();
  var args = {};
  if (command === 'tailor') {
    args.listing_id = id;
  } else {
    args.application_id = id;
  }
  if (!id) {
    if (command === 'apply') {
      args = { all: true };
      delete args.application_id;
    } else {
      if (inputEl) {
        inputEl.focus();
        inputEl.placeholder = 'Enter an id first';
      }
      return;
    }
  }
  runCliCommand(command, args, btn);
}

function copyCliCommand(argv, btn) {
  var done = function() {
    if (!btn) return;
    var t = btn.innerHTML;
    btn.innerHTML = '✅ Copied';
    setTimeout(function() { btn.innerHTML = t; }, 1200);
  };
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(argv).then(done, done);
  } else {
    var ta = document.createElement('textarea');
    ta.value = argv;
    document.body.appendChild(ta);
    ta.select();
    try { document.execCommand('copy'); } catch(e) {}
    ta.remove();
    done();
  }
}

function forceShortlist(id) {
  fetch('/api/v1/listings/' + encodeURIComponent(id) + '/shortlist', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function() { location.reload(); })
    .catch(function(err) { alert('Failed to shortlist: ' + err); });
}

function sendConfigPrompt() {
  var input = document.getElementById('config-chat-input');
  var responseEl = document.getElementById('config-chat-response');
  var prompt = (input.value || '').trim();
  if (!prompt) return;
  responseEl.style.display = 'block';
  responseEl.innerText = 'Analyzing prompt...';
  fetch('/api/v1/config/prompt', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ prompt: prompt })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    responseEl.innerText = data.response || JSON.stringify(data, null, 2);
  })
  .catch(function(err) {
    responseEl.innerText = 'Error: ' + err;
  });
}

function usePromptChip(text) {
  var input = document.getElementById('chat-input');
  if (input) {
    input.value = text;
    input.focus();
  }
}

// Chat history is persisted as structured {role, text, time} entries, not
// as a raw innerHTML blob. Restoring re-renders each entry through the
// same escaping path used at send time, so a saved conversation can never
// smuggle markup into the page.
var chatMessages = [];

function appendChatMessage(role, text, time) {
  var container = document.getElementById('chat-messages');
  if (!container) return;
  var div = document.createElement('div');
  div.className = role === 'user' ? 'chat-msg msg-user' : 'chat-msg msg-assistant';
  var avatar = role === 'user' ? '👤' : '🤖';
  var author = role === 'user' ? 'You' : 'Career-AI Assistant';
  var timeLabel = time || 'Just now';
  div.innerHTML = '<div class="msg-avatar">' + avatar + '</div>' +
    '<div class="msg-content">' +
      '<div class="msg-header"><span class="msg-author">' + escapeHtml(author) + '</span><span class="msg-time">' + escapeHtml(timeLabel) + '</span></div>' +
      '<div class="msg-text">' + (role === 'user' ? escapeHtml(text) : formatMarkdownResponse(text)) + '</div>' +
    '</div>';
  container.appendChild(div);
}

function saveChatHistory() {
  try { localStorage.setItem('careerai-chat-history', JSON.stringify(chatMessages)); } catch(e) {}
}

function clearChatHistory() {
  chatMessages = [{
    role: 'assistant',
    text: 'Hello! Chat history cleared. How can I help you?',
    time: 'Just now'
  }];
  try {
    localStorage.removeItem('careerai-chat-history');
    sessionStorage.removeItem('careerai-chat-draft');
  } catch(e) {}
  var container = document.getElementById('chat-messages');
  if (container) {
    container.innerHTML = '';
    chatMessages.forEach(function(m) { appendChatMessage(m.role, m.text, m.time); });
  }
}

function sendChatMessage(event) {
  if (event) event.preventDefault();
  var input = document.getElementById('chat-input');
  var text = (input.value || '').trim();
  if (!text) return;

  var container = document.getElementById('chat-messages');
  chatMessages.push({ role: 'user', text: text, time: 'Just now' });
  appendChatMessage('user', text, 'Just now');

  input.value = '';
  try { sessionStorage.removeItem('careerai-chat-draft'); } catch(e) {}
  container.scrollTop = container.scrollHeight;
  saveChatHistory();

  var aiDiv = document.createElement('div');
  aiDiv.className = 'chat-msg msg-assistant';
  aiDiv.innerHTML = '<div class="msg-avatar">🤖</div>' +
    '<div class="msg-content">' +
      '<div class="msg-header"><span class="msg-author">Career-AI Assistant</span><span class="msg-time">Thinking...</span></div>' +
      '<div class="msg-text msg-loading">Thinking...</div>' +
    '</div>';
  container.appendChild(aiDiv);
  container.scrollTop = container.scrollHeight;

  fetch('/api/v1/chat', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ message: text })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    var textEl = aiDiv.querySelector('.msg-text');
    var timeEl = aiDiv.querySelector('.msg-time');
    if (timeEl) timeEl.innerText = 'Just now';
    var reply = data.reply || data.error || 'No response from assistant.';
    if (textEl) {
      textEl.classList.remove('msg-loading');
      if (data.reply) {
        textEl.innerHTML = formatMarkdownResponse(data.reply);
      } else {
        textEl.innerText = reply;
      }
    }
    chatMessages.push({ role: 'assistant', text: reply, time: 'Just now' });
    container.scrollTop = container.scrollHeight;
    saveChatHistory();
  })
  .catch(function(err) {
    var textEl = aiDiv.querySelector('.msg-text');
    if (textEl) {
      textEl.classList.remove('msg-loading');
      textEl.innerText = 'Error connecting to assistant: ' + err;
    }
    chatMessages.push({ role: 'assistant', text: 'Error connecting to assistant: ' + err, time: 'Just now' });
    saveChatHistory();
  });
}

// Escape for a single-quoted JS string embedded in an HTML attribute.
// Backslashes and quotes must be escaped for the JS parser; `&`, `<`,
// `>`, and `"` become entities so the surrounding `onclick="..."` HTML
// attribute cannot be terminated.
function escapeJsString(str) {
  return String(str)
    .replace(/\\/g, "\\\\")
    .replace(/'/g, "\\'")
    .replace(/&/g, "\\x26")
    .replace(/</g, "\\x3c")
    .replace(/>/g, "\\x3e")
    .replace(/"/g, "&quot;")
    .replace(/\n/g, "\\n")
    .replace(/\r/g, "\\r");
}

function formatMarkdownResponse(md) {
  // Escape first so the LLM reply (which echoes the user's message) can
  // never smuggle raw HTML into `innerHTML`, then apply the small
  // markdown subset the assistant actually emits.
  return escapeHtml(md)
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.*?)\*/g, '<em>$1</em>')
    .replace(/`(.*?)`/g, '<code>$1</code>')
    .replace(/\n/g, '<br>');
}

function restoreWorkspaceTab() {
  var savedTab;
  try { savedTab = localStorage.getItem('careerai-active-tab'); } catch(e) {}
  var requestedTab = new URLSearchParams(window.location.search).get('tab');
  var validTabs = ['funnel', 'events', 'config', 'actions', 'explorer', 'commands', 'analytics', 'bounties', 'chat'];
  if (requestedTab && validTabs.indexOf(requestedTab) !== -1) {
    switchTab(requestedTab);
  } else if (savedTab && validTabs.indexOf(savedTab) !== -1) {
    switchTab(savedTab);
  }
}

// State Restoration & Event Handlers on Page Load
document.addEventListener('DOMContentLoaded', function() {
  restoreWorkspaceTab();

  // Restore LLM Form Settings (Backend, Model, Base URL, API Key, Timeout)
  try {
    var savedBackend = localStorage.getItem('careerai-cfg-backend');
    if (savedBackend && document.getElementById('cfg-backend')) document.getElementById('cfg-backend').value = savedBackend;
    var savedModel = localStorage.getItem('careerai-cfg-model');
    if (savedModel && document.getElementById('cfg-model')) document.getElementById('cfg-model').value = savedModel;
    var savedApiBase = localStorage.getItem('careerai-cfg-api-base');
    if (savedApiBase && document.getElementById('cfg-api-base')) document.getElementById('cfg-api-base').value = savedApiBase;
    var savedTimeout = localStorage.getItem('careerai-cfg-timeout');
    if (savedTimeout && document.getElementById('cfg-timeout')) document.getElementById('cfg-timeout').value = savedTimeout;
  } catch(e) {}

  // Restore Candidate Profile Fields
  try {
    ['name', 'email', 'phone', 'location', 'roles', 'languages', 'frameworks', 'tools'].forEach(function(f) {
      var val = localStorage.getItem('careerai-pf-' + f);
      var el = document.getElementById('pf-' + f);
      if (val && el && !el.value) el.value = val;
    });
  } catch(e) {}

  // Restore Chat History (structured JSON, re-rendered with escaping)
  try {
    var savedChat = localStorage.getItem('careerai-chat-history');
    if (savedChat) {
      var parsed = JSON.parse(savedChat);
      if (Array.isArray(parsed)) {
        chatMessages = parsed.filter(function(m) {
          return m && (m.role === 'user' || m.role === 'assistant') && typeof m.text === 'string';
        });
        var container = document.getElementById('chat-messages');
        if (container) {
          container.innerHTML = '';
          chatMessages.forEach(function(m) { appendChatMessage(m.role, m.text, m.time); });
        }
      }
    }
  } catch(e) {}

  // Restore Chat Input Draft
  try {
    var draftInput = sessionStorage.getItem('careerai-chat-draft');
    if (draftInput) {
      var input = document.getElementById('chat-input');
      if (input) input.value = draftInput;
    }
  } catch(e) {}

  // Draft Event Listeners
  document.getElementById('chat-input')?.addEventListener('input', function(e) {
    try { sessionStorage.setItem('careerai-chat-draft', e.target.value); } catch(err) {}
  });

  document.getElementById('config-chat-input')?.addEventListener('input', function(e) {
    try { sessionStorage.setItem('careerai-cfg-prompt', e.target.value); } catch(err) {}
  });

  // Auto-save LLM form inputs to localStorage as user types
  ['cfg-backend', 'cfg-model', 'cfg-api-base', 'cfg-timeout'].forEach(function(id) {
    var el = document.getElementById(id);
    el?.addEventListener('input', function(e) {
      try { localStorage.setItem('careerai-' + id, e.target.value); } catch(err) {}
    });
    el?.addEventListener('change', function(e) {
      try { localStorage.setItem('careerai-' + id, e.target.value); } catch(err) {}
    });
  });

  // Auto-save Profile form inputs to localStorage as user types
  ['name', 'email', 'phone', 'location', 'roles', 'languages', 'frameworks', 'tools'].forEach(function(f) {
    document.getElementById('pf-' + f)?.addEventListener('input', function(e) {
      try { localStorage.setItem('careerai-pf-' + f, e.target.value); } catch(err) {}
    });
  });

  document.getElementById('explorer-search-input')?.addEventListener('input', function(e) {
    try { sessionStorage.setItem('careerai-exp-search', e.target.value); } catch(err) {}
    filterExplorerTable();
  });

  // Lazy-load explorer rows after page paint. If explorer tab is not
  // currently active, defer the fetch to idle time to prioritize the critical
  // view.
  {% if view.explorer_lazy %}
  if (document.getElementById('tab-explorer').classList.contains('active')) {
    lazyLoadExplorer();
  } else if ('requestIdleCallback' in window) {
    requestIdleCallback(function() { lazyLoadExplorer(); }, { timeout: 2000 });
  } else {
    setTimeout(lazyLoadExplorer, 800);
  }
  {% endif %}

  // F01: Load first-session onboarding banner on page load.
  if (typeof loadOnboarding === 'function') loadOnboarding();
});

var _explorerLoaded = false;
var _allExplorerItems = [];

// ---- Analytics tab lazy loader ----
var _analyticsLoaded = false;
function lazyLoadAnalytics() {
  if (_analyticsLoaded) return;
  _analyticsLoaded = true;
  fetch('/api/v1/analytics')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      document.getElementById('analytics-loading').style.display = 'none';
      document.getElementById('analytics-content').style.display = 'block';

      // Reposts
      var reposts = data.reposts || [];
      var rc = document.getElementById('reposts-count');
      if (rc) rc.textContent = '(' + reposts.length + ' detected)';
      var rd = document.getElementById('analytics-reposts');
      if (reposts.length === 0) {
        rd.innerHTML = '<p style="color:var(--text-secondary); padding:8px 0;">No reposts detected.</p>';
      } else {
        var html = '<table class="data-table"><thead><tr><th>Company</th><th>Title</th><th>Source</th><th>Occurrences</th><th>First Seen</th><th>Last Seen</th></tr></thead><tbody>';
        reposts.forEach(function(r) {
          html += '<tr><td>' + escapeHtml(r.company) + '</td><td>' + escapeHtml(r.title) + '</td><td>' + escapeHtml(r.source) + '</td><td>' + r.occurrences + '</td><td>' + r.first_seen + '</td><td>' + r.last_seen + '</td></tr>';
        });
        html += '</tbody></table>';
        rd.innerHTML = html;
      }

      // Funnel velocity
      var funnel = data.funnel_velocity || [];
      var fd = document.getElementById('analytics-funnel');
      if (funnel.length === 0) {
        fd.innerHTML = '<p style="color:var(--text-secondary); padding:8px 0;">No funnel data yet.</p>';
      } else {
        var html = '<table class="data-table"><thead><tr><th>Source</th><th>Discovered</th><th>Shortlisted</th><th>Submitted</th><th>Responded</th><th>Rejected</th></tr></thead><tbody>';
        funnel.forEach(function(f) {
          html += '<tr><td>' + escapeHtml(f.source) + '</td><td>' + f.discovered + '</td><td>' + f.shortlisted + '</td><td>' + f.submitted + '</td><td>' + f.responded + '</td><td>' + f.rejected + '</td></tr>';
        });
        html += '</tbody></table>';
        fd.innerHTML = html;
      }

      // Advance rates
      var advances = data.advance_rates || [];
      var ad = document.getElementById('analytics-advance');
      if (advances.length === 0) {
        ad.innerHTML = '<p style="color:var(--text-secondary); padding:8px 0;">No submission data yet.</p>';
      } else {
        var html = '<table class="data-table"><thead><tr><th>Source</th><th>Submitted</th><th>Responded</th><th>Advance Rate</th></tr></thead><tbody>';
        advances.forEach(function(a) {
          var pct = (a.rate * 100).toFixed(1) + '%';
          html += '<tr><td>' + escapeHtml(a.source) + '</td><td>' + a.submitted + '</td><td>' + a.responded + '</td><td>' + pct + '</td></tr>';
        });
        html += '</tbody></table>';
        ad.innerHTML = html;
      }

      // Rejection latencies
      var rejections = data.rejection_latencies || [];
      var jd = document.getElementById('analytics-rejections');
      if (rejections.length === 0) {
        jd.innerHTML = '<p style="color:var(--text-secondary); padding:8px 0;">No rejection data yet.</p>';
      } else {
        var html = '<table class="data-table"><thead><tr><th>Company</th><th>Title</th><th>Source</th><th>Days to Reject</th></tr></thead><tbody>';
        rejections.forEach(function(r) {
          html += '<tr><td>' + escapeHtml(r.company) + '</td><td>' + escapeHtml(r.title) + '</td><td>' + escapeHtml(r.source) + '</td><td>' + r.days_to_reject.toFixed(1) + '</td></tr>';
        });
        html += '</tbody></table>';
        jd.innerHTML = html;
      }
    })
    .catch(function(err) {
      var el = document.getElementById('analytics-loading');
      if (el) el.innerHTML = '<p style="color:#f87171;">Failed to load analytics: ' + err + '</p>';
    });

  // Load source attribution
  fetch('/api/v1/source-attribution').then(function(r){return r.json();}).then(function(data) {
    var el = document.getElementById('analytics-source-attribution');
    if (!el || !Array.isArray(data) || data.length === 0) { if(el) el.innerHTML = '<p style="color:var(--text-secondary);">No source data yet.</p>'; return; }
    var html = '<table class="data-table"><thead><tr><th>Source</th><th>Discovered</th><th>Submitted</th><th>Responded</th><th>Response Rate</th></tr></thead><tbody>';
    data.forEach(function(s) {
      var pct = (s.response_rate * 100).toFixed(1) + '%';
      html += '<tr><td>' + escapeHtml(s.source) + '</td><td>' + s.discovered + '</td><td>' + s.submitted + '</td><td>' + s.responded + '</td><td>' + pct + '</td></tr>';
    });
    html += '</tbody></table>';
    el.innerHTML = html;
  }).catch(function(err) { console.warn('Analytics fetch failed:', err); });

  // Load timing stats
  fetch('/api/v1/timing').then(function(r){return r.json();}).then(function(data) {
    var el = document.getElementById('analytics-timing');
    if (!el || !Array.isArray(data) || data.length === 0) { if(el) el.innerHTML = '<p style="color:var(--text-secondary);">No timing data yet.</p>'; return; }
    var days = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
    var html = '<table class="data-table"><thead><tr><th>Day</th><th>Submitted</th><th>Responded</th><th>Response Rate</th></tr></thead><tbody>';
    data.forEach(function(t) {
      var pct = (t.response_rate * 100).toFixed(1) + '%';
      var day = days[t.day_of_week] || t.day_of_week;
      html += '<tr><td>' + day + '</td><td>' + t.submitted + '</td><td>' + t.responded + '</td><td>' + pct + '</td></tr>';
    });
    html += '</tbody></table>';
    el.innerHTML = html;
  }).catch(function(err) { console.warn('Analytics fetch failed:', err); });

  // Load A/B variants
  fetch('/api/v1/variants').then(function(r){return r.json();}).then(function(data) {
    var el = document.getElementById('analytics-variants');
    if (!el || !Array.isArray(data) || data.length === 0) { if(el) el.innerHTML = '<p style="color:var(--text-secondary);">No variant data yet. Submit applications with different resume variants to start tracking.</p>'; return; }
    var html = '<table class="data-table"><thead><tr><th>Variant</th><th>Company</th><th>Title</th><th>Status</th></tr></thead><tbody>';
    data.forEach(function(v) {
      html += '<tr><td>' + escapeHtml(v.variant_label) + '</td><td>' + escapeHtml(v.company || '') + '</td><td>' + escapeHtml(v.title || '') + '</td><td>' + escapeHtml(v.response_status) + '</td></tr>';
    });
    html += '</tbody></table>';
    el.innerHTML = html;
  }).catch(function(err) { console.warn('Analytics fetch failed:', err); });

  // Load salary ranges
  fetch('/api/v1/salary-ranges').then(function(r){return r.json();}).then(function(data) {
    var el = document.getElementById('analytics-salary');
    if (!el || !Array.isArray(data) || data.length === 0) { if(el) el.innerHTML = '<p style="color:var(--text-secondary);">No salary data extracted yet. Salaries are auto-extracted from job descriptions during discovery.</p>'; return; }
    var html = '<table class="data-table"><thead><tr><th>Company</th><th>Title</th><th>Min</th><th>Max</th><th>Currency</th><th>Period</th></tr></thead><tbody>';
    data.forEach(function(s) {
      html += '<tr><td>' + escapeHtml(s.company) + '</td><td>' + escapeHtml(s.title) + '</td><td>' + (s.min_salary || '—') + '</td><td>' + (s.max_salary || '—') + '</td><td>' + escapeHtml(s.currency) + '</td><td>' + escapeHtml(s.period) + '</td></tr>';
    });
    html += '</tbody></table>';
    el.innerHTML = html;
  }).catch(function(err) { console.warn('Analytics fetch failed:', err); });

  // Load market pulse
  fetch('/api/v1/market-pulse').then(function(r){return r.json();}).then(function(data) {
    var el = document.getElementById('analytics-market-pulse');
    if (!el || data.error) { if(el) el.innerHTML = '<p style="color:var(--text-secondary);">Market pulse data unavailable.</p>'; return; }
    var html = '<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:10px; margin-bottom:10px;">';
    html += '<div style="background:var(--bg-card); border:1px solid var(--border); border-radius:6px; padding:10px;"><small style="color:var(--text-secondary);">New (7d)</small><br><b>' + data.new_listings_7d + '</b></div>';
    html += '<div style="background:var(--bg-card); border:1px solid var(--border); border-radius:6px; padding:10px;"><small style="color:var(--text-secondary);">New Companies</small><br><b>' + data.new_companies_7d + '</b></div>';
    html += '<div style="background:var(--bg-card); border:1px solid var(--border); border-radius:6px; padding:10px;"><small style="color:var(--text-secondary);">Submitted (7d)</small><br><b>' + data.submitted_7d + '</b></div>';
    html += '<div style="background:var(--bg-card); border:1px solid var(--border); border-radius:6px; padding:10px;"><small style="color:var(--text-secondary);">Responded (7d)</small><br><b>' + data.responded_7d + '</b></div>';
    html += '<div style="background:var(--bg-card); border:1px solid var(--border); border-radius:6px; padding:10px;"><small style="color:var(--text-secondary);">Avg Score</small><br><b>' + (data.avg_score_shortlisted || 0).toFixed(2) + '</b></div>';
    html += '</div>';
    if (data.top_hiring_companies && data.top_hiring_companies.length > 0) {
      html += '<div style="margin-top:8px;"><small style="color:var(--text-secondary);">Top hiring:</small> ';
      data.top_hiring_companies.slice(0,5).forEach(function(c) { html += '<span style="display:inline-block; margin:2px 4px; padding:2px 8px; background:rgba(129,140,248,0.1); border-radius:4px; font-size:11px;">' + escapeHtml(c.company || c[0]) + ' (' + (c.count || c[1]) + ')</span>'; });
      html += '</div>';
    }
    if (data.top_skills_in_jds && data.top_skills_in_jds.length > 0) {
      html += '<div style="margin-top:8px;"><small style="color:var(--text-secondary);">Trending skills:</small> ';
      data.top_skills_in_jds.slice(0,10).forEach(function(s) { html += '<span style="display:inline-block; margin:2px 4px; padding:2px 8px; background:rgba(34,211,238,0.1); border-radius:4px; font-size:11px;">' + escapeHtml(s.skill || s[0]) + '</span>'; });
      html += '</div>';
    }
    el.innerHTML = html;
  }).catch(function(err) { console.warn('Analytics fetch failed:', err); });

  // Load follow-ups
  fetch('/api/v1/follow-ups').then(function(r){return r.json();}).then(function(data) {
    var el = document.getElementById('analytics-follow-ups');
    if (!el || !Array.isArray(data) || data.length === 0) { if(el) el.innerHTML = '<p style="color:var(--text-secondary);">No pending follow-ups. Click "Check Now" to scan for stale applications.</p>'; return; }
    var html = '<table class="data-table"><thead><tr><th>Company</th><th>Title</th><th>Status</th><th>Scheduled</th><th>Step</th><th>Draft</th></tr></thead><tbody>';
    data.forEach(function(f) {
      var bodyPreview = escapeHtml((f.body || '').substring(0,100));
      if ((f.body || '').length > 100) bodyPreview += '…';
      html += '<tr><td>' + escapeHtml(f.company) + '</td><td>' + escapeHtml(f.title) + '</td><td>' + escapeHtml(f.status) + '</td><td>' + escapeHtml((f.scheduled_at || '').substring(0,10)) + '</td><td>' + (f.cadence_step || 1) + '</td><td style="max-width:300px; overflow:hidden; text-overflow:ellipsis;">' + bodyPreview + '</td></tr>';
    });
    html += '</tbody></table>';
    el.innerHTML = html;
  }).catch(function(err) { console.warn('Analytics fetch failed:', err); });

  // Load interview feedback
  fetch('/api/v1/interview-feedback').then(function(r){return r.json();}).then(function(data) {
    var el = document.getElementById('analytics-interview-feedback');
    if (!el || !Array.isArray(data) || data.length === 0) { if(el) el.innerHTML = '<p style="color:var(--text-secondary);">No interview feedback logged yet. Use the form below to add your first entry.</p>'; return; }
    var html = '<table class="data-table"><thead><tr><th>Company</th><th>Title</th><th>Rating</th><th>Questions</th><th>Date</th></tr></thead><tbody>';
    data.forEach(function(f) {
      var stars = '★'.repeat(f.rating) + '☆'.repeat(5 - f.rating);
      var q = (f.questions_text || '').split('\n').filter(function(l){return l.trim();}).length + ' questions';
      html += '<tr><td>' + escapeHtml(f.company) + '</td><td>' + escapeHtml(f.title) + '</td><td>' + stars + '</td><td>' + q + '</td><td>' + escapeHtml(f.created_at.substring(0,10)) + '</td></tr>';
    });
    html += '</tbody></table>';
    el.innerHTML = html;
  }).catch(function(err) { console.warn('Analytics fetch failed:', err); });
}

function checkFollowUps(btn) {
  if (btn) { btn.disabled = true; btn.textContent = '⏳ Checking...'; }
  fetch('/api/v1/follow-ups/check', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (btn) { btn.disabled = false; btn.textContent = 'Check Now'; }
      if (d.status === 'success') {
        alert('Created ' + d.created + ' follow-up drafts.');
        if (typeof lazyLoadAnalytics === 'function') { _analyticsLoaded = false; lazyLoadAnalytics(); }
      } else {
        alert('Error: ' + (d.error || 'Unknown'));
      }
    })
    .catch(function(err) {
      if (btn) { btn.disabled = false; btn.textContent = 'Check Now'; }
      alert('Error: ' + err);
    });
}

function saveInterviewFeedback(btn) {
  if (btn) { btn.disabled = true; btn.textContent = '⏳ Saving...'; }
  var payload = {
    application_id: document.getElementById('fb-app-id').value,
    listing_id: document.getElementById('fb-listing-id').value,
    company: document.getElementById('fb-company').value,
    title: document.getElementById('fb-title').value,
    questions_text: document.getElementById('fb-questions').value,
    rating: parseInt(document.getElementById('fb-rating').value),
    went_well: document.getElementById('fb-went-well').value,
    could_improve: document.getElementById('fb-improve').value,
  };
  fetch('/api/v1/interview-feedback', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (btn) { btn.disabled = false; btn.textContent = 'Save Feedback'; }
      if (d.status === 'success') {
        alert('Feedback saved!');
        _analyticsLoaded = false;
        if (typeof lazyLoadAnalytics === 'function') lazyLoadAnalytics();
      } else {
        alert('Error: ' + (d.error || 'Unknown'));
      }
    })
    .catch(function(err) {
      if (btn) { btn.disabled = false; btn.textContent = 'Save Feedback'; }
      alert('Error: ' + err);
    });
}

// Progressive chunked lazy-load: fetches /api/v1/explorer, immediately renders
// the first viewport batch (100 items), then streams remaining rows into the DOM
// during browser idle frames without locking the main thread.
var _explorerGeneration = 0;
var _explorerRequest = null;
function lazyLoadExplorer() {
  if (_explorerLoaded) return;
  return loadExplorerListings();
}
function loadExplorerListings() {
  if (_explorerRequest) return _explorerRequest;
  _explorerLoaded = true;
  var error = document.getElementById('explorer-load-error');
  if (error) error.hidden = true;
  _explorerRequest = fetch('/api/v1/explorer')
    .then(function(response) { if (!response.ok) throw new Error('Listings unavailable'); return response.json(); })
    .then(function(items) {
      if (!Array.isArray(items)) throw new Error('Invalid listings response');
      _allExplorerItems = items;
      var tbody = document.getElementById('explorer-tbody');
      if (!tbody) return;
      var generation = ++_explorerGeneration;
      tbody.replaceChildren();
      var count = document.getElementById('explorer-count');
      if (count) count.textContent = items.length;
      var badge = document.getElementById('explorer-badge');
      if (badge) badge.textContent = items.length;
      if (!items.length) {
        tbody.innerHTML = '<tr><td colspan="8" class="empty-cell">Your search starts here. Use Run Discover to find your first opportunities.</td></tr>';
        filterExplorerTable(); return;
      }
      var index = 0;
      function appendNextChunk() {
        if (generation !== _explorerGeneration) return;
        renderExplorerRowsChunk(tbody, items.slice(index, index + 100));
        index += 100;
        filterExplorerTable();
        if (index < items.length) {
          if ('requestIdleCallback' in window) requestIdleCallback(appendNextChunk, { timeout: 500 });
          else setTimeout(appendNextChunk, 16);
        }
      }
      appendNextChunk();
    })
    .catch(function() {
      _explorerLoaded = false;
      if (error) {
        error.hidden = false;
        error.textContent = 'Could not load opportunities. Existing results may be out of date. ';
        var retry = document.createElement('button'); retry.type = 'button'; retry.className = 'text-button'; retry.textContent = 'Retry';
        retry.onclick = lazyLoadExplorer; error.appendChild(retry);
      }
      var loading = document.getElementById('explorer-loading-row');
      if (loading) loading.remove();
    })
    .finally(function() { _explorerRequest = null; });
  return _explorerRequest;
}

function renderExplorerRowsChunk(tbody, items) {
  var fragment = document.createDocumentFragment();
  items.forEach(function(item) {
    var tr = document.createElement('tr');
    tr.className = 'explorer-row';
    var titleLower = (item.title || '').toLowerCase();
    var compLower = (item.company || '').toLowerCase();
    var locLower = (item.location || '').toLowerCase();
    tr.setAttribute('data-search', titleLower + ' ' + compLower + ' ' + locLower + ' ' + (item.source || '').toLowerCase());
    tr.setAttribute('data-remote', item.is_remote ? 'true' : 'false');
    tr.setAttribute('data-state', item.state || '');

    var titleStr = item.title || ('Listing ' + item.id);
    var legitEmoji = item.legitimacy === 'suspicious' ? ' 🔴' : (item.legitimacy === 'caution' ? ' 🟡' : ' 🟢');
    var legitTitle = item.legitimacy === 'suspicious' ? 'Suspicious — possible scam or ghost job' : (item.legitimacy === 'caution' ? 'Caution — minor red flags' : 'No red flags');
    var companyStr = item.company ? ('🏢 ' + item.company) : '🏢 Unspecified';
    var legitimacyBadge = '<span class="legit-badge" title="' + legitTitle + '">' + legitEmoji + '</span>';
    var locStr = item.location ? ('📍 ' + item.location) : '📍 Remote / Unspecified';
    var scoreStr = typeof item.score === 'number' ? Math.floor(item.score * 100) + '%' : '—';
    var sevClass = item.state === 'discovered' ? 'sev-info' : 'sev-warn';

    var actionHtml = '<button class="detail-link-btn" onclick="openAppModal(\'' + escapeJsString(item.id) + '\')">Inspect →</button>';
    var st = item.state || '';
    if (st === 'discovered' || st === 'filtered_out') {
      actionHtml += '<button class="btn-primary btn-sm" style="margin-left:4px;" onclick="forceShortlist(\'' + escapeJsString(item.id) + '\')">⚡ Shortlist</button>';
    } else if (st === 'shortlisted') {
      actionHtml += '<button class="btn-primary btn-sm" style="margin-left:4px;" onclick="runCliCommand(\'tailor\', {listing_id: \'' + escapeJsString(item.id) + '\'}, this)">✂️ Tailor</button>';
    } else if (st === 'tailored' && item.application_id) {
      actionHtml += '<button class="btn-primary btn-sm" style="margin-left:4px;" onclick="runCliCommand(\'render\', {application_id: \'' + escapeJsString(item.application_id) + '\'}, this)">📄 Render</button>';
    } else if ((st === 'rendered' || st === 'prepared') && item.application_id) {
      actionHtml += '<button class="btn-primary btn-sm" style="margin-left:4px;" onclick="runCliCommand(\'apply\', {application_id: \'' + escapeJsString(item.application_id) + '\'}, this)">📨 Apply</button>';
    } else if (st === 'drafted') {
      actionHtml += '<button class="btn-primary btn-sm" style="margin-left:4px;" onclick="openAppModal(\'' + escapeJsString(item.id) + '\')">👀 Review Draft</button>';
    } else if (st === 'failed' && item.application_id) {
      actionHtml += '<button class="btn-primary btn-sm" style="margin-left:4px;" onclick="runCliCommand(\'retry\', {application_id: \'' + escapeJsString(item.application_id) + '\'}, this)">🔄 Retry</button>';
    }

    tr.innerHTML = '<td><a href="' + escapeHtml(safePostingUrl(item.url)) + '" target="_blank" rel="noopener noreferrer" class="title-link">' + escapeHtml(titleStr) + '</a></td>' +
      '<td><code class="listing-id-cell" title="Click to copy — use with `careerai tailor <id>`" onclick="copyCliCommand(\'' + escapeJsString(item.id) + '\', this)">' + escapeHtml(item.id) + '</code></td>' +
      '<td>' + escapeHtml(companyStr) + legitimacyBadge + '</td>' +
      '<td>' + escapeHtml(locStr) + '</td>' +
      '<td><span class="pill pill-info">' + escapeHtml(item.source || 'unknown') + '</span></td>' +
      '<td><span class="sev-badge ' + sevClass + '">' + escapeHtml(st) + '</span></td>' +
      '<td>' + scoreStr + '</td>' +
      '<td>' + actionHtml + '</td>';

    fragment.appendChild(tr);
  });

  tbody.appendChild(fragment);
}

function refreshExplorerListings() {
  if (document.getElementById('tab-explorer').classList.contains('active')) {
    return (_explorerRequest || Promise.resolve()).then(loadExplorerListings);
  }
}

// Smart Countdown Timer Script (Auto-pauses when user is typing or AI is thinking)
(function() {
  var sec = parseInt("{{ refresh_seconds }}", 10);
  if (!Number.isFinite(sec)) sec = 60;
  if (sec <= 0) { var disabledTimer = document.getElementById('countdown-text'); if (disabledTimer) disabledTimer.textContent = 'Manual'; return; }
  var count = sec;
  var el = document.getElementById('countdown-text');
  setInterval(function() {
    var chatInput = document.getElementById('chat-input');
    var cfgInput = document.getElementById('config-chat-input');
    var isTyping = (chatInput && (document.activeElement === chatInput || (chatInput.value || '').length > 0)) ||
                   (cfgInput && (document.activeElement === cfgInput || (cfgInput.value || '').length > 0));
    var isThinking = document.querySelector('.msg-loading');
    
    var active = document.activeElement;
    var isEditing = active && (active.matches('input, textarea, select') || active.isContentEditable);
    if (document.hidden || isEditing || isTyping || isThinking || document.querySelector('dialog[open]')) {
      if (el) el.innerText = 'Paused';
      return; // Defer countdown refresh while active
    }

    count--;
    if (el) el.innerText = count + 's';
    if (count <= 0) {
      count = sec;
      refreshExplorerListings();
    }
  }, 1000);
})();
</script>

<!-- ================================================================ MAKEOVER JS
     Top load indicator, scroll progress, scroll-reveal, animated counters,
     3D card tilt, stepper progress fill, footer reveal.
     ========================================================================= -->
<script>
(function() {
  'use strict';

  // ---- Instant Top Loading indicator ----
  var topBar = document.getElementById('top-load-bar');
  var topFill = document.getElementById('top-load-fill');
  if (topFill) {
    topFill.style.width = '70%';
    setTimeout(function() {
      topFill.style.width = '100%';
      setTimeout(function() {
        if (topBar) topBar.classList.add('finished');
      }, 150);
    }, 40);
  }

  // ---- Scroll progress bar ----
  var scrollBar = document.getElementById('scroll-progress');
  function updateScrollProgress() {
    if (!scrollBar) return;
    var scrollTop = window.scrollY || document.documentElement.scrollTop;
    var docHeight = document.documentElement.scrollHeight - window.innerHeight;
    var pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
    scrollBar.style.width = pct + '%';
  }
  window.addEventListener('scroll', updateScrollProgress, { passive: true });

  // ---- Critical View First & Scroll-reveal ----
  var revealSelector = '.mission-hero, .career-story, .operations-divider, .kpi, .guided-path, .pipeline-stepper, .filter-bar, .funnel, .next-steps, .config-card, .command-chapter, .cmd-card, .action-card, .filter-panel-card, .table-container, .chat-wrapper, .sources-list, .bounty-grid, footer';
  
  // Immediately reveal critical above-the-fold elements in the active view
  document.querySelectorAll('.mission-hero, .kpi, .guided-path, .filter-bar, .funnel, #tab-events .table-container, header').forEach(function(el) {
    el.classList.add('revealed');
  });

  document.querySelectorAll(revealSelector).forEach(function(el) {
    if (!el.classList.contains('revealed')) {
      el.classList.add('reveal');
    }
  });

  var revealObserver = null;
  function scanReveal() {
    if (!('IntersectionObserver' in window)) {
      document.querySelectorAll('.reveal').forEach(function(el) { el.classList.add('revealed'); });
      return;
    }
    if (revealObserver) revealObserver.disconnect();
    revealObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.05, rootMargin: '0px 0px -20px 0px' });
    document.querySelectorAll('.reveal:not(.revealed)').forEach(function(el) {
      revealObserver.observe(el);
    });
  }
  scanReveal();

  // ---- Animated KPI counters ----
  // Numbers are already in the DOM (progressive enhancement). Count-up
  // rewrites the text from 0; the final value is restored if anything fails.
  function animateCounter(el) {
    if (el.classList.contains('counted')) return;
    el.classList.add('counted');
    var target = parseInt(el.getAttribute('data-count'), 10);
    if (isNaN(target)) return;
    var suffix = el.getAttribute('data-suffix') || '';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { el.textContent = target + suffix; return; }
    var duration = 900;
    var start = performance.now();
    function tick(now) {
      var elapsed = now - start;
      var t = Math.min(elapsed / duration, 1);
      var eased = 1 - Math.pow(1 - t, 3); // easeOutCubic
      el.textContent = Math.floor(eased * target) + suffix;
      if (t < 1) {
        requestAnimationFrame(tick);
      } else {
        el.textContent = target + suffix;
      }
    }
    requestAnimationFrame(tick);
  }

  var counterObserver = null;
  function scanCounters() {
    var counters = document.querySelectorAll('.kpi-num[data-count]:not(.counted)');
    if (!counters.length) return;
    if (!('IntersectionObserver' in window)) {
      counters.forEach(animateCounter);
      return;
    }
    if (counterObserver) counterObserver.disconnect();
    counterObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          animateCounter(entry.target);
          counterObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });
    counters.forEach(function(el) { counterObserver.observe(el); });
  }

  // ---- 3D card tilt on hover ----
  document.querySelectorAll('.kpi, .config-card:not(.keyword-observatory), .action-card').forEach(function(card) {
    card.classList.add('card-tilt');
    card.addEventListener('mousemove', function(e) {
      var rect = card.getBoundingClientRect();
      var x = e.clientX - rect.left;
      var y = e.clientY - rect.top;
      var cx = rect.width / 2;
      var cy = rect.height / 2;
      var rotX = ((y - cy) / cy) * -4;
      var rotY = ((x - cx) / cx) * 4;
      card.style.transform = 'perspective(800px) rotateX(' + rotX + 'deg) rotateY(' + rotY + 'deg) translateY(-3px)';
      card.style.setProperty('--tilt-x', (x / rect.width * 100) + '%');
      card.style.setProperty('--tilt-y', (y / rect.height * 100) + '%');
    });
    card.addEventListener('mouseleave', function() {
      card.style.transform = '';
    });
  });

  // ---- Stepper progress fill ----
  function updateStepperProgress() {
    var stepper = document.querySelector('.pipeline-stepper');
    if (!stepper) return;
    var steps = stepper.querySelectorAll('.stepper-step');
    var totalSteps = steps.length;
    if (totalSteps === 0) return;
    var activeIndex = 0;
    steps.forEach(function(step, i) {
      var countEl = step.querySelector('.step-count');
      if (countEl) {
        var count = parseInt(countEl.textContent, 10) || 0;
        if (count > 0) activeIndex = i + 1;
      }
    });
    var pct = totalSteps > 1 ? ((activeIndex - 1) / (totalSteps - 1)) * 100 : 0;
    // Add progress track if not present
    var track = stepper.querySelector('.stepper-progress-track');
    if (!track) return; // progress track is decorative; stepper still works without it
    var fill = track.querySelector('.stepper-progress-fill');
    if (fill) fill.style.width = Math.max(0, pct) + '%';
  }

  // ---- Footer reveal ----
  var footer = document.querySelector('footer');
  if (footer) footer.classList.add('reveal');

  // ---- Run after DOMContentLoaded ----
  function init() {
    scanReveal();
    scanCounters();
    updateScrollProgress();
    updateStepperProgress();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  // If IntersectionObserver never fires (headless, off-screen tabs),
  // don't leave content at opacity 0.
  setTimeout(function() {
    document.querySelectorAll('.reveal:not(.revealed)').forEach(function(el) {
      el.classList.add('revealed');
    });
    document.querySelectorAll('.kpi-num[data-count]:not(.counted)').forEach(animateCounter);
  }, 1800);

  // Re-scan after tab switch (new content may need reveal)
  var origSwitchTab = window.switchTab;
  if (origSwitchTab) {
    window.switchTab = function(id) {
      origSwitchTab(id);
      setTimeout(function() {
        scanReveal();
        scanCounters();
        updateScrollProgress();
      }, 100);
    };
  }

  // Re-scan after page refresh (explorer data load)
  var origRefresh = window.refreshExplorerListings;
  if (origRefresh) {
    window.refreshExplorerListings = function() {
      var refreshed = origRefresh();
      setTimeout(scanReveal, 300);
      return refreshed;
    };
  }
})();
</script>

<!-- ======================================================= EXPERIENCE SYSTEM
     Progressive enhancement for the discovery observatory, three-act motion,
     command journey, and the optional pan/zoom spatial career world.
     ======================================================================== -->
<script>
(function() {
  'use strict';

  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---------------------------------------------------- three-act choreography
  function initializeActs() {
    var acts = document.querySelectorAll('.story-act');
    if (!acts.length) return;
    var activate = function(act) { act.classList.add('act-live'); };
    if (reduceMotion || !('IntersectionObserver' in window)) {
      acts.forEach(activate);
    } else {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          entry.target.classList.toggle('act-live', entry.isIntersecting);
        });
      }, { threshold: 0.24 });
      acts.forEach(function(act) { observer.observe(act); });
    }
    var firstMoment = document.querySelector('.career-workbench .career-moment.active');
    if (firstMoment) activateCareerMoment(firstMoment, true);
  }

  // --------------------------------------------------------- command chapters
  function initializeCommandJourney() {
    var journey = document.getElementById('command-journey');
    if (!journey) return;
    document.documentElement.classList.add('motion-ready');
    var chapters = Array.from(journey.querySelectorAll('.command-chapter'));
    var orb = document.getElementById('journey-progress-orb');

    function revealChapter(chapter) {
      chapter.classList.add('chapter-active');
      chapter.querySelectorAll('.cmd-card').forEach(function(card, index) {
        window.setTimeout(function() { card.classList.add('journey-card-visible'); }, reduceMotion ? 0 : index * 85);
      });
      if (orb && chapters.length > 1) {
        var index = Math.max(0, chapters.indexOf(chapter));
        orb.style.top = (20 + (index / (chapters.length - 1)) * 82) + '%';
        orb.style.borderColor = getComputedStyle(chapter).getPropertyValue('--chapter-rgb') ? 'rgb(' + getComputedStyle(chapter).getPropertyValue('--chapter-rgb') + ')' : '';
      }
    }

    if (reduceMotion || !('IntersectionObserver' in window)) {
      chapters.forEach(revealChapter);
      return;
    }
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) revealChapter(entry.target);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    chapters.forEach(function(chapter) { observer.observe(chapter); });
  }

  // ------------------------------------------------------ discovery world map
  function initializeDiscoveryWorld() {
    var stage = document.getElementById('discovery-stage');
    var canvas = document.getElementById('discovery-network-canvas');
    if (!stage || !canvas || canvas.dataset.initialized === 'true') return;
    canvas.dataset.initialized = 'true';
    var context = canvas.getContext('2d');
    if (!context) return;
    var satellites = Array.from(stage.querySelectorAll('.source-satellite'));
    var constellation = document.getElementById('signal-constellation');
    var particles = [];
    var stars = [];
    var width = 0;
    var height = 0;
    var active = false;
    var frameRequest = null;
    var previousTime = 0;

    for (var starIndex = 0; starIndex < 62; starIndex++) {
      stars.push({ x: ((starIndex * 47) % 101) / 101, y: ((starIndex * 83) % 97) / 97, size: 0.35 + (starIndex % 4) * 0.22 });
    }
    for (var particleIndex = 0; particleIndex < Math.max(7, Math.min(12, satellites.length)); particleIndex++) {
      particles.push({ source: particleIndex % Math.max(1, satellites.length), progress: (particleIndex / 11) % 1, speed: 0.000075 + (particleIndex % 4) * 0.000014, bend: (particleIndex % 2 ? 1 : -1) * (24 + (particleIndex % 3) * 13) });
    }

    function visibleNodes(selector) {
      return Array.from(stage.querySelectorAll(selector)).filter(function(node) { return getComputedStyle(node).display !== 'none'; });
    }

    function layoutWorld() {
      var rect = stage.getBoundingClientRect();
      if (rect.width < 40 || rect.height < 40) return;
      width = rect.width;
      height = rect.height;
      var ratio = Math.min(window.devicePixelRatio || 1, 1.6);
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      context.setTransform(ratio, 0, 0, ratio, 0, 0);

      satellites.forEach(function(node, index) {
        var angle = -Math.PI / 2 + (index / Math.max(1, satellites.length)) * Math.PI * 2;
        var x = 50 + Math.cos(angle) * (width < 560 ? 39 : 43);
        var y = 50 + Math.sin(angle) * (width < 560 ? 38 : 41);
        node.style.left = x + '%';
        node.style.top = y + '%';
        node.style.setProperty('--source-angle', angle + 'rad');
        node.querySelector('i').style.animationDelay = (-index * 0.19) + 's';
      });

      var keywordNodes = visibleNodes('.keyword-orbit-node');
      keywordNodes.forEach(function(node, index) {
        var half = Math.ceil(keywordNodes.length / 2);
        var leftSide = index < half;
        var localIndex = index % half;
        var fraction = half > 1 ? localIndex / (half - 1) : 0.5;
        var curve = Math.sin(fraction * Math.PI) * (width < 560 ? 6 : 9);
        var x = leftSide ? 17 + curve : 83 - curve;
        var y = 12 + fraction * 76 + Math.sin(localIndex * 1.7) * 1.25;
        node.style.left = x + '%';
        node.style.top = y + '%';
      });
    }
    window.layoutDiscoveryWorld = layoutWorld;

    function pointFor(node) {
      return { x: node.offsetLeft, y: node.offsetTop };
    }
    function quadraticPoint(start, control, end, t) {
      var inverse = 1 - t;
      return {
        x: inverse * inverse * start.x + 2 * inverse * t * control.x + t * t * end.x,
        y: inverse * inverse * start.y + 2 * inverse * t * control.y + t * t * end.y
      };
    }
    function createImpact() {
      var layer = document.getElementById('match-impact-layer');
      if (!layer || !width) return;
      var impact = document.createElement('span');
      impact.className = 'match-impact';
      impact.textContent = '+JOB';
      impact.style.left = (width / 2 + (Math.random() - 0.5) * 130) + 'px';
      impact.style.top = (height / 2 + (Math.random() - 0.5) * 130) + 'px';
      layer.appendChild(impact);
      window.setTimeout(function() { impact.remove(); }, 1700);
    }
    window.createDiscoveryImpact = createImpact;

    function draw(time) {
      if (!active || !width || !height) { frameRequest = null; return; }
      var elapsed = Math.min(40, previousTime ? time - previousTime : 16);
      previousTime = time;
      context.clearRect(0, 0, width, height);

      stars.forEach(function(star, index) {
        context.beginPath();
        context.fillStyle = index % 7 === 0 ? 'rgba(103,232,249,.35)' : 'rgba(148,163,184,.18)';
        context.arc(star.x * width, star.y * height, star.size, 0, Math.PI * 2);
        context.fill();
      });

      var keywordNodes = visibleNodes('.keyword-orbit-node');
      context.lineWidth = 0.65;
      context.strokeStyle = 'rgba(129,140,248,.10)';
      [keywordNodes.slice(0, Math.ceil(keywordNodes.length / 2)), keywordNodes.slice(Math.ceil(keywordNodes.length / 2))].forEach(function(group) {
        if (group.length < 2) return;
        context.beginPath();
        group.forEach(function(node, index) {
          var point = pointFor(node);
          if (index === 0) context.moveTo(point.x, point.y); else context.lineTo(point.x, point.y);
        });
        context.stroke();
      });

      var destination = { x: width / 2, y: height / 2 };
      satellites.forEach(function(node) {
        var start = pointFor(node);
        context.beginPath();
        context.strokeStyle = 'rgba(34,211,238,.055)';
        context.moveTo(start.x, start.y);
        context.lineTo(destination.x, destination.y);
        context.stroke();
      });

      var speedMultiplier = stage.classList.contains('discovery-scanning') ? 2.5 : 1;
      particles.forEach(function(particle) {
        if (!satellites.length) return;
        particle.progress += elapsed * particle.speed * speedMultiplier;
        if (particle.progress >= 1) {
          particle.progress = 0;
          particle.source = Math.floor(Math.random() * satellites.length);
          particle.bend *= -1;
          if (Math.random() > 0.45 || stage.classList.contains('discovery-scanning')) createImpact();
        }
        var start = pointFor(satellites[particle.source % satellites.length]);
        var control = { x: (start.x + destination.x) / 2 + particle.bend, y: (start.y + destination.y) / 2 - particle.bend * 0.45 };
        var point = quadraticPoint(start, control, destination, particle.progress);
        var tail = quadraticPoint(start, control, destination, Math.max(0, particle.progress - 0.06));
        var gradient = context.createLinearGradient(tail.x, tail.y, point.x, point.y);
        gradient.addColorStop(0, 'rgba(34,211,238,0)');
        gradient.addColorStop(1, 'rgba(103,232,249,.95)');
        context.beginPath();
        context.strokeStyle = gradient;
        context.lineWidth = 1.4;
        context.moveTo(tail.x, tail.y);
        context.lineTo(point.x, point.y);
        context.stroke();
        context.beginPath();
        context.fillStyle = '#cffafe';
        context.arc(point.x, point.y, 1.7, 0, Math.PI * 2);
        context.fill();
      });
      frameRequest = window.requestAnimationFrame(draw);
    }

    function setActive(isActive) {
      active = isActive;
      if (active) {
        layoutWorld();
        if (!frameRequest && !reduceMotion) frameRequest = window.requestAnimationFrame(draw);
        if (reduceMotion) { previousTime = 0; draw(16); active = false; }
      }
    }
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function(entries) { entries.forEach(function(entry) { setActive(entry.isIntersecting); }); }, { threshold: 0.08 }).observe(stage);
    } else {
      setActive(true);
    }
    if ('ResizeObserver' in window) new ResizeObserver(layoutWorld).observe(stage);
    window.addEventListener('resize', layoutWorld, { passive: true });
    window.setTimeout(layoutWorld, 120);
  }

  window.runDiscoveryExperience = function(command, button) {
    var stage = document.getElementById('discovery-stage');
    var label = document.getElementById('discovery-mode-label');
    if (stage) stage.classList.add('discovery-scanning');
    if (label) label.textContent = command === 'match' ? 'ranking signals' : (command === 'run' ? 'autopilot engaged' : 'scanning sources');
    for (var i = 0; i < 7; i++) window.setTimeout(function() { if (window.createDiscoveryImpact) window.createDiscoveryImpact(); }, 380 + i * 390);
    window.setTimeout(function() {
      if (stage) stage.classList.remove('discovery-scanning');
      if (label) label.textContent = 'listening';
    }, 4300);
    runCliCommand(command, {}, button);
  };

  function initializeExperienceSystem() {
    var run = function() {
      initializeActs();
      initializeCommandJourney();
      initializeDiscoveryWorld();
    };
    if ('requestIdleCallback' in window) {
      requestIdleCallback(run, { timeout: 1500 });
    } else {
      setTimeout(run, 100);
    }
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeExperienceSystem);
  else initializeExperienceSystem();
})();

