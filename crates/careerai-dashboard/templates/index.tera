  { name: 'AI Hackathons (lablab)', url: 'https://lablab.ai/event/types/hackathon', category: 'hackathon', reward: 'Cash + credits', desc: 'Ongoing AI/ML hackathons with Mistral, OpenAI, and Anthropic APIs.', api: false },

