        <div><small>Platforms tracked</small><strong id="bounty-platform-count">—</strong></div>
        <div><small>Total opportunities</small><strong id="bounty-total-count">—</strong></div>
        <span class="panel-live"><i></i> Curated directory</span>
      </div>
    </div>

    <div class="filter-bar">
      <div class="search-box">
        <span class="search-icon">🔍</span>
        <input type="text" id="bounty-search" placeholder="Search by platform, skill, or reward..." oninput="filterBountyCards(this.value)">
      </div>
      <div class="filter-pills">
        <span class="filter-pill active" onclick="filterBountyCategory('all', this)">All</span>
        <span class="filter-pill" onclick="filterBountyCategory('bug-bounty', this)">🐛 Bug Bounty</span>
        <span class="filter-pill" onclick="filterBountyCategory('hackathon', this)">🏆 Hackathon</span>
        <span class="filter-pill" onclick="filterBountyCategory('coding', this)">💻 Coding</span>
        <span class="filter-pill" onclick="filterBountyCategory('opensource', this)">📦 Open Source</span>
        <span class="filter-pill" onclick="filterBountyCategory('ai-ml', this)">🧠 AI/ML</span>
        <span class="filter-pill" onclick="filterBountyCategory('web3', this)">⛓️ Web3</span>
      </div>
    </div>

    <div class="bounty-grid" id="bounty-grid">
      <div class="bounty-loader">Loading bounty opportunities...</div>
    </div>
  </div>

  <!-- TAB 8: AI CHAT ASSISTANT -->
  <div id="tab-chat" class="tab-panel">
    <div class="panel-header mission-panel-head head-chat">
      <div class="panel-head-main">
        <span class="panel-kicker"><i></i> Contextual copilot</span>
        <h2>Ask the system that knows your whole search.</h2>
        <p class="panel-desc">Explore pipeline decisions, tune discovery strategy, and prepare for interviews with your live candidate context attached.</p>
      </div>
      <div class="panel-head-stats">
        <div><small>Model state</small><strong>{{ view.llm_health }}</strong></div>
        <div><small>Backend</small><strong>{{ view.config.llm_provider }}</strong></div>
        <span class="panel-live"><i></i> Profile context connected</span>
      </div>
    </div>

    <div class="chat-wrapper">
      <!-- Quick Prompt Suggestion Chips -->
      <div class="prompt-chips-bar">
        <span class="chips-label">💡 Suggested Prompts:</span>
        <button class="chip-btn" onclick="usePromptChip('Suggest priority keywords for Remote Embedded AI & Robotics')">🎯 Target Keywords</button>
        <button class="chip-btn" onclick="usePromptChip('Analyze my current job match pipeline statistics')">📊 Match Stats</button>
        <button class="chip-btn" onclick="usePromptChip('Give me technical interview preparation advice for Rust Embedded positions')">📝 Interview Prep</button>
        <button class="chip-btn" onclick="usePromptChip('How do I switch LLM backend to DeepSeek or Claude Web?')">⚙️ LLM Setup</button>
        <button class="chip-btn" onclick="clearChatHistory()" style="margin-left:auto;">🗑️ Clear Chat</button>
      </div>

      <!-- Chat Messages Scroll Container -->
      <div id="chat-messages" class="chat-messages-container">
        <div class="chat-msg msg-assistant">
          <div class="msg-avatar">🤖</div>
          <div class="msg-content">
            <div class="msg-header">
              <span class="msg-author">Career-AI Assistant</span>
              <span class="msg-time">Just now</span>
            </div>
            <div class="msg-text">Hello! I'm your <strong>Career-AI Interactive Assistant</strong>. I can analyze your candidate profile, suggest domain keywords for <code>config/local.yaml</code>, review match scores, or help prep for technical interviews.<br><br>How can I help you optimize your job pipeline today?</div>
          </div>
        </div>
      </div>

      <!-- Chat Input Bar -->
      <form id="chat-form" onsubmit="sendChatMessage(event)" class="chat-input-container">
        <input type="text" id="chat-input" class="form-control chat-input-field" placeholder="Ask Career-AI anything about your jobs, config, or interview prep..." autocomplete="off">
        <button type="submit" id="chat-send-btn" class="btn-primary chat-send-btn">
          <span>📤 Send</span>
        </button>
      </form>
    </div>
  </div>

  <!-- FLOATING BATCH ACTION BAR (FAB) -->
  <div id="batch-action-bar" class="batch-action-bar" style="display:none;">
    <div class="batch-bar-content">
      <span id="batch-bar-count" class="batch-bar-count">0 items selected</span>
      <div class="batch-bar-actions">
        <button type="button" id="batch-tailor-btn" class="btn-primary" onclick="batchTailorSelected(this)">🎯 Tailor Selected</button>
        <button type="button" id="batch-render-btn" class="btn-primary" onclick="batchRenderSelected(this)">📄 Render Selected</button>
        <button type="button" id="batch-apply-btn" class="btn-primary" onclick="batchApplySelected(this)" style="background:var(--accent-emerald);">🚀 Apply Selected</button>
        <button type="button" class="btn-secondary" onclick="deselectAllBatch()" style="padding:6px 12px; font-size:12px;">✕ Clear</button>
      </div>
    </div>
  </div>
</main>

<!-- APPLICATION DETAIL POPOVER MODAL -->
<div id="app-modal" class="modal-backdrop" onclick="if(event.target===this) closeAppModal()">
  <div class="modal-card">
    <div class="modal-header">
      <div>
        <h2 id="modal-title">Loading Application Details...</h2>
        <div class="modal-subtitle">
          <span id="modal-company"></span> · <span id="modal-location"></span> · Source: <span id="modal-source"></span>
        </div>
      </div>
      <div class="modal-header-right">
        <span id="modal-score" class="score-badge score-high"></span>
        <button class="close-btn" onclick="closeAppModal()">✕</button>
      </div>
    </div>
    <div class="modal-body">
      <div class="modal-info-bar">
        <span>State: <strong id="modal-state"></strong></span>
        <span>ID: <code id="modal-id"></code></span>
        <span>Model: <code id="modal-model"></code></span>
        <span>Prompt: <code id="modal-prompt"></code></span>
      </div>

      <div class="modal-section">
        <h3>📄 Tailored Cover Letter / Summary</h3>
        <pre id="modal-cover-letter" class="code-preview">No tailored letter available.</pre>
      </div>

      <div class="modal-section">
        <h3>📋 Job Description Overview</h3>
        <div id="modal-description" class="desc-box">Loading description...</div>
      </div>

      <div class="modal-section">
        <h3>📁 Rendered Artifacts</h3>
        <ul id="modal-artifacts" class="artifacts-list">
          <li class="empty-item">No disk artifacts registered.</li>
        </ul>
      </div>

      <div class="modal-section">
        <h3>🧭 Pipeline Timeline</h3>
        <ul id="modal-timeline" class="artifacts-list">
          <li class="empty-item">No audit events recorded.</li>
        </ul>
      </div>
    </div>
    <div class="modal-footer" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
      <div id="modal-actions-container" style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;"></div>
      <div style="display:flex; gap:8px; align-items:center;">
        <a id="modal-external-link" href="#" target="_blank" rel="noopener" class="action-btn">Open Original Posting ↗</a>
        <button class="close-btn-secondary" onclick="closeAppModal()">Close</button>
      </div>
    </div>
  </div>
</div>

<dialog id="command-palette" class="command-dialog" aria-label="Jump to a workspace page">
  <div class="command-dialog-head"><input id="command-search" type="search" aria-label="Search workspace pages" placeholder="Where would you like to go?" autocomplete="off"><button id="command-close" aria-label="Close command palette">Esc</button></div>
  <div id="command-results" class="command-results"></div>
  <div class="command-dialog-foot"><span>↑ ↓ to navigate · Enter to open</span><span id="command-count" role="status"></span></div>
</dialog>
<footer>
  <span>career-ai · Built for your next chapter · {{ build_version }}</span>
</footer>

<script>
// --- Real-time Notification & Progress Toast Engine ---
var _activeNotifications = [];
var _notificationHistory = [];

function toggleNotificationDrawer() {
  var drawer = document.getElementById('notification-drawer');
  var btn = document.getElementById('notification-bell-btn');
  if (!drawer) return;
  var isHidden = drawer.style.display === 'none' || !drawer.style.display;
  drawer.style.display = isHidden ? 'flex' : 'none';
  if (btn) btn.classList.toggle('active', isHidden);
}

document.addEventListener('click', function(e) {
  var wrapper = document.getElementById('notification-wrapper');
  var drawer = document.getElementById('notification-drawer');
  if (wrapper && drawer && !wrapper.contains(e.target) && drawer.style.display !== 'none') {
    drawer.style.display = 'none';
    var btn = document.getElementById('notification-bell-btn');
    if (btn) btn.classList.remove('active');
  }
});

function updateNotificationBadge() {
  var badge = document.getElementById('notification-badge');
  var btn = document.getElementById('notification-bell-btn');
  if (!badge) return;
  var runningCount = _activeNotifications.length;
  if (runningCount > 0) {
    badge.textContent = runningCount;
    badge.style.display = 'flex';
    badge.classList.add('badge-running');
    if (btn) btn.classList.add('has-running');
  } else if (_notificationHistory.length > 0) {
    badge.textContent = _notificationHistory.length;
    badge.style.display = 'flex';
    badge.classList.remove('badge-running');
    if (btn) btn.classList.remove('has-running');
  } else {
    badge.style.display = 'none';
    if (btn) btn.classList.remove('has-running');
  }
  renderNotificationDrawerList();
}

function renderNotificationDrawerList() {
  var list = document.getElementById('notification-drawer-list');
  if (!list) return;
  var allItems = _activeNotifications.concat(_notificationHistory);
  if (allItems.length === 0) {
    list.innerHTML = '<div class="notification-empty">No recent command activity</div>';
    return;
  }
  var html = '';
  allItems.slice(0, 25).forEach(function(item) {
    var icon = item.icon || (item.status === 'running' ? '⏳' : item.status === 'success' ? '✅' : '❌');
    var badgeClass = item.status === 'running' ? 'badge-running' : item.status === 'success' ? 'badge-success' : 'badge-error';
    html += '<div class="notification-item">' +
      '<div class="notification-item-icon">' + icon + '</div>' +
      '<div class="notification-item-body">' +
        '<div class="notification-item-title">' +
          '<span>' + escapeHtml(item.title) + '</span>' +
          '<span class="task-toast-badge ' + badgeClass + '">' + item.status + '</span>' +
        '</div>' +
        '<div class="notification-item-desc">' + escapeHtml(item.message) + '</div>' +
        '<div class="notification-item-time">' + (item.time || 'Just now') + '</div>' +
      '</div>' +
    '</div>';
  });
  list.innerHTML = html;
}

function clearNotifications() {
  _notificationHistory = [];
  updateNotificationBadge();
}

function createNotificationToast(title, initialMessage, icon) {
  var id = 'toast-' + Date.now() + '-' + Math.floor(Math.random() * 1000);
  var container = document.getElementById('toast-container');
  if (!container) {
    container = document.createElement('div');
    container.id = 'toast-container';
    container.className = 'toast-container';
    document.body.appendChild(container);
  }

  var iconEmoji = icon || '⚡';
  var toast = document.createElement('div');
  toast.id = id;
  toast.className = 'task-toast';
  toast.innerHTML = 
    '<div class="task-toast-header">' +
      '<div class="task-toast-title-group">' +
        '<span class="task-toast-icon">' + iconEmoji + '</span>' +
        '<span class="task-toast-title">' + escapeHtml(title) + '</span>' +
      '</div>' +
      '<div style="display:flex;align-items:center;gap:6px;">' +
        '<span class="task-toast-badge badge-running" id="' + id + '-badge">Running</span>' +
        '<button class="task-toast-close" onclick="dismissToast(\'' + id + '\')" title="Dismiss">×</button>' +
      '</div>' +
    '</div>' +
    '<div class="task-toast-body" id="' + id + '-body">' + escapeHtml(initialMessage) + '</div>' +
    '<div class="task-toast-progress-track">' +
      '<div class="task-toast-progress-fill running" id="' + id + '-fill"></div>' +
    '</div>';
  
  container.appendChild(toast);

  var taskObj = {
    id: id,
    title: title,
    message: initialMessage,
    status: 'running',
    icon: iconEmoji,
    time: new Date().toLocaleTimeString()
  };
  _activeNotifications.unshift(taskObj);
  updateNotificationBadge();

  return {
    id: id,
    update: function(msg) {
      taskObj.message = msg;
      var body = document.getElementById(id + '-body');
      if (body) body.textContent = msg;
      renderNotificationDrawerList();
    },
    success: function(msg, autoCloseDelay) {
      taskObj.status = 'success';
      taskObj.message = msg || 'Completed successfully';
      taskObj.time = new Date().toLocaleTimeString();
      _activeNotifications = _activeNotifications.filter(function(t) { return t.id !== id; });
      _notificationHistory.unshift(taskObj);
      updateNotificationBadge();

      var badge = document.getElementById(id + '-badge');
      var body = document.getElementById(id + '-body');
      var fill = document.getElementById(id + '-fill');
      if (badge) { badge.className = 'task-toast-badge badge-success'; badge.textContent = 'Success'; }
      if (body) { body.textContent = msg || 'Completed successfully'; }
      if (fill) { fill.className = 'task-toast-progress-fill success'; }

      setTimeout(function() {
        dismissToast(id);
      }, autoCloseDelay !== undefined ? autoCloseDelay : 2500);
    },
    error: function(errMsg, autoCloseDelay) {
      taskObj.status = 'error';
      taskObj.message = errMsg || 'Execution failed';
      taskObj.time = new Date().toLocaleTimeString();
      _activeNotifications = _activeNotifications.filter(function(t) { return t.id !== id; });
      _notificationHistory.unshift(taskObj);
      updateNotificationBadge();

      var badge = document.getElementById(id + '-badge');
      var body = document.getElementById(id + '-body');
      var fill = document.getElementById(id + '-fill');
      if (badge) { badge.className = 'task-toast-badge badge-error'; badge.textContent = 'Failed'; }
      if (body) { body.textContent = errMsg || 'Execution failed'; }
      if (fill) { fill.className = 'task-toast-progress-fill error'; }

      setTimeout(function() {
        dismissToast(id);
      }, autoCloseDelay !== undefined ? autoCloseDelay : 4500);
    }
  };
}

function dismissToast(id) {
  var toast = document.getElementById(id);
  if (!toast) return;
  toast.classList.add('toast-closing');
  setTimeout(function() {
    if (toast && toast.parentNode) toast.parentNode.removeChild(toast);
  }, 260);
  _activeNotifications = _activeNotifications.filter(function(t) { return t.id !== id; });
  updateNotificationBadge();
}

function escapeHtml(str) {
  if (!str) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function getCommandMeta(command, args) {
  switch (command) {
    case 'discover':
      return { title: 'Discovering Jobs', icon: '🔍', desc: 'Ingesting listings across all active source adapters...' };
    case 'tailor':
      if (args && args.all) return { title: 'Tailoring All Shortlisted', icon: '✨', desc: 'Running LLM tailoring for all shortlisted jobs...' };
      if (args && args.limit) return { title: 'Tailoring Top ' + args.limit + ' Jobs', icon: '✨', desc: 'Running LLM tailoring...' };
      return { title: 'Tailoring Resume', icon: '✨', desc: 'Tailoring resume & generating cover letter...' };
    case 'render':
      if (args && args.all) return { title: 'Rendering All Artifacts', icon: '📄', desc: 'Compiling DOCX & PDF files for tailored jobs...' };
      return { title: 'Rendering Artifacts', icon: '📄', desc: 'Rendering DOCX and PDF resume files...' };
    case 'apply':
      if (args && args.all) return { title: 'Submitting Applications', icon: '🚀', desc: 'Executing batch application submissions...' };
      return { title: 'Submitting Application', icon: '🚀', desc: 'Submitting application to job board...' };
    case 'match':
      return { title: 'Matching Listings', icon: '🎯', desc: 'Scoring listings against profile vector...' };
    case 'run':
      return { title: 'Autopilot Pipeline', icon: '⚡', desc: 'Executing full pipeline: match → tailor → render → apply...' };
    case 'retry':
      return { title: 'Retrying Application', icon: '🔄', desc: 'Resetting failed application state and retrying...' };
    case 'inspect':
      return { title: 'Inspecting Application', icon: '🔎', desc: 'Loading audit trails and artifacts...' };
    case 'review':
      return { title: 'Reviewing Drafts', icon: '📝', desc: 'Loading drafted applications for approval...' };
    case 'interview':
      return { title: 'Interview Prep', icon: '🎤', desc: 'Generating STAR stories & role-specific questions...' };
    case 'email':
      return { title: 'Cold Email Draft', icon: '✉️', desc: 'Drafting personalized outreach email...' };
    case 'negotiate':
      return { title: 'Negotiation Script', icon: '💼', desc: 'Building salary negotiation talking points...' };
    case 'upskill':
      return { title: 'Skill Gap Analysis', icon: '📈', desc: 'Analyzing skill gaps & generating learning plan...' };
    case 'rollback':
      return { title: 'Rolling Back', icon: '↩️', desc: 'Reverting application to previous pipeline stage...' };
    case 'rematch':
      return { title: 'Rematching', icon: '🎯', desc: 'Re-scoring shortlisted listings against profile...' };
    case 'patterns':
      return { title: 'Pattern Detection', icon: '📊', desc: 'Detecting repost/ghost-job patterns...' };
    default:
      return { title: 'Running ' + command, icon: '⚙️', desc: 'Executing command...' };
  }
}

function switchTab(tabId) {
  if (!document.getElementById('tab-' + tabId)) return;
  document.querySelectorAll('.nav-btn').forEach(b => { b.classList.remove('active'); b.setAttribute('aria-current', 'false'); });
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  
  var btn = document.getElementById('tab-btn-' + tabId);
  var panel = document.getElementById('tab-' + tabId);
  if (btn) {
    btn.classList.add('active');
    btn.setAttribute('aria-current', 'page');
    var breadcrumb = document.getElementById('workspace-current-page');
    if (breadcrumb) breadcrumb.textContent = Array.from(btn.childNodes).filter(n => n.nodeType === 3).map(n => n.textContent).join('').trim();
    try { btn.scrollIntoView({ behavior: 'auto', block: 'nearest', inline: 'nearest' }); } catch(e) {}
  }
  if (panel) {
    panel.classList.add('active');
    panel.querySelectorAll('.reveal').forEach(function(el) { el.classList.add('revealed'); });
  }
  try { localStorage.setItem('careerai-active-tab', tabId); } catch(e) {}
  try {
    var url = new URL(window.location.href);
    url.searchParams.set('tab', tabId);
    window.history.replaceState({}, '', url);
  } catch(e) {}

  if (tabId === 'explorer' && typeof lazyLoadExplorer === 'function') {
    lazyLoadExplorer();
  }
  if (tabId === 'analytics' && typeof lazyLoadAnalytics === 'function') {
    lazyLoadAnalytics();
  }
  if (tabId === 'review' && typeof loadReviewQueue === 'function') {
    loadReviewQueue();
  }
}

function activateCareerMoment(button, skipScroll) {
  var timeline = button && button.closest('.career-timeline');
  if (!timeline) return;
  timeline.querySelectorAll('.career-moment').forEach(function(moment) {
    moment.classList.toggle('active', moment === button);
  });
  var workbench = button.closest('.career-workbench');
  if (workbench) {
    var title = workbench.querySelector('#resume-preview-title');
    var org = workbench.querySelector('#resume-preview-org');
    var proof = workbench.querySelector('#resume-preview-proof');
    var skill = workbench.querySelector('#resume-preview-skill');
    if (title) title.textContent = button.dataset.title || 'Career milestone';
    if (org) org.textContent = [button.dataset.era, button.dataset.organization].filter(Boolean).join(' · ');
    if (proof) proof.textContent = button.dataset.proof || 'Evidence connected to your living résumé.';
    if (skill) skill.textContent = (button.dataset.title || 'Experience').split(/\s+/).slice(0, 2).join(' ').toUpperCase();
    var preview = workbench.querySelector('.resume-live-preview');
    if (preview) {
      preview.classList.remove('resume-updated');
      void preview.offsetWidth;
      preview.classList.add('resume-updated');
    }
  }
  if (!skipScroll) button.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function filterFunnelCards(query) {
  var q = (query || '').toLowerCase().trim();
  document.querySelectorAll('.card').forEach(function(card) {
    var title = card.getAttribute('data-title') || '';
    var company = card.getAttribute('data-company') || '';
    if (!q || title.indexOf(q) !== -1 || company.indexOf(q) !== -1) {
      card.style.display = 'block';
    } else {
      card.style.display = 'none';
    }
  });
}

function filterFunnelStage(stage, pillEl) {
  if (pillEl) {
    pillEl.parentElement.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
    pillEl.classList.add('active');
  }
  document.querySelectorAll('.col').forEach(function(col) {
    var colStage = col.getAttribute('data-stage');
    if (stage === 'all' || colStage === stage) {
      col.style.display = 'flex';
    } else {
      col.style.display = 'none';
    }
  });
}

function copyPayloadText(btn) {
  var details = btn.closest('details');
  if (!details) return;
  var code = details.querySelector('pre code');
  if (!code) return;
  var text = code.innerText || code.textContent;
  navigator.clipboard.writeText(text).then(function() {
    var oldText = btn.innerText;
    btn.innerText = '✓ Copied';
    setTimeout(function() { btn.innerText = oldText; }, 2000);
  }).catch(function() {
    btn.innerText = 'Failed';
  });
}

function refreshEventsTable() {
  var tbody = document.getElementById('events-tbody');
  var statsCount = document.getElementById('events-stat-count');
  if (!tbody) return;
  tbody.style.opacity = '0.5';
  fetch('/api/v1/events')
    .then(function(res) { return res.json(); })
    .then(function(events) {
      tbody.style.opacity = '1';
      if (!Array.isArray(events) || events.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="empty-cell"><div class="empty-events-state"><span class="empty-icon">📋</span><p>No recent system events recorded.</p></div></td></tr>';
        if (statsCount) statsCount.innerText = '0';
        return;
      }
      if (statsCount) statsCount.innerText = String(events.length);
      var html = '';
      events.forEach(function(ev) {
        var sev = ev.severity || 'info';
        var lid = ev.listing_id || '';
        var summaryText = ev.summary || ev.note || 'State transition executed';
        var searchStr = (lid + ' ' + summaryText + ' ' + (ev.raw_payload || '')).toLowerCase();
        html += '<tr class="event-row" data-severity="' + escapeHtml(sev) + '" data-search="' + escapeHtml(searchStr) + '">';
        html += '<td class="time-cell" title="' + escapeHtml(ev.timestamp || '') + '"><span class="rel-time">' + escapeHtml(ev.relative_time || '?') + '</span></td>';
        html += '<td><span class="sev-badge sev-' + escapeHtml(sev) + '">' + escapeHtml(sev) + '</span></td>';
        if (lid && lid !== '' && lid !== '00000000-0000-0000-0000-000000000000') {
          html += '<td><span class="listing-id-pill" onclick="openAppModal(\'' + escapeJsString(lid) + '\')" title="View Listing Details">' + escapeHtml(lid) + '</span></td>';
        } else {
          html += '<td><span class="muted-dash">—</span></td>';
        }
        html += '<td><span class="transition-pill transition-' + escapeHtml(sev) + '">' + escapeHtml(ev.from_state || 'start') + ' <span class="arrow-glyph">→</span> <strong>' + escapeHtml(ev.to_state || '') + '</strong></span></td>';
        html += '<td class="note-cell"><div class="event-note-wrapper">';
        html += '<div class="event-summary-line sev-text-' + escapeHtml(sev) + '">';
        if (sev === 'error') {
          html += '<span class="event-icon sev-error-icon">✕</span>';
        } else if (sev === 'warn') {
          html += '<span class="event-icon sev-warn-icon">!</span>';
        } else {
          html += '<span class="event-icon sev-info-icon">●</span>';
        }
        html += '<span class="event-summary-text">' + escapeHtml(summaryText) + '</span></div>';
        if (ev.raw_payload) {
          html += '<details class="event-payload-details"><summary class="event-payload-summary"><span class="payload-toggle-icon">▸</span><span class="payload-toggle-text">Execution Log Details</span><button type="button" class="btn-copy-payload" onclick="event.stopPropagation(); copyPayloadText(this)" title="Copy log to clipboard">📋 Copy</button></summary><pre class="event-raw-log"><code>' + escapeHtml(ev.raw_payload) + '</code></pre></details>';
        }
        html += '</div></td></tr>';
      });
      tbody.innerHTML = html;
      filterEvents();
    })
    .catch(function(err) {
      tbody.style.opacity = '1';
      console.error('Failed to refresh events:', err);
    });
}

function filterEvents() {
  var q = (document.getElementById('event-search').value || '').toLowerCase().trim();
  document.querySelectorAll('.event-row').forEach(function(row) {
    var searchStr = row.getAttribute('data-search') || '';
    if (!q || searchStr.indexOf(q) !== -1) {
      row.style.display = '';
    } else {
      row.style.display = 'none';
    }
  });
}

function filterEventsSeverity(sev, pillEl) {
  if (pillEl) {
    pillEl.parentElement.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
    pillEl.classList.add('active');
  }
  document.querySelectorAll('.event-row').forEach(function(row) {
    var rowSev = row.getAttribute('data-severity');
    if (sev === 'all' || rowSev === sev) {
      row.style.display = '';
    } else {
      row.style.display = 'none';
    }
  });
}

function openAppModal(id) {
  var modal = document.getElementById('app-modal');
  modal.classList.add('active');
  document.getElementById('modal-title').innerText = 'Loading...';
  
  fetch('/api/v1/applications/' + encodeURIComponent(id))
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.error) {
        document.getElementById('modal-title').innerText = 'Error Loading Application';
        document.getElementById('modal-description').innerText = data.error;
        return;
      }
      document.getElementById('modal-title').innerText = data.title || 'Untitled Listing';
      document.getElementById('modal-company').innerText = data.company || '—';
      document.getElementById('modal-location').innerText = data.location || 'Remote';
      document.getElementById('modal-source').innerText = data.source || '—';
      document.getElementById('modal-state').innerText = data.state || 'discovered';
      document.getElementById('modal-id').innerText = data.id || id;
      document.getElementById('modal-model').innerText = data.llm_model || '—';
      document.getElementById('modal-prompt').innerText = data.prompt_version || '—';
      document.getElementById('modal-score').innerText = data.score ? Math.floor(data.score * 100) + '%' : '—';
      document.getElementById('modal-cover-letter').innerText = data.cover_letter_text || 'No tailored cover letter generated yet.';
      document.getElementById('modal-description').innerText = data.description || 'No description body recorded.';
      document.getElementById('modal-external-link').href = safePostingUrl(data.url);

      var artifactsUl = document.getElementById('modal-artifacts');
      artifactsUl.innerHTML = '';
      if (data.artifacts && data.artifacts.length > 0) {
        data.artifacts.forEach(function(art) {
          var li = document.createElement('li');
          li.className = 'artifact-item';
          var isPdf = art.path.endsWith('.pdf');
          var isDocx = art.path.endsWith('.docx');
          var isMd = art.path.endsWith('.md');
          var icon = isPdf ? '📕 PDF' : (isDocx ? '📘 DOCX' : (isMd ? '📝 Markdown' : '📄 File'));
          var downloadUrl = '/api/v1/artifacts/download?path=' + encodeURIComponent(art.path);
          var sizeKb = (art.bytes / 1024).toFixed(1) + ' KB';

          li.innerHTML = '<div style="display:flex; justify-content:space-between; align-items:center; width:100%; gap:8px;">' +
            '<span>' + icon + ' <strong>' + escapeHtml(art.kind) + '</strong> (' + sizeKb + ')</span>' +
            '<a href="' + downloadUrl + '" target="_blank" class="btn-primary" style="padding:3px 10px; font-size:11px; text-decoration:none; display:inline-flex; align-items:center; gap:4px;">⬇️ Download</a>' +
            '</div>';
          artifactsUl.appendChild(li);
        });
      } else {
        artifactsUl.innerHTML = '<li class="empty-item">No disk artifacts registered. Click "📄 Render" to generate DOCX/PDF resume.</li>';
      }

      var timelineUl = document.getElementById('modal-timeline');
      timelineUl.innerHTML = '';
      if (data.timeline && data.timeline.length > 0) {
        data.timeline.forEach(function(ev) {
          var li = document.createElement('li');
          var sev = ev.severity || 'info';
          li.className = 'artifact-item timeline-event-card sev-border-' + sev;
          var summaryText = ev.summary || ev.note || 'State transition executed';
          var timeStr = ev.relative_time || '?';
          var transitionStr = (ev.from_state || 'start') + ' → <strong>' + ev.to_state + '</strong>';
          var html = '<div style="display:flex; flex-direction:column; gap:4px; width:100%;">' +
            '<div style="display:flex; justify-content:space-between; align-items:center; font-size:11px;">' +
            '<span class="transition-pill transition-' + escapeHtml(sev) + '">' + transitionStr + '</span>' +
            '<span class="rel-time">' + escapeHtml(timeStr) + '</span>' +
            '</div>' +
            '<div class="timeline-summary-text sev-text-' + escapeHtml(sev) + '">' + escapeHtml(summaryText) + '</div>';
          if (ev.raw_payload) {
            html += '<details class="event-payload-details" style="margin-top:4px;"><summary class="event-payload-summary"><span class="payload-toggle-icon">▸</span><span class="payload-toggle-text">View Log</span></summary><pre class="event-raw-log" style="max-height:160px;"><code>' + escapeHtml(ev.raw_payload) + '</code></pre></details>';
          }
          html += '</div>';
          li.innerHTML = html;
          timelineUl.appendChild(li);
        });
      } else {
        timelineUl.innerHTML = '<li class="empty-item">No audit events recorded.</li>';
      }

      var actionsDiv = document.getElementById('modal-actions-container');
      if (actionsDiv) {
        actionsDiv.innerHTML = '';
        var state = (data.state || '').toLowerCase();
        var targetId = data.listing_id || id;

        if (state === 'shortlisted') {
          actionsDiv.innerHTML = '<button type="button" class="btn-primary" onclick="tailorListing(\'' + escapeJsString(targetId) + '\', this)">🎯 Tailor Application</button>';
        } else if (state === 'tailored') {
          actionsDiv.innerHTML = '<button type="button" class="btn-primary" onclick="renderApplication(\'' + escapeJsString(targetId) + '\', this)">📄 Render PDF & DOCX</button>' +
            '<button type="button" class="btn-secondary" onclick="rollbackApplication(\'' + escapeJsString(targetId) + '\', \'shortlisted\', this)">↩️ Rollback to Shortlisted</button>';
        } else if (state === 'rendered') {
          actionsDiv.innerHTML = '<button type="button" class="btn-primary" onclick="applyApplication(\'' + escapeJsString(targetId) + '\', this)">🚀 Apply</button>' +
            '<button type="button" class="btn-secondary" onclick="renderApplication(\'' + escapeJsString(targetId) + '\', this)">🔄 Re-render</button>' +
            '<button type="button" class="btn-secondary" onclick="rollbackApplication(\'' + escapeJsString(targetId) + '\', \'tailored\', this)">↩️ Rollback to Tailored</button>';
        }
      }
    })
    .catch(function(err) {
      document.getElementById('modal-title').innerText = 'Failed to fetch details';
      document.getElementById('modal-description').innerText = String(err);
    });
}

function closeAppModal() {
  document.getElementById('app-modal').classList.remove('active');
}
// F02: Fetch and toggle match reasons for a listing inline in the explorer.
function toggleMatchReasons(listingId, btn) {
  var existing = document.getElementById('match-reasons-' + listingId);
  if (existing) {
    existing.remove();
    btn.textContent = 'Why?';
    return;
  }
  btn.textContent = 'Loading…';
  fetch('/api/v1/match-reasons/' + encodeURIComponent(listingId))
    .then(function(res) { return res.json(); })
    .then(function(data) {
      btn.textContent = 'Why?';
      var row = btn.closest('tr');
      var detailRow = document.createElement('tr');
      detailRow.id = 'match-reasons-' + listingId;
      detailRow.className = 'match-reasons-row';
      var cell = document.createElement('td');
      cell.colSpan = 8;
      cell.style.background = 'var(--surface-2, #f8f9fa)';
      cell.style.padding = '12px 16px';
      cell.style.fontSize = '12px';

      var html = '<div style="display:flex; gap:24px; flex-wrap:wrap;">';
      if (data.matched_keywords) {
        html += '<div><strong style="color:#16a34a;">Matched:</strong> ' +
          data.matched_keywords.map(escapeHtml).join(', ') + '</div>';
      }
      if (data.missing_keywords && data.missing_keywords.length > 0) {
        html += '<div><strong style="color:#dc2626;">Missing:</strong> ' +
          data.missing_keywords.map(escapeHtml).join(', ') + '</div>';
      }
      if (data.filter_reason) {
        html += '<div><strong>Filter:</strong> ' + escapeHtml(data.filter_reason) + '</div>';
      }
      if (data.legitimacy_tier) {
        html += '<div><strong>Legitimacy:</strong> ' + escapeHtml(data.legitimacy_tier) + '</div>';
      }
      html += '</div>';
      cell.innerHTML = html;
      detailRow.appendChild(cell);
      row.parentNode.insertBefore(detailRow, row.nextSibling);
    })
    .catch(function(err) {
      btn.textContent = 'Why?';
      console.error('match reasons fetch failed:', err);
    });
}
// F03: Load and render the review queue.
function loadReviewQueue() {
  fetch('/api/v1/review-queue')
    .then(function(res) { return res.json(); })
    .then(function(entries) {
      var tbody = document.getElementById('review-queue-tbody');
      var badge = document.getElementById('review-badge');
      if (!entries || entries.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="empty-cell" style="text-align:center; padding:24px;">No applications awaiting review. Tailor + render listings to populate this queue.</td></tr>';
        if (badge) { badge.hidden = true; }
        return;
      }
      if (badge) { badge.hidden = false; badge.textContent = entries.length; }
      tbody.innerHTML = entries.map(function(e) {
        var contentFlags = [];
        if (e.has_resume) contentFlags.push('Resume');
        if (e.has_cover_letter) contentFlags.push('Cover');
        if (e.artifact_count > 0) contentFlags.push(e.artifact_count + ' file' + (e.artifact_count > 1 ? 's' : ''));
        var contentStr = contentFlags.length > 0 ? contentFlags.join(' · ') : '—';
        var scoreStr = e.score ? Math.floor(e.score * 100) + '%' : '—';
        return '<tr>' +
          '<td><a href="#" onclick="openReviewDetail(\'' + escapeHtml(e.application_id) + '\'); return false;" class="title-link">' + escapeHtml(e.title) + '</a></td>' +
          '<td>' + escapeHtml(e.company) + '</td>' +
          '<td><span class="sev-badge sev-warn">' + escapeHtml(e.state) + '</span></td>' +
          '<td>' + scoreStr + '</td>' +
          '<td style="font-size:11px;">' + contentStr + '</td>' +
          '<td>' +
            '<button class="btn-primary btn-sm" onclick="reviewAction(\'' + escapeHtml(e.application_id) + '\', \'approve\', ' + JSON.stringify(JSON.stringify({application_id: e.application_id, profile_hash: e.profile_hash, prompt_version: e.prompt_version, updated_at_rfc3339: e.updated_at})).replace(/'/g, "&#39;") + ')">Approve</button> ' +
            '<button class="btn-primary btn-sm" onclick="openReviewDetail(\'' + escapeHtml(e.application_id) + '\')">Inspect</button> ' +
            '<button class="detail-link-btn" onclick="reviewAction(\'' + escapeHtml(e.application_id) + '\', \'skip\', ' + JSON.stringify(JSON.stringify({application_id: e.application_id, profile_hash: e.profile_hash, prompt_version: e.prompt_version, updated_at_rfc3339: e.updated_at})).replace(/'/g, "&#39;") + ')">Skip</button>' +
          '</td>' +
        '</tr>';
      }).join('');
    })
    .catch(function(err) {
      console.error('review queue fetch failed:', err);
      var tbody = document.getElementById('review-queue-tbody');
      if (tbody) {
        tbody.innerHTML = '<tr><td colspan="6" class="empty-cell" style="text-align:center; padding:24px; color:#dc2626;">Failed to load review queue.</td></tr>';
      }
    });
}

// F03: Open the review detail panel showing JD + resume + cover letter + artifacts.
function openReviewDetail(appId) {
  var panel = document.getElementById('review-detail-panel');
  panel.hidden = false;
  panel.innerHTML = '<div style="padding:24px; text-align:center;"><span class="explorer-spinner"></span> Loading application detail…</div>';
  fetch('/api/v1/review-queue/' + encodeURIComponent(appId))
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.error) {
        panel.innerHTML = '<div style="padding:16px; color:#dc2626;">Error: ' + escapeHtml(data.error) + '</div>';
        return;
      }
      var html = '<div style="background:var(--surface-2, #f8f9fa); border:1px solid var(--border, #e2e8f0); border-radius:8px; padding:16px; margin-top:16px;">';
      html += '<div style="display:flex; justify-content:space-between; align-items:start; margin-bottom:12px;">';
      html += '<div><h3 style="margin:0;">' + escapeHtml(data.title) + ' — ' + escapeHtml(data.company) + '</h3>';
      html += '<div style="font-size:12px; color:var(--text-muted, #64748b);">State: ' + escapeHtml(data.state) + ' · Model: ' + escapeHtml(data.llm_model) + ' · Profile: ' + escapeHtml(data.profile_hash).substring(0, 20) + '…</div></div>';
      html += '<button class="detail-link-btn" onclick="document.getElementById(\'review-detail-panel\').hidden = true;">Close</button>';
      html += '</div>';

      html += '<details style="margin-bottom:12px;"><summary style="cursor:pointer; font-weight:600;">Job Description</summary>';
      html += '<div style="white-space:pre-wrap; font-size:12px; max-height:300px; overflow-y:auto; padding:8px; background:var(--surface, #fff); border-radius:4px;">' + escapeHtml(data.description || '—') + '</div></details>';

      html += '<details open style="margin-bottom:12px;"><summary style="cursor:pointer; font-weight:600;">Cover Letter</summary>';
      html += '<div style="white-space:pre-wrap; font-size:12px; max-height:300px; overflow-y:auto; padding:8px; background:var(--surface, #fff); border-radius:4px;">' + escapeHtml(data.cover_letter_text || 'No cover letter generated.') + '</div></details>';

      html += '<details style="margin-bottom:12px;"><summary style="cursor:pointer; font-weight:600;">Resume View (JSON)</summary>';
      html += '<pre style="font-size:10px; max-height:300px; overflow:auto; padding:8px; background:var(--surface, #fff); border-radius:4px;">' + escapeHtml(data.resume_view_json || '—') + '</pre></details>';

      if (data.artifacts && data.artifacts.length > 0) {
        html += '<details style="margin-bottom:12px;"><summary style="cursor:pointer; font-weight:600;">Artifacts (' + data.artifacts.length + ')</summary><ul>';
        data.artifacts.forEach(function(art) {
          var downloadUrl = '/api/v1/artifacts/download?path=' + encodeURIComponent(art.path);
          html += '<li style="font-size:12px;">' + escapeHtml(art.kind) + ' — <a href="' + downloadUrl + '" target="_blank">Download</a> (' + (art.bytes / 1024).toFixed(1) + ' KB)</li>';
        });
        html += '</ul></details>';
      }

      var cv = JSON.stringify({application_id: data.id, profile_hash: data.profile_hash, prompt_version: data.prompt_version, updated_at_rfc3339: data.updated_at});
      var cvEsc = cv.replace(/'/g, '&#39;');
      html += '<div style="display:flex; gap:8px; margin-top:12px; padding-top:12px; border-top:1px solid var(--border, #e2e8f0);">';
      html += '<button class="btn-primary" onclick="reviewAction(\'' + escapeHtml(data.id) + '\', \'approve\', \'' + cvEsc + '\')">Approve for Submission</button>';
      html += '<button class="btn-primary" onclick="reviewAction(\'' + escapeHtml(data.id) + '\', \'skip\', \'' + cvEsc + '\')">Skip</button>';
      if (data.state === 'failed') {
        html += '<button class="btn-primary" onclick="reviewAction(\'' + escapeHtml(data.id) + '\', \'retry\', \'' + cvEsc + '\')">Retry</button>';
      }
      html += '</div>';
      html += '</div>';
      panel.innerHTML = html;
    })
    .catch(function(err) {
      panel.innerHTML = '<div style="padding:16px; color:#dc2626;">Failed to load detail: ' + escapeHtml(String(err)) + '</div>';
    });
}

// F03: Execute a review action (approve/skip/retry) with content-version safety.
function reviewAction(appId, action, contentVersionJson) {
  var cv = JSON.parse(contentVersionJson);
  var body = JSON.stringify({content_version: cv, note: null});
  fetch('/api/v1/review-queue/' + encodeURIComponent(appId) + '/' + action, {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: body
  })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      var outcome = data.outcome || 'unknown';
      var msg = action + ': ' + outcome;
      if (outcome === 'stale_content') {
        msg = 'Stale content — this application was edited since you opened it. Refresh and review again.';
      } else if (outcome === 'already_approved' || outcome === 'already_skipped') {
        msg = 'Already ' + action + 'd — no duplicate action taken.';
      } else if (outcome === 'not_failed') {
        msg = 'Cannot retry — application is not in failed state.';
      } else if (outcome === 'not_found') {
        msg = 'Application not found.';
      }
      alert(msg);
      loadReviewQueue();
      var panel = document.getElementById('review-detail-panel');
      if (panel && outcome !== 'stale_content') { panel.hidden = true; }
    })
    .catch(function(err) {
      console.error('review action failed:', err);
      alert('Action failed: ' + err);
    });
}
// F01: Load onboarding state and render a first-session banner.
function loadOnboarding() {
  fetch('/api/v1/onboarding')
    .then(function(res) { return res.json(); })
    .then(function(data) {
      var banner = document.getElementById('onboarding-banner');
      if (!banner) return;
      if (data.phase === 'complete') {
        banner.hidden = true;
        return;
      }
      banner.hidden = false;
      var phaseLabels = {
        import_profile: 'Import your profile',
        confirm_preferences: 'Confirm your preferences',
        preview_matches: 'Preview your matches',
        review_match: 'Review your first tailored match'
      };
      var html = '<div style="background:linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); color:#fff; border-radius:12px; padding:20px 24px; margin-bottom:16px;">';
      html += '<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">';
      html += '<strong style="font-size:14px;">First-session setup · Step ' + (data.step_number || 1) + ' of 4</strong>';
      html += '<span style="font-size:12px; opacity:0.8;">' + escapeHtml(phaseLabels[data.phase] || data.phase) + '</span>';
      html += '</div>';
      html += '<p style="margin:0 0 12px; font-size:13px; line-height:1.5;">' + escapeHtml(data.guidance || '') + '</p>';
      if (data.preview_matches && data.preview_matches.length > 0) {
        html += '<div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px;">';
        data.preview_matches.slice(0, 3).forEach(function(m) {
          html += '<div style="background:rgba(255,255,255,0.15); border-radius:6px; padding:6px 10px; font-size:11px;">' + escapeHtml(m.title) + ' · ' + escapeHtml(m.company) + (m.score ? ' (' + Math.floor(m.score * 100) + '%)' : '') + '</div>';
        });
        html += '</div>';
      }
      html += '<button class="btn-primary" style="background:#fff; color:#6366f1; border:none;" onclick="switchTab(\'' + escapeHtml(data.next_action_tab || 'config') + '\')">' + escapeHtml(data.next_action_label || 'Continue') + ' →</button>';
      html += '</div>';
      banner.innerHTML = html;
    })
    .catch(function(err) {
      console.error('onboarding fetch failed:', err);
    });
}

// Status element for the "Generate Config from Profile" card (right of
// the LLM backend form). Falls back to the form's status element if the
// card is missing, so older cached pages still get feedback.
function configGenStatus() {
  return document.getElementById('config-gen-status-msg') || document.getElementById('save-status-msg');
}

// ── Matching Score Threshold ──────────────────────────────────────────────
function syncThresholdInput(val) {
  const inp = document.getElementById('threshold-input');
  if (inp) inp.value = parseFloat(val).toFixed(3);
}
function syncThresholdSlider(val) {
  const sl = document.getElementById('threshold-slider');
  if (sl) sl.value = val;
}

function saveThreshold() {
  const inp = document.getElementById('threshold-input');
  const msg = document.getElementById('threshold-msg');
  const pill = document.getElementById('threshold-status-pill');
  const val = parseFloat(inp ? inp.value : '0.003');
  if (isNaN(val) || val < 0.0001 || val > 0.50) {
    if (msg) msg.textContent = 'Value must be between 0.001 and 0.50.';
    return;
  }
  if (msg) msg.textContent = 'Saving…';
  var notif = createNotificationToast('Saving Threshold', 'Updating match threshold to ' + val.toFixed(3) + '...', '🎯');
  fetch('/api/config/threshold', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ score_threshold: val })
  })
  .then(r => r.json())
  .then(d => {
    if (msg) msg.textContent = d.message || 'Threshold updated.';
    if (pill) pill.textContent = val.toFixed(3);
    notif.success('Match threshold updated to ' + val.toFixed(3));
  })
  .catch(e => {
    if (msg) msg.textContent = 'Error: ' + e;
    notif.error('Failed to update threshold: ' + e);
  });
}

function rematchShortlisted() {
  const msg = document.getElementById('threshold-msg');
  if (msg) msg.textContent = 'Running rematch on shortlisted jobs…';
  var notif = createNotificationToast('Rematching Listings', 'Re-scoring shortlisted jobs against threshold...', '🎯');
  fetch('/api/match/rematch-shortlisted', { method: 'POST' })
  .then(r => r.json())
  .then(d => {
    if (msg) msg.textContent = d.message || 'Rematch complete.';
    notif.success('Rematch complete! Refreshing...');
    setTimeout(() => location.reload(), 1500);
  })
  .catch(e => {
    if (msg) msg.textContent = 'Error: ' + e;
    notif.error('Rematch error: ' + e);
  });
}

function calculateCostEstimate() {
  const model = document.getElementById('estimator-model').value;
  const count = parseInt(document.getElementById('estimator-jobs-count').value, 10) || 1;
  const usdEl = document.getElementById('estimator-cost-usd');
  const inrEl = document.getElementById('estimator-cost-inr');
  const timeEl = document.getElementById('estimator-time');

  let costPerJobUsd = 0.0;
  let timePerJobSec = 0.12;

  switch(model) {
    case 'local':
      costPerJobUsd = 0.0;
      timePerJobSec = 0.001;
      break;
    case 'gemini-flash':
      costPerJobUsd = 0.0004;
      timePerJobSec = 0.15;
      break;
    case 'deepseek-v3':
      costPerJobUsd = 0.0005;
      timePerJobSec = 0.25;
      break;
    case 'gpt-4o-mini':
      costPerJobUsd = 0.0006;
      timePerJobSec = 0.20;
      break;
    case 'claude-haiku':
      costPerJobUsd = 0.0015;
      timePerJobSec = 0.35;
      break;
    case 'claude-sonnet':
      costPerJobUsd = 0.0085;
      timePerJobSec = 0.60;
      break;
  }

  const totalUsd = costPerJobUsd * count;
  const totalInr = totalUsd * 87.0; // USD to INR conversion
  const totalSeconds = Math.max(1, Math.round(timePerJobSec * count));

  if (usdEl) usdEl.innerText = '$' + totalUsd.toFixed(totalUsd < 0.01 && totalUsd > 0 ? 4 : 2) + ' USD';
  if (inrEl) inrEl.innerText = '≈ ₹' + totalInr.toFixed(2) + ' INR';
  if (timeEl) {
    if (totalSeconds < 60) {
      timeEl.innerText = '~' + totalSeconds + ' seconds';
    } else {
      timeEl.innerText = '~' + (totalSeconds / 60).toFixed(1) + ' minutes';
    }
  }
}

function generateConfig() {
  var msgEl = configGenStatus();
  if (msgEl) msgEl.innerText = 'Generating config preview...';
  var notif = createNotificationToast('Generating Config', 'Deriving discovery keywords from profile...', '⚙️');
  fetch('/api/v1/config/generate', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (d.status === 'preview') {
        if (msgEl) msgEl.innerText = 'Preview ready — review the diff, then apply.';
        document.getElementById('config-before').innerText = d.before || '(no existing config/local.yaml)';
        document.getElementById('config-after').innerText = d.after || '';
        document.getElementById('config-diff-panel').style.display = 'block';
        notif.success('Config preview generated! Review diff below.');
      } else {
        var err = d.error || 'Generation failed';
        if (msgEl) msgEl.innerText = '❌ ' + err;
        notif.error(err);
      }
    })
    .catch(function(err) {
      if (msgEl) msgEl.innerText = '❌ ' + err;
      notif.error(String(err));
    });
}

function applyGeneratedConfig() {
  var msgEl = configGenStatus();
  if (msgEl) msgEl.innerText = 'Applying merged config...';
  var notif = createNotificationToast('Applying Config', 'Writing config/local.yaml...', '⚙️');
  fetch('/api/v1/config/apply', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (d.status === 'success') {
        if (msgEl) msgEl.innerText = '✅ ' + (d.message || 'Config applied.');
        document.getElementById('config-diff-panel').style.display = 'none';
        notif.success('Config applied successfully! Reloading...');
        setTimeout(function() { location.reload(); }, 1200);
      } else {
        var err = d.error || 'Apply failed';
        if (msgEl) msgEl.innerText = '❌ ' + err;
        notif.error(err);
      }
    })
    .catch(function(err) {
      if (msgEl) msgEl.innerText = '❌ ' + err;
      notif.error(String(err));
    });
}

function dismissConfigPreview() {
  document.getElementById('config-diff-panel').style.display = 'none';
  var msgEl = configGenStatus();
  if (msgEl) msgEl.innerText = '';
}

function saveLlmSettings(e) {
  e.preventDefault();
  var strategy = document.getElementById('cfg-strategy') ? document.getElementById('cfg-strategy').value : 'local';
  var backend = document.getElementById('cfg-backend').value;
  var model = document.getElementById('cfg-model').value;
  var apiBase = document.getElementById('cfg-api-base').value;
  var apiKey = document.getElementById('cfg-api-key').value;
  var timeoutSec = parseInt(document.getElementById('cfg-timeout').value, 10) || 300;
  var msgEl = document.getElementById('save-status-msg');
  msgEl.innerText = 'Saving...';

  // Persist non-secret fields to localStorage so they survive reloads.
  try {
    localStorage.setItem('careerai-cfg-strategy', strategy);
    localStorage.setItem('careerai-cfg-backend', backend);
    localStorage.setItem('careerai-cfg-model', model);
    localStorage.setItem('careerai-cfg-api-base', apiBase);
    localStorage.setItem('careerai-cfg-timeout', String(timeoutSec));
    localStorage.removeItem('careerai-cfg-api-key');
  } catch(lsErr) {}

  fetch('/api/v1/config', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      strategy: strategy,
      backend: backend,
      model: model || null,
      api_base_url: apiBase || null,
      api_key: apiKey || null,
      timeout_seconds: timeoutSec
    })
  })
  .then(function(res) { return res.json(); })
  .then(function(data) {
    msgEl.innerText = '✅ Settings Saved!';
    setTimeout(function() { msgEl.innerText = ''; }, 2500);
  })
  .catch(function(err) {
    msgEl.innerText = '❌ Failed: ' + err;
  });
}

function importProfile(e) {
  e.preventDefault();
  var statusEl = document.getElementById('import-status');
  statusEl.innerText = 'Uploading...';
  var formData = new FormData();
  var resumeFile = document.getElementById('profile-resume-file').files[0];
  var linkedinFile = document.getElementById('profile-linkedin-file').files[0];
  if (!resumeFile && !linkedinFile) {
    statusEl.innerText = '❌ Please select at least one file.'; return;
  }
  if (resumeFile) formData.append('resume', resumeFile, resumeFile.name);
  if (linkedinFile) formData.append('linkedin', linkedinFile, linkedinFile.name);
  fetch('/api/v1/profile/import', { method: 'POST', body: formData })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    if (d.status === 'success') {
      var p = d.profile;
      if (p) {
        if (p.personal) {
          document.getElementById('pf-name').value = p.personal.name || '';
          document.getElementById('pf-email').value = p.personal.email || '';
          document.getElementById('pf-phone').value = p.personal.phone || '';
          document.getElementById('pf-location').value = p.personal.location || '';
        }
        if (p.target_roles) document.getElementById('pf-roles').value = p.target_roles.join(', ');
        if (p.skills) {
          document.getElementById('pf-languages').value = (p.skills.languages || []).join(', ');
          document.getElementById('pf-frameworks').value = (p.skills.frameworks || []).join(', ');
          document.getElementById('pf-tools').value = (p.skills.tools || []).join(', ');
        }
      }
      if (d.pending === true) {
        statusEl.innerText = '✅ Imported draft ready — review fields then Apply.';
        document.getElementById('import-apply-actions').style.display = 'block';
      } else {
        statusEl.innerText = '✅ Profile imported (draft not saved).';
      }
    } else {
      statusEl.innerText = '❌ ' + (d.error || 'Import failed');
    }
  })
  .catch(function(err) { statusEl.innerText = '❌ ' + err; });
}

function applyImportedProfile() {
  var statusEl = document.getElementById('import-status');
  statusEl.innerText = 'Applying imported profile...';
  fetch('/api/v1/profile/import/confirm', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (d.status === 'success') {
        statusEl.innerText = '✅ ' + (d.message || 'Profile applied.');
        document.getElementById('import-apply-actions').style.display = 'none';
        setTimeout(function() { location.reload(); }, 1200);
      } else {
        statusEl.innerText = '❌ ' + (d.error || 'Apply failed');
      }
    })
    .catch(function(err) { statusEl.innerText = '❌ ' + err; });
}

function filterExplorerTable() {
  var searchVal = (document.getElementById('explorer-search-input').value || '').toLowerCase();

  // Location/mode facets
  var wantRemote = document.getElementById('flt-remote').checked;
  var wantIndia = document.getElementById('flt-india').checked;
  var wantAbroad = document.getElementById('flt-abroad').checked;
  var anyLocation = !wantRemote && !wantIndia && !wantAbroad;

  // Domain facets
  var wantEmbedded = document.getElementById('flt-embedded').checked;
  var wantAi = document.getElementById('flt-ai').checked;
  var wantSoftware = document.getElementById('flt-software').checked;
  var wantStem = document.getElementById('flt-stem').checked;
  var anyDomain = !wantEmbedded && !wantAi && !wantSoftware && !wantStem;

  // Status facets
  var wantDiscovered = document.getElementById('flt-state-discovered').checked;
  var wantFiltered = document.getElementById('flt-state-filtered').checked;

  var rows = document.querySelectorAll('.explorer-row');
  rows.forEach(function(row) {
    var text = (row.getAttribute('data-search') || '').toLowerCase();
    var isRemote = row.getAttribute('data-remote') === 'true';
    var state = row.getAttribute('data-state') || '';

    // Text search
    if (searchVal && text.indexOf(searchVal) === -1) {
      row.style.display = 'none'; return;
    }

    // Status
    var stateOk = false;
    if (wantDiscovered && state !== 'filtered_out') stateOk = true;
    if (wantFiltered && state === 'filtered_out') stateOk = true;
    if (!wantDiscovered && !wantFiltered) stateOk = true;
    if (!stateOk) { row.style.display = 'none'; return; }

    // Location/mode
    if (!anyLocation) {
      var locOk = false;
      if (wantRemote && isRemote) locOk = true;
      if (wantIndia && text.indexOf('india') !== -1) locOk = true;
      if (wantAbroad && !isRemote && text.indexOf('india') === -1) locOk = true;
      if (!locOk) { row.style.display = 'none'; return; }
    }

    // Domain
    if (!anyDomain) {
      var domOk = false;
      if (wantEmbedded && /embedded|firmware|rtos|yocto|linux|kernel|fpga|driver/.test(text)) domOk = true;
      if (wantAi && /\bai\b|machine.learning|deep.learning|robotics|nlp|computer.vision|pytorch|tensorflow/.test(text)) domOk = true;
      if (wantSoftware && /fullstack|frontend|backend|web|react|node|django|spring|devops/.test(text)) domOk = true;
      if (wantStem && /research|science|physics|telecom|signal|rf|matlab|simulation/.test(text)) domOk = true;
      if (!domOk) { row.style.display = 'none'; return; }
    }

    row.style.display = '';
  });
  var visible = Array.from(rows).filter(function(row) { return row.style.display !== 'none'; }).length;
  var status = document.getElementById('explorer-result-status');
  if (status) status.textContent = visible + ' matching · ' + rows.length + ' loaded' + (_allExplorerItems.length > rows.length ? ' · loading more…' : '');
  var empty = document.getElementById('explorer-no-results');
  if (empty) empty.hidden = visible > 0 || rows.length === 0 || _allExplorerItems.length > rows.length;
}

function resetExplorerFilters() {
  ['flt-remote','flt-india','flt-abroad','flt-embedded','flt-ai','flt-software','flt-stem'].forEach(function(id) {
    var el = document.getElementById(id);
    if (el) el.checked = false;
  });
  ['flt-state-discovered','flt-state-filtered'].forEach(function(id) {
    var el = document.getElementById(id);
    if (el) el.checked = true;
  });
  document.getElementById('explorer-search-input').value = '';
  filterExplorerTable();
}

function toggleYamlEditor() {
  var structEl = document.getElementById('profile-structured-editor');
  var yamlEl = document.getElementById('profile-yaml-editor');
  if (!structEl || !yamlEl) return;
  if (yamlEl.style.display === 'none') {
    yamlEl.style.display = 'block';
    structEl.style.display = 'none';
  } else {
    yamlEl.style.display = 'none';
    structEl.style.display = 'block';
  }
}

function saveProfile() {
  var statusEl = document.getElementById('profile-save-status');
  statusEl.innerText = 'Saving...';
  var splitCsv = function(s) {
    return (s || '').split(',').map(function(x) { return x.trim(); }).filter(Boolean);
  };
  var yamlEl = document.getElementById('profile-yaml-editor');
  var isYamlActive = yamlEl && yamlEl.style.display !== 'none';
  
  var payload = {
    name: (document.getElementById('pf-name') ? document.getElementById('pf-name').value : '').trim(),
    email: (document.getElementById('pf-email') ? document.getElementById('pf-email').value : '').trim(),
    phone: (document.getElementById('pf-phone') ? document.getElementById('pf-phone').value : '').trim(),
    location: (document.getElementById('pf-location') ? document.getElementById('pf-location').value : '').trim(),
    github: (document.getElementById('pf-github') ? document.getElementById('pf-github').value : '').trim(),
    linkedin: (document.getElementById('pf-linkedin') ? document.getElementById('pf-linkedin').value : '').trim(),
    portfolio: (document.getElementById('pf-portfolio') ? document.getElementById('pf-portfolio').value : '').trim(),
    summary: (document.getElementById('pf-summary') ? document.getElementById('pf-summary').value : '').trim(),
    target_roles: splitCsv(document.getElementById('pf-roles') ? document.getElementById('pf-roles').value : ''),
    languages: splitCsv(document.getElementById('pf-languages') ? document.getElementById('pf-languages').value : ''),
    platforms: splitCsv(document.getElementById('pf-platforms') ? document.getElementById('pf-platforms').value : ''),
    frameworks: splitCsv(document.getElementById('pf-frameworks') ? document.getElementById('pf-frameworks').value : ''),
    devops: splitCsv(document.getElementById('pf-devops') ? document.getElementById('pf-devops').value : ''),
    tools: splitCsv(document.getElementById('pf-tools') ? document.getElementById('pf-tools').value : ''),
    debugging: splitCsv(document.getElementById('pf-debugging') ? document.getElementById('pf-debugging').value : ''),
    protocols: splitCsv(document.getElementById('pf-protocols') ? document.getElementById('pf-protocols').value : ''),
    raw_yaml: isYamlActive ? (document.getElementById('pf-raw-yaml') ? document.getElementById('pf-raw-yaml').value : null) : null
  };

  fetch('/api/v1/profile/save', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    if (d.status === 'success') {
      statusEl.innerText = '✅ Profile Saved to profile/profile.yaml!';
      setTimeout(function() { statusEl.innerText = ''; }, 3000);
    } else {
      statusEl.innerText = '❌ ' + (d.error || 'Unknown error');
    }
  })
  .catch(function(err) { statusEl.innerText = '❌ ' + err; });
}

function updateBatchToolbar() {
  var shortlistedCbs = Array.from(document.querySelectorAll('.batch-cb-shortlisted:checked'));
  var tailoredCbs = Array.from(document.querySelectorAll('.batch-cb-tailored:checked'));
  var renderedCbs = Array.from(document.querySelectorAll('.batch-cb-rendered:checked'));
  var totalSelected = shortlistedCbs.length + tailoredCbs.length + renderedCbs.length;

  var bar = document.getElementById('batch-action-bar');
  if (!bar) return;

  if (totalSelected > 0) {
    bar.style.display = 'block';
    document.getElementById('batch-bar-count').innerText = totalSelected + ' item(s) selected';
    var tailorBtn = document.getElementById('batch-tailor-btn');
    var renderBtn = document.getElementById('batch-render-btn');
    var applyBtn = document.getElementById('batch-apply-btn');
    if (tailorBtn) tailorBtn.style.display = shortlistedCbs.length > 0 ? 'inline-block' : 'none';
    if (renderBtn) renderBtn.style.display = tailoredCbs.length > 0 ? 'inline-block' : 'none';
    if (applyBtn) applyBtn.style.display = renderedCbs.length > 0 ? 'inline-block' : 'none';
  } else {
    bar.style.display = 'none';
  }

  // Highlight selected cards
  document.querySelectorAll('.card').forEach(function(c) {
    var cb = c.querySelector('.card-select-cb');
    if (cb && cb.checked) {
      c.classList.add('card-selected');
    } else {
      c.classList.remove('card-selected');
    }
  });
}

function deselectAllBatch() {
  document.querySelectorAll('.card-select-cb').forEach(function(cb) { cb.checked = false; });
  document.querySelectorAll('.col-head input[type="checkbox"]').forEach(function(cb) { cb.checked = false; });
  updateBatchToolbar();
}

function toggleSelectAllColumn(stage, masterCb) {
  var cbs = document.querySelectorAll('.batch-cb-' + stage);
  cbs.forEach(function(cb) { cb.checked = masterCb.checked; });
  updateBatchToolbar();
}

