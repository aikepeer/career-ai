<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#0a0f1a">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="CareerAI">
<link rel="manifest" href="/sw-manifest">
<title>career-ai · Dashboard</title>
<style>{{ css | safe }}</style>
<link rel="stylesheet" href="/static/workspace.css">
<script src="/static/workspace.js" defer></script>
<script>
(function() {
  var theme = 'light';
  try { theme = localStorage.getItem('careerai-theme') || 'light'; } catch(e) {}
  document.documentElement.setAttribute('data-theme', theme === 'dark' ? 'dark' : 'light');
  window._toggleTheme = function() {
    var cur = document.documentElement.getAttribute('data-theme');
    if (!cur) {
      cur = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    }
    var next = cur === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try { localStorage.setItem('careerai-theme', next); } catch(e) {}
  };
})();
</script>
</head>
<body>
<a class="skip-link" href="#main-content">Skip to workspace</a>

<!-- Instant Top Loading Indicator -->
<div class="top-load-bar" id="top-load-bar"><div class="top-load-fill" id="top-load-fill"></div></div>

<!-- Scroll progress bar -->
<div class="scroll-progress" id="scroll-progress"></div>

<!-- Floating background orbs -->
<div class="bg-orb bg-orb-1"></div>
<div class="bg-orb bg-orb-2"></div>
<div class="bg-orb bg-orb-3"></div>

<header>
  <div class="brand-container">
    <div class="brand-glow"></div>
    <span class="brand">career-ai</span>
    <span class="brand-sub">CAREER WORKSPACE</span>
  </div>

  <nav class="tab-nav" aria-label="Workspace navigation">
    <button class="nav-btn active" id="tab-btn-funnel" onclick="switchTab('funnel')">
      <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg></span> Mission Control
    </button>
    <button class="nav-btn" id="tab-btn-events" onclick="switchTab('events')">
      <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg></span> Audit Events
      {% if view.recent_events | length > 0 %}
      <span class="tab-badge">{{ view.recent_events | length }}</span>
      {% endif %}
    </button>
    <button class="nav-btn" id="tab-btn-config" onclick="switchTab('config')">
      <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 17h16"/><circle cx="9" cy="7" r="3"/><circle cx="15" cy="17" r="3"/></svg></span> Config & Sources
    </button>
    <button class="nav-btn" id="tab-btn-actions" onclick="switchTab('actions')">
      <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="6" width="16" height="15" rx="2"/><path d="M9 6V3h6v3M8 13l3 3 5-6"/></svg></span> Action Center
      {% if view.action_items | length > 0 %}
      <span class="tab-badge badge-accent">{{ view.action_items | length }}</span>
      {% endif %}
    </button>
    <button class="nav-btn" id="tab-btn-review" onclick="switchTab('review')">
      <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></span> Review Queue
      <span class="tab-badge" id="review-badge" hidden>0</span>
    </button>
    <button class="nav-btn" id="tab-btn-explorer" onclick="switchTab('explorer')">
      <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="6"/><path d="m15 15 5 5"/></svg></span> Discovered Explorer
      {% if view.explorer_total > 0 %}
      <span class="tab-badge" id="explorer-badge">{{ view.explorer_total }}</span>
      {% endif %}
    </button>
    <button class="nav-btn" id="tab-btn-commands" onclick="switchTab('commands')">
      <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="3"/><path d="m6 8 4 4-4 4m7 0h5"/></svg></span> CLI Commands
    </button>
    <button class="nav-btn" id="tab-btn-analytics" onclick="switchTab('analytics')">
      <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h17M7 16v-5M12 16V5M17 16V8"/></svg></span> Analytics
    </button>
    <button class="nav-btn" id="tab-btn-bounties" onclick="switchTab('bounties')">
      <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3h8v6a4 4 0 0 1-8 0ZM8 5H4v3a4 4 0 0 0 4 4m8-7h4v3a4 4 0 0 1-4 4m-4 1v6m-4 2h8"/></svg></span> Bounty Board
    </button>
    <button class="nav-btn" id="tab-btn-chat" onclick="switchTab('chat')">
      <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11a8 8 0 0 1-8 8H4l1-5a8 8 0 1 1 15-3Z"/><path d="M8 10h8M8 14h5"/></svg></span> AI Assistant
      <span class="tab-badge badge-accent">AI</span>
    </button>
  </nav>

  <div class="header-right">
    <!-- Notification Bell & Activity Center -->
    <div class="notification-wrapper" id="notification-wrapper">
      <button class="notification-bell-btn" id="notification-bell-btn" onclick="toggleNotificationDrawer()" title="Activity & Notifications" aria-label="Notifications">
        <svg class="bell-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
        <span class="notification-badge" id="notification-badge" style="display:none;">0</span>
      </button>
      <div class="notification-drawer" id="notification-drawer" style="display:none;">
        <div class="notification-drawer-header">
          <span>Command & Task Activity</span>
          <button class="notification-clear-btn" onclick="clearNotifications()">Clear</button>
        </div>
        <div class="notification-drawer-list" id="notification-drawer-list">
          <div class="notification-empty">No recent command activity</div>
        </div>
      </div>
    </div>

    <div class="timer-pill" title="Auto-refresh countdown">
      <span class="timer-dot"></span>
      <span id="countdown-text">{{ refresh_seconds }}s</span>
    </div>
    <span class="pill pill-{{ view.daemon_health }}">
      daemon: {{ view.daemon_health }}
    </span>
    <span class="pill pill-{{ view.llm_health }}">
      llm: {{ view.llm_health }}
    </span>
    <button class="theme-btn" onclick="window._toggleTheme()">theme</button>
  </div>
</header>

<!-- Floating Task Progress Toasts (Top Right) -->
<div class="toast-container" id="toast-container" aria-live="polite"></div>

<main class="main-content" id="main-content" tabindex="-1">
  <div class="workspace-topbar"><div class="workspace-breadcrumb"><span>Workspace</span><span aria-hidden="true">/</span><strong id="workspace-current-page">Mission Control</strong></div><div class="workspace-top-actions"><time class="workspace-date" id="workspace-date"></time><button id="command-trigger" class="command-trigger" aria-haspopup="dialog" aria-controls="command-palette"><span>Jump to…</span> <kbd>⌘ / Ctrl K</kbd></button></div></div>
  <p id="workspace-status" class="workspace-status" role="status" aria-live="polite"></p>
  <!-- TAB 1: PIPELINE & FUNNEL -->
  <div id="tab-funnel" class="tab-panel active">
    <div class="workspace-welcome">
      <div>
        <span class="workspace-eyebrow">A little focus. A big next chapter.</span>
        <h1 id="mission-title">Your next move starts here.</h1>
        <p>{% if view.config.profile %}Welcome back, {{ view.config.profile.name }}. {% endif %}Find the right opportunities. Make every application count.</p>
      </div>
      <span class="workspace-local">Your personal workspace</span>
    </div>
    <div id="onboarding-banner" hidden></div>
    <section class="workspace-hero" aria-labelledby="mission-title">
      <div class="focus-hero">
        <span class="workspace-eyebrow">Your daily focus</span>
        {% if not view.config.profile %}
        <h2>A better search<br>starts with your story.</h2>
        <p>Add your experience and the roles you want. Your profile gives every match a meaningful starting point.</p>
        <div class="focus-actions"><button class="focus-primary" onclick="openProfileSetup()">Set up your profile <span aria-hidden="true">↗</span></button><button class="focus-secondary" onclick="switchTab('explorer')">Explore jobs →</button></div>
        {% elif view.state_counts.rendered > 0 or view.state_counts.drafted > 0 %}
        <h2>Your preparation<br>is ready to pay off.</h2>
        <p>You have {{ view.state_counts.rendered }} rendered applications and {{ view.state_counts.drafted }} drafts. Review your work and choose the next step.</p>
        <div class="focus-actions"><button class="focus-primary" onclick="switchTab('actions')">Review applications <span aria-hidden="true">↗</span></button><button class="focus-secondary" onclick="switchTab('explorer')">Explore jobs →</button></div>
        {% elif view.kpi.shortlisted_active > 0 %}
        <h2>Great matches.<br>Thoughtful next steps.</h2>
        <p>{{ view.kpi.shortlisted_active }} shortlisted opportunities are waiting. Start with the roles that feel like a real step forward.</p>
        <div class="focus-actions"><button class="focus-primary" onclick="switchTab('actions')">Review your shortlist <span aria-hidden="true">↗</span></button><button class="focus-secondary" onclick="switchTab('explorer')">Explore jobs →</button></div>
        {% else %}
        <h2>Make room for<br>your next opportunity.</h2>
        <p>Your profile is ready. Explore discovered roles, refine your search, and build a shortlist worth your time.</p>
        <div class="focus-actions"><button class="focus-primary" onclick="switchTab('explorer')">Find your next role <span aria-hidden="true">↗</span></button><button class="focus-secondary" onclick="switchTab('config')">Tune your search →</button></div>
        {% endif %}
        <small class="focus-footnote">Thoughtful applications · dry-run by default · you stay in control</small>
        <svg class="focus-hero-art" viewBox="0 0 240 240" aria-hidden="true"><circle cx="140" cy="120" r="95"/><circle cx="140" cy="120" r="70"/><circle cx="140" cy="120" r="44"/><path d="M30 195 C 90 195, 75 100, 125 114 S 166 65, 212 43"/><circle class="path-point" cx="125" cy="114" r="7"/><circle class="path-point" cx="212" cy="43" r="9"/></svg>
      </div>
      <aside class="weekly-card" aria-labelledby="weekly-title">
        <div class="card-topline"><h2 id="weekly-title">A week of progress</h2><small>Your pace, your target</small></div>
        <div class="weekly-value"><span id="weekly-submitted">—</span> <small>/ <span id="weekly-goal-label">10</span> applications</small></div>
        <progress id="weekly-progress" max="10" value="0" aria-label="Applications submitted toward your weekly target"></progress>
        <p id="weekly-caption" class="weekly-caption" role="status">Loading this week’s activity…</p>
        <ol id="activity-chart" class="activity-chart" aria-label="Applications submitted in the last seven days"></ol>
        <div class="weekly-settings"><span id="activity-status">Actual submissions, including recorded responses</span><label for="weekly-goal">Target <input id="weekly-goal" type="number" min="1" max="100" step="1" value="10" title="Weekly application target, saved in this browser"></label></div>
        <button id="activity-retry" class="text-button" hidden>Retry activity</button>
      </aside>
    </section>

    <section class="kpi-strip" aria-label="Pipeline summary">
      <div class="kpi">
        <div class="kpi-num" data-count="{{ view.kpi.today_discovered }}">{{ view.kpi.today_discovered }}</div>
        <div class="kpi-label">New opportunities today</div>
        <div class="kpi-sub">Discovered since midnight UTC</div>
      </div>
      <div class="kpi">
        <div class="kpi-num accent-amber" data-count="{{ view.kpi.shortlisted_active }}">{{ view.kpi.shortlisted_active }}</div>
        <div class="kpi-label">Ready to tailor</div>
        <div class="kpi-sub">Ready for LLM tailoring</div>
      </div>
      <div class="kpi">
        <div class="kpi-num accent-indigo" data-count="{{ view.kpi.applied_lifetime }}">{{ view.kpi.applied_lifetime }}</div>
        <div class="kpi-label">Applications sent</div>
        <div class="kpi-sub">Submitted & responded</div>
      </div>
      <div class="kpi">
        <div class="kpi-num accent-emerald">{{ view.kpi.response_rate_label }}</div>
        <div class="kpi-label">Response rate</div>
        <div class="kpi-sub">Recorded responses / applications</div>
      </div>
    </section>

    <div class="workspace-grid">
      <section class="workspace-card" aria-labelledby="next-up-title">
        <div class="workspace-card-heading"><h2 id="next-up-title">A clear next step</h2><button onclick="switchTab('actions')">Action center ↗</button></div>
        <p class="workspace-card-subtitle">A few meaningful moves, one at a time.</p>
        {% if not view.config.profile %}
        <button class="focus-task" onclick="openProfileSetup()"><span class="task-icon">01</span><span><strong>Make this workspace yours</strong><small>Import a resume and review your profile</small></span><span class="task-arrow">↗</span></button>
        {% else %}
        <button class="focus-task" onclick="switchTab('actions')"><span class="task-icon">01</span><span><strong>Prepare your strongest applications</strong><small>{{ view.state_counts.shortlisted }} shortlisted · {{ view.state_counts.tailored }} tailored</small></span><span class="task-arrow">↗</span></button>
        {% endif %}
        <button class="focus-task" onclick="switchTab('explorer')"><span class="task-icon">02</span><span><strong>Discover a role that fits</strong><small>{{ view.kpi.today_discovered }} new today · {{ view.explorer_total }} in your workspace</small></span><span class="task-arrow">↗</span></button>
        <button class="focus-task" onclick="switchTab('analytics')"><span class="task-icon">03</span><span><strong>Keep the conversation going</strong><small>Review follow-ups, responses and interview feedback</small></span><span class="task-arrow">↗</span></button>
      </section>
      <section class="workspace-card" aria-labelledby="top-matches-title">
        <div class="workspace-card-heading"><h2 id="top-matches-title">Worth a closer look</h2><button onclick="switchTab('explorer')">All opportunities ↗</button></div>
        <p class="workspace-card-subtitle">Your highest-scoring shortlisted roles.</p>
        {% for col in view.columns %}{% if col.state == 'shortlisted' %}
        {% if col.top | length > 0 %}
        {% for card in col.top | slice(end=3) %}
        <div class="match-preview">
          <span class="match-monogram" aria-hidden="true">{{ card.company | truncate(length=1, end="") | upper }}</span>
          <div class="match-preview-info"><button onclick="openAppModal('{{ card.id | js | safe }}')">{{ card.title }}</button><small>{{ card.company }}</small></div>
          <span class="match-fit">{% if card.score is number %}{{ (card.score * 100) | round(method='floor') }}% match{% else %}Unscored{% endif %}</span>
        </div>
        {% endfor %}
        {% else %}
        <div class="workspace-empty"><strong>Your next match is out there.</strong>Shortlist a role from the explorer, or run matching after setting up your profile.<br><button class="text-button" onclick="switchTab('explorer')">Explore opportunities →</button></div>
        {% endif %}
        {% endif %}{% endfor %}
      </section>
    </div>

    <details class="workspace-details"><summary>Your setup checklist · {{ guided.headline }}</summary>
    <!-- NUMBERED GUIDED PATH: the operator's 1→7 sequence -->
    <section class="guided-path" aria-label="Setup checklist">
      <div class="guided-head">
        <h2>🧭 Guided Path</h2>
        <p class="guided-headline">{{ guided.headline }}</p>
      </div>
      <ol class="guided-steps">
        {% for step in guided.steps %}
        <li class="guided-step guided-{{ step.status }}">
          <span class="guided-num">
            {% if step.status == "done" %}✓{% else %}{{ step.number }}{% endif %}
          </span>
          <div class="guided-body">
            <span class="guided-title">{{ step.title }}</span>
            <span class="guided-hint">{{ step.hint }}</span>
            <code class="guided-cmd">{{ step.command }}</code>
          </div>
          {% if step.status == "current" %}
          <button type="button" class="btn-primary btn-sm guided-go" onclick="switchTab('{{ step.tab }}')">Do Step {{ step.number }} →</button>
          {% endif %}
        </li>
        {% endfor %}
      </ol>
    </section>

    </details>

    <!-- VISUAL APPLICATION FLOW STEPPER -->
    <div class="pipeline-stepper">
      <div class="stepper-step" onclick="filterFunnelStage('discovered', this)">
        <div class="step-badge accent-cyan">1</div>
        <div class="step-info"><span class="step-name">1. Discovery</span><span class="step-count">Ingested Feeds</span></div>
      </div>
      <div class="stepper-arrow">➔</div>
      <div class="stepper-step" onclick="filterFunnelStage('shortlisted', this)">
        <div class="step-badge accent-amber">2</div>
        <div class="step-info"><span class="step-name">2. Shortlisted</span><span class="step-count">{{ view.state_counts.shortlisted }} active</span></div>
      </div>
      <div class="stepper-arrow">➔</div>
      <div class="stepper-step" onclick="filterFunnelStage('tailored', this)">
        <div class="step-badge accent-indigo">3</div>
        <div class="step-info"><span class="step-name">3. LLM Tailored</span><span class="step-count">{{ view.state_counts.tailored }} drafted</span></div>
      </div>
      <div class="stepper-arrow">➔</div>
      <div class="stepper-step" onclick="filterFunnelStage('rendered', this)">
        <div class="step-badge accent-blue">4</div>
        <div class="step-info"><span class="step-name">4. Rendered</span><span class="step-count">{{ view.state_counts.rendered }} ready</span></div>
      </div>
      <div class="stepper-arrow">➔</div>
      <div class="stepper-step" onclick="filterFunnelStage('submitted', this)">
        <div class="step-badge accent-emerald">5</div>
        <div class="step-info"><span class="step-name">5. Applied</span><span class="step-count">{{ view.kpi.applied_lifetime }} submitted</span></div>
      </div>
    </div>

    <hr class="section-divider">

    <div class="filter-bar">
      <div class="search-box">
        <span class="search-icon">🔍</span>
        <input type="text" id="funnel-search" placeholder="Search by title, company..." oninput="filterFunnelCards(this.value)">
      </div>
      <div class="filter-pills">
        <span class="filter-pill active" onclick="filterFunnelStage('all', this)">All Stages</span>
        <span class="filter-pill" onclick="filterFunnelStage('discovered', this)">Discovered</span>
        <span class="filter-pill" onclick="filterFunnelStage('shortlisted', this)">Shortlisted</span>
        <span class="filter-pill" onclick="filterFunnelStage('tailored', this)">Tailored</span>
        <span class="filter-pill" onclick="filterFunnelStage('submitted', this)">Applied</span>
      </div>
    </div>

    <section class="funnel" id="job-pipeline" aria-label="Application pipeline">
      {% for col in view.columns %}
      <div class="col" data-stage="{{ col.state }}">
        <div class="col-head">
          <div class="col-head-left">
            <span class="stage-dot stage-{{ col.state }}"></span>
            <span class="col-label">{{ col.label }}</span>
          </div>
          <span class="col-count">{{ col.count }}</span>
        </div>

        {% if col.state == "discovered" and col.count > 0 %}
        <div class="col-actions-bar">
          <button type="button" class="btn-primary col-action-btn-full" onclick="runCliCommand('match', {}, this)" title="Score & shortlist all discovered listings">🎯 Match All Discovered</button>
        </div>
        {% elif col.state == "shortlisted" and col.top | length > 0 %}
        <div class="col-actions-bar">
          <label class="col-select-all-label">
            <input type="checkbox" onchange="toggleSelectAllColumn('shortlisted', this)"> Select All
          </label>
          <div style="display:flex; gap:5px; align-items:center;">
            <button type="button" class="btn-primary col-action-btn-pill" onclick="batchTailorTop(20, this)" title="Tailor top 20 matches">🎯 Top 20</button>
            <button type="button" class="btn-secondary col-action-btn-pill" onclick="batchTailorAllShortlisted(this)" title="Tailor all shortlisted listings">🎯 All</button>
          </div>
        </div>
        {% elif col.state == "tailored" and col.top | length > 0 %}
        <div class="col-actions-bar">
          <label class="col-select-all-label">
            <input type="checkbox" onchange="toggleSelectAllColumn('tailored', this)"> Select All
          </label>
          <div style="display:flex; gap:5px; align-items:center;">
            <button type="button" class="btn-primary col-action-btn-pill" onclick="batchRenderAllTailored(this)" title="Render all tailored applications to PDF/DOCX">📄 Render All</button>
            <button type="button" class="btn-secondary col-action-btn-icon" onclick="batchRollback('tailored', 'shortlisted', this)" title="Rollback all tailored jobs to shortlisted">↩️</button>
          </div>
        </div>
        {% elif col.state == "rendered" and col.top | length > 0 %}
        <div class="col-actions-bar">
          <label class="col-select-all-label">
            <input type="checkbox" onchange="toggleSelectAllColumn('rendered', this)"> All
          </label>
          <div style="display:flex; gap:5px; align-items:center;">
            <button type="button" class="btn-primary col-action-btn-pill" onclick="batchApplyAllRendered(this)" style="background:var(--accent-emerald); color:#fff; font-weight:600;" title="Apply to all rendered applications">🚀 Apply All</button>
            <button type="button" class="btn-secondary col-action-btn-pill" onclick="batchRenderAllTailored(this)" title="Re-render all applications to PDF/DOCX">🔄</button>
            <button type="button" class="btn-secondary col-action-btn-icon" onclick="batchRollback('rendered', 'tailored', this)" title="Rollback all rendered jobs to tailored">↩️</button>
          </div>
        </div>
        {% endif %}

        <div class="col-body">
          {% if col.top | length == 0 %}
          <div class="col-empty">No items</div>
          {% else %}
          {% for card in col.top %}
          <article class="card card-stage-{{ col.state }} {% if col.state == 'shortlisted' or col.state == 'tailored' or col.state == 'rendered' %}card-has-cb{% endif %}" data-stage="{{ col.state }}" data-id="{{ card.id }}" data-title="{% if card.title %}{{ card.title | lower }}{% endif %}" data-company="{% if card.company %}{{ card.company | lower }}{% endif %}" onclick="openAppModal('{{ card.id | js | safe }}')">
            {% if col.state == "tailored" %}
            <input type="checkbox" class="card-select-cb batch-cb-tailored" data-id="{{ card.id }}" onclick="event.stopPropagation(); updateBatchToolbar();" title="Select for batch rendering">
            {% endif %}

            {% if col.state == "shortlisted" or col.state == "rendered" %}
            <div class="job-card-topline">
              <label class="card-selection-control" onclick="event.stopPropagation();" title="{% if col.state == 'shortlisted' %}Select for batch tailoring{% else %}Select for batch apply{% endif %}">
                {% if col.state == "shortlisted" %}
                <input type="checkbox" class="card-select-cb batch-cb-shortlisted" data-id="{{ card.id }}" onclick="event.stopPropagation(); updateBatchToolbar();" aria-label="Select {{ card.title }} for batch tailoring">
                {% else %}
                <input type="checkbox" class="card-select-cb batch-cb-rendered" data-id="{{ card.id }}" onclick="event.stopPropagation(); updateBatchToolbar();" aria-label="Select {{ card.title }} for batch apply">
                {% endif %}
                <span>Select</span>
              </label>
              <span class="job-stage-chip job-stage-chip-{{ col.state }}">
                <span class="job-stage-chip-dot" aria-hidden="true"></span>
                {% if col.state == "shortlisted" %}Ready to tailor{% else %}Application ready{% endif %}
              </span>
            </div>

            <div class="job-card-heading">
              <h3 class="card-title">{{ card.title }}</h3>
              {% if card.score %}
              <span class="job-fit-score" title="Overall job match score">
                <strong>{{ (card.score * 100) | round(method="floor") }}%</strong><span>match</span>
              </span>
              {% endif %}
            </div>

            <div class="job-company-line">
              <span class="company-mark" aria-hidden="true"></span>
              <span class="card-company">{{ card.company }}</span>
            </div>

            {% if col.state == "rendered" %}
            <div class="artifact-ready-strip">
              <span class="artifact-document" aria-hidden="true"></span>
              <span class="artifact-ready-copy">
                <strong>Application pack</strong>
                <small>PDF + DOCX ready</small>
              </span>
              <span class="artifact-check" aria-hidden="true">✓</span>
            </div>
            {% endif %}

            <div class="card-actions-bar job-card-actions" onclick="event.stopPropagation();">
              {% if col.state == "shortlisted" %}
              <button type="button" class="job-primary-action btn-tailor" onclick="tailorListing('{{ card.id | js | safe }}', this)" title="Tailor resume and cover letter">
                <span>Tailor application</span><span class="action-arrow" aria-hidden="true">→</span>
              </button>
              <button type="button" class="job-secondary-action" onclick="openAppModal('{{ card.id | js | safe }}')" title="Inspect job details">Details</button>
              {% else %}
              <button type="button" class="job-primary-action job-primary-apply btn-apply" onclick="applyApplication('{{ card.id | js | safe }}', this)" title="Submit or dry-run application">
                <span>Apply now</span><span class="action-arrow" aria-hidden="true">→</span>
              </button>
              <button type="button" class="job-icon-action" onclick="openAppModal('{{ card.id | js | safe }}')" title="Inspect job details" aria-label="Inspect job details">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M2.5 10s2.7-4.5 7.5-4.5 7.5 4.5 7.5 4.5-2.7 4.5-7.5 4.5S2.5 10 2.5 10Z"></path><circle cx="10" cy="10" r="2"></circle></svg>
              </button>
              <button type="button" class="job-icon-action btn-render" onclick="renderApplication('{{ card.id | js | safe }}', this)" title="Re-render PDF and DOCX artifacts" aria-label="Re-render application">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M15.4 7.1A6 6 0 1 0 16 12"></path><path d="M12.8 3.8h3.3v3.3"></path></svg>
              </button>
              <button type="button" class="job-icon-action job-icon-muted" onclick="rollbackApplication('{{ card.id | js | safe }}', 'tailored', this)" title="Move back to Tailored" aria-label="Move application back to Tailored">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7.2 5.1-3.4 3.4 3.4 3.4"></path><path d="M4.2 8.5h6.4a5 5 0 0 1 5 5v1.1"></path></svg>
              </button>
              {% endif %}
            </div>
            {% else %}
            <div class="card-header">
              <span class="card-title">{{ card.title }}</span>
              {% if card.score %}
              <span class="score-badge {% if card.score >= 0.8 %}score-high{% elif card.score >= 0.7 %}score-mid{% else %}score-low{% endif %}">
                {{ (card.score * 100) | round(method="floor") }}%
              </span>
              {% endif %}
            </div>
            <div class="card-meta">
              <span class="card-company">🏢 {{ card.company }}</span>
              <button type="button" class="detail-link-btn" onclick="event.stopPropagation(); openAppModal('{{ card.id | js | safe }}')">Inspect →</button>
            </div>
            {% if col.state == "discovered" or col.state == "shortlisted" or col.state == "tailored" or col.state == "rendered" %}
            <div class="card-actions-bar" onclick="event.stopPropagation();">
              {% if col.state == "discovered" %}
              <button type="button" class="card-action-btn" style="color:var(--accent-amber);" onclick="forceShortlist('{{ card.id | js | safe }}')" title="Shortlist this listing">⚡ Shortlist</button>
              {% elif col.state == "tailored" %}
              <button type="button" class="card-action-btn btn-render" onclick="renderApplication('{{ card.id | js | safe }}', this)" title="Render PDF & DOCX artifacts">📄 Render</button>
              <button type="button" class="card-action-btn" style="color:var(--text-muted);" onclick="rollbackApplication('{{ card.id | js | safe }}', 'shortlisted', this)" title="Rollback to Shortlisted">↩️ Rollback</button>
              {% endif %}
            </div>
            {% endif %}
            {% endif %}
          </article>
          {% endfor %}
          {% endif %}
          {% if col.count > col.top | length %}
          <p class="empty">Showing the top {{ col.top | length }} of {{ col.count }}. <button class="text-button" onclick="switchTab('explorer')">Browse opportunities →</button></p>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </section>

    <section class="next-steps" aria-label="Recommended next steps">
      <div class="section-title">
        <span>⚡ System Recommendations & Next Steps</span>
      </div>
      {% if view.next_steps | length == 0 %}
      <p class="empty">All automated pipeline steps caught up.</p>
      {% else %}
      <div class="steps-grid">
        {% for step in view.next_steps %}
        <div class="step-card urgency-{{ step.urgency }}">
          <span class="step-urgency-badge">{{ step.urgency }}</span>
          <span class="step-label">{{ step.label }}</span>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </section>
    <details class="workspace-details"><summary>How your career story connects</summary>
    <section class="career-story" aria-labelledby="story-title">
      <div class="story-heading">
        <div>
          <span class="story-kicker">One story · three realities</span>
          <h2 id="story-title">From career history to career velocity.</h2>
        </div>
        <p>Every signal in your past becomes leverage for the next move—without the repetitive application grind.</p>
      </div>

      <div class="story-acts">
        <article class="story-act act-manual">
          <div class="act-label"><span>Act 01</span><b>The manual grind</b></div>
          <h3>Your energy disappears into forms.</h3>
          <p class="act-intro">The same facts, rewritten for every portal. The same résumé, uploaded again.</p>
          <div class="paper-stack" aria-hidden="true">
            <span class="manual-error-toast">Required field missing</span>
            <span class="manual-rejected-stamp">Rejected</span>
            <span class="manual-spinner"><i></i> uploading 99%</span>
            <div class="paper paper-back"><span>FORM 08/19</span></div>
            <div class="paper paper-mid"><span>WORK HISTORY</span><i></i><i></i><i></i></div>
            <div class="paper paper-front">
              <div class="paper-head"><span>APPLICATION</span><b>!</b></div>
              <i></i><i></i><i class="paper-field-short"></i>
              <em>UPLOAD RESUME AGAIN</em>
              <strong>FORMAT ERROR</strong>
            </div>
            <span class="manual-cursor">↖</span>
          </div>
          <div class="manual-fragment-line" aria-hidden="true">
            <span class="fragment-done"></span><i></i><span></span><i></i><span class="fragment-error"></span><i></i><span></span>
          </div>
          <div class="grind-stats">
            <span><b>42</b><small>fields / role</small></span>
            <span><b>∞</b><small>context switches</small></span>
            <span><b>0</b><small>energy left</small></span>
          </div>
        </article>

        <article class="story-act act-career">
          <div class="act-label"><span>Act 02</span><b>Your career genome</b></div>
          {% if view.config.profile %}
          <div class="career-card-head">
            <div class="career-avatar" aria-hidden="true">◎</div>
            <div><h3>{{ view.config.profile.name }}</h3><p>{{ view.config.profile.location }}</p></div>
            <span>LIVE PROFILE</span>
          </div>
          <div class="career-workbench">
            <div class="career-timeline" role="list" aria-label="Career timeline">
              {% for moment in view.config.profile.career_story %}
              <button type="button" class="career-moment {% if loop.first %}active{% endif %}" role="listitem" data-era="{{ moment.era }}" data-title="{{ moment.title }}" data-organization="{{ moment.organization }}" data-proof="{{ moment.proof }}" onclick="activateCareerMoment(this)">
                <span class="moment-node moment-{{ moment.kind }}"></span>
                <span class="moment-copy">
                  <small>{{ moment.era }}</small>
                  <strong>{{ moment.title }}</strong>
                  <em>{{ moment.organization }}</em>
                  <span class="moment-proof">{{ moment.proof }}</span>
                </span>
              </button>
              {% endfor %}
            </div>
            <aside class="resume-live-preview" aria-label="Resume canvas preview">
              <div class="resume-preview-head"><span>LIVE RÉSUMÉ</span><i></i></div>
              <strong id="resume-preview-title">Career signal selected</strong>
              <small id="resume-preview-org">Building candidate context…</small>
              <div class="resume-preview-lines" aria-hidden="true"><i></i><i></i><i></i></div>
              <p id="resume-preview-proof">Select a milestone to render its evidence into the résumé canvas.</p>
              <div class="skill-unlock"><span>Skill unlocked</span><b id="resume-preview-skill">EXPERIENCE</b></div>
            </aside>
          </div>
          <div class="genome-footer"><span>Résumé signal</span><strong>{{ view.config.profile.skill_count }} skills · {{ view.config.profile.experience_count }} roles · continuously enriched</strong></div>
          {% else %}
          <div class="career-empty">
            <span>+</span><h3>Your story starts here</h3>
            <p>Import a résumé or LinkedIn archive and CareerAI will turn it into a living, editable timeline.</p>
            <button type="button" onclick="switchTab('config')">Build my profile →</button>
          </div>
          {% endif %}
        </article>

        <article class="story-act act-autopilot">
          <div class="act-label"><span>Act 03</span><b>CareerAI autopilot</b></div>
          <h3>One profile. A system that moves.</h3>
          <p class="act-intro">Your search becomes an observable pipeline, with a human checkpoint where it matters.</p>
          <div class="autopilot-engine" aria-hidden="true">
            <span class="engine-core"><i></i></span>
            <span class="engine-label">AUTOFILL ENGINE</span>
            <span class="engine-scan">ATS CLEAR</span>
          </div>
          <div class="automation-flow" data-current-step="{{ guided.current_number }}">
            <span class="pipeline-packet" aria-hidden="true"></span>
            {% for step in guided.steps %}
            <button type="button" class="automation-step automation-{{ step.status }}" onclick="switchTab('{{ step.tab }}')">
              <span class="automation-index">0{{ step.number }}</span>
              <span class="automation-copy"><strong>{{ step.title }}</strong><small>{{ step.command }}</small></span>
              <span class="automation-state">{% if step.status == "done" %}✓{% elif step.status == "current" %}RUN{% else %}·{% endif %}</span>
            </button>
            {% endfor %}
          </div>
          <div class="autopilot-footer"><span class="live-beacon"></span><strong>System ready</strong><small>Next action: {{ guided.headline }}</small></div>
        </article>
      </div>
    </section>
    </details>
  </div>

  <!-- TAB 2: SYSTEM AUDIT EVENTS -->
  <div id="tab-events" class="tab-panel">
    <div class="panel-header mission-panel-head head-events">
      <div class="panel-head-main">
        <span class="panel-kicker"><i></i> Observability layer</span>
        <h2>Every decision leaves a trail.</h2>
        <p class="panel-desc">Follow every state transition, system choice, and candidate touchpoint from one immutable operational history.</p>
      </div>
      <div class="panel-head-stats">
        <div><small>Events in view</small><strong id="events-stat-count">{{ view.recent_events | length }}</strong></div>
        <div><small>System of record</small><strong>SQLite</strong></div>
        <button type="button" class="btn-refresh-feed" onclick="refreshEventsTable()" title="Refresh events feed">🔄 Refresh Feed</button>
      </div>
    </div>

    <div class="filter-bar">
      <div class="search-box">
        <span class="search-icon">🔍</span>
        <input type="text" id="event-search" placeholder="Search event notes, payload, listing ID..." oninput="filterEvents()">
      </div>
      <div class="filter-pills">
        <span class="filter-pill active" onclick="filterEventsSeverity('all', this)">All Severities</span>
        <span class="filter-pill" onclick="filterEventsSeverity('info', this)">Info</span>
        <span class="filter-pill" onclick="filterEventsSeverity('warn', this)">Warning</span>
        <span class="filter-pill" onclick="filterEventsSeverity('error', this)">Error</span>
      </div>
    </div>

    <div class="table-container audit-table-container">
      <table class="audit-table">
        <thead>
          <tr>
            <th style="width: 100px;">Time</th>
            <th style="width: 85px;">Severity</th>
            <th style="width: 170px;">Listing ID</th>
            <th style="width: 200px;">Transition</th>
            <th>Note & Payload</th>
          </tr>
        </thead>
        <tbody id="events-tbody">
          {% if view.recent_events | length == 0 %}
          <tr>
            <td colspan="5" class="empty-cell">
              <div class="empty-events-state">
                <span class="empty-icon">📋</span>
                <p>No recent system events recorded.</p>
              </div>
            </td>
          </tr>
          {% else %}
          {% for ev in view.recent_events %}
          <tr class="event-row" data-severity="{{ ev.severity }}" data-search="{% if ev.listing_id %}{{ ev.listing_id | lower }}{% endif %} {% if ev.summary %}{{ ev.summary | lower }}{% elif ev.note %}{{ ev.note | lower }}{% endif %} {% if ev.raw_payload %}{{ ev.raw_payload | lower }}{% endif %}">
            <td class="time-cell" title="{{ ev.timestamp }}">
              <span class="rel-time">{{ ev.relative_time }}</span>
            </td>
            <td>
              <span class="sev-badge sev-{{ ev.severity }}">{{ ev.severity }}</span>
            </td>
            <td>
              {% if ev.listing_id and ev.listing_id != "" and ev.listing_id != "00000000-0000-0000-0000-000000000000" %}
                <span class="listing-id-pill" onclick="openAppModal('{{ ev.listing_id | js | safe }}')" title="View Listing Details">{{ ev.listing_id }}</span>
              {% else %}
                <span class="muted-dash">—</span>
              {% endif %}
            </td>
            <td>
              <span class="transition-pill transition-{{ ev.severity }}">
                {% if ev.from_state %}{{ ev.from_state }}{% else %}start{% endif %} <span class="arrow-glyph">→</span> <strong>{{ ev.to_state }}</strong>
              </span>
            </td>
            <td class="note-cell">
              <div class="event-note-wrapper">
                <div class="event-summary-line sev-text-{{ ev.severity }}">
                  {% if ev.severity == "error" %}
                    <span class="event-icon sev-error-icon">✕</span>
                  {% elif ev.severity == "warn" %}
                    <span class="event-icon sev-warn-icon">!</span>
                  {% else %}
                    <span class="event-icon sev-info-icon">●</span>
                  {% endif %}
                  <span class="event-summary-text">{{ ev.summary | default(value=ev.note | default(value="State transition executed")) }}</span>
                </div>
                {% if ev.raw_payload %}
                <details class="event-payload-details">
                  <summary class="event-payload-summary">
                    <span class="payload-toggle-icon">▸</span>
                    <span class="payload-toggle-text">Execution Log Details</span>
                    <button type="button" class="btn-copy-payload" onclick="event.stopPropagation(); copyPayloadText(this)" title="Copy log to clipboard">📋 Copy</button>
                  </summary>
                  <pre class="event-raw-log"><code>{{ ev.raw_payload }}</code></pre>
                </details>
                {% endif %}
              </div>
            </td>
          </tr>
          {% endfor %}
          {% endif %}
        </tbody>
      </table>
    </div>
  </div>

  <!-- TAB 3: CONFIG & SOURCES INSPECTOR -->
  <div id="tab-config" class="tab-panel">
    <div class="panel-header mission-panel-head head-config">
      <div class="panel-head-main">
        <span class="panel-kicker"><i></i> Intelligence layer</span>
        <h2>Tune the mind behind the search.</h2>
        <p class="panel-desc">Shape discovery, scoring, source coverage, profile context, and model strategy from one controlled surface.</p>
      </div>
      <div class="panel-head-stats">
        <div><small>Active sources</small><strong>{{ view.config.sources | length }}</strong></div>
        <div><small>Search signals</small><strong>{{ view.config.keywords | length }}</strong></div>
        <span class="panel-live"><i></i> {{ view.config.llm_strategy }} strategy</span>
      </div>
    </div>

    <div class="copilot-hint-banner" style="background:hsl(217 33% 15%); border:1px solid hsl(217 33% 25%); border-left:4px solid hsl(38 92% 50%); border-radius:var(--radius-sm); padding:10px 14px; margin-bottom:16px; display:flex; justify-content:space-between; align-items:center; gap:12px;">
      <div style="font-size:13px; color:var(--text-primary); display:flex; align-items:center; gap:8px;">
        <span>💡 <strong>Config & Match Hint:</strong> Add domain keywords below, configure your LLM backend, and adjust match threshold. Click <em>"🔄 Rematch Shortlisted"</em> to prune or restore jobs across the database.</span>
      </div>
      <button type="button" class="btn-primary" onclick="switchTab('chat'); usePromptChip('Suggest priority keywords for Remote Embedded AI & Robotics')" style="padding:4px 10px; font-size:11px; white-space:nowrap;">🤖 Keyword Suggestions ↗</button>
    </div>

    <div class="config-grid">
      <!-- Discovery Observatory — keywords become signals moving through live sources. -->
      <section class="config-card keyword-observatory" aria-labelledby="observatory-title">
        <header class="observatory-header">
          <div>
            <span class="observatory-kicker"><i></i> Discovery observatory · live network</span>
            <h3 id="observatory-title">Watch your career signals find opportunity.</h3>
            <p>Keywords radiate across every configured source. New postings return as inbound matches, not rows in a spreadsheet.</p>
          </div>
          <div class="observatory-actions">
            <button type="button" class="observatory-run observatory-run-discover" onclick="runDiscoveryExperience('discover', this)" title="Search all configured sources">
              <span class="run-icon">⌁</span><span><b>Run discovery</b><small>scan {{ view.config.sources | length }} sources</small></span>
            </button>
            <button type="button" class="observatory-run observatory-run-match" onclick="runDiscoveryExperience('match', this)" title="Score discovered jobs against your profile">
              <span class="run-icon">◎</span><span><b>Match signals</b><small>rank new postings</small></span>
            </button>
            <button type="button" class="observatory-run observatory-run-all" onclick="runDiscoveryExperience('run', this)" title="Run the dry-run-first pipeline">
              <span class="run-icon">↗</span><span><b>Engage autopilot</b><small>dry-run by default</small></span>
            </button>
          </div>
        </header>

        <div class="discovery-observatory" id="discovery-observatory">
          <div class="discovery-stage" id="discovery-stage">
            <canvas id="discovery-network-canvas" aria-hidden="true"></canvas>
            <div class="discovery-grid" aria-hidden="true"></div>
            <div class="source-orbit" aria-label="Configured job-source network">
              {% for src in view.config.sources %}
              <button type="button" class="source-satellite source-satellite-{{ src.status }}" data-source="{{ src.name }}" data-count="{{ src.listing_count }}" data-source-index="{{ loop.index0 }}" onclick="filterExplorerBySource('{{ src.name | js | safe }}')" title="Open {{ src.name }} jobs in Explorer">
                <i aria-hidden="true"></i><span>{{ src.name }}</span><small>{{ src.listing_count }}</small>
              </button>
              {% endfor %}
            </div>

            <div class="signal-constellation" id="signal-constellation" aria-label="Priority keyword constellation">
              {% for kw in view.config.keywords | sort(attribute="name") %}
              <button type="button" class="keyword-orbit-node {% if loop.index > 28 %}keyword-orbit-secondary{% endif %}" data-keyword="{{ kw.name }}" data-keyword-index="{{ loop.index0 }}" onclick="toggleKeyword('{{ kw.name | js | safe }}')" title="{{ kw.name }} · click to remove">
                <i aria-hidden="true"></i><span>{{ kw.name }}</span>
              </button>
              {% endfor %}
            </div>

            <div class="discovery-globe" aria-label="Global job discovery engine">
              <div class="globe-atmosphere" aria-hidden="true"></div>
              <div class="globe-grid globe-grid-a" aria-hidden="true"></div>
              <div class="globe-grid globe-grid-b" aria-hidden="true"></div>
              <div class="globe-core-copy">
                <small>CAREER SIGNAL</small>
                <strong>{{ view.config.keywords | length }}</strong>
                <span>KEYWORDS ACTIVE</span>
              </div>
              <div class="globe-sweep" aria-hidden="true"></div>
            </div>

            <div class="match-impact-layer" id="match-impact-layer" aria-hidden="true"></div>
            <div class="observatory-legend">
              <span><i class="legend-signal"></i> search signal</span>
              <span><i class="legend-source"></i> job source</span>
              <span><i class="legend-match"></i> matched posting</span>
            </div>
          </div>

          <aside class="discovery-telemetry" aria-label="Discovery telemetry">
            <div class="telemetry-head"><span><i></i> Live telemetry</span><small id="discovery-mode-label">listening</small></div>
            <div class="telemetry-metrics">
              <div><small>Network</small><strong>{{ view.config.sources | length }}</strong><span>sources online</span></div>
              <div><small>Indexed</small><strong>{{ view.kpi.today_discovered }}</strong><span>new today</span></div>
              <div><small>Qualified</small><strong>{{ view.kpi.shortlisted_active }}</strong><span>active matches</span></div>
            </div>
            <div class="telemetry-feed" id="discovery-telemetry-feed">
              {% for src in view.config.sources %}
              {% if loop.index <= 6 %}
              <button type="button" onclick="filterExplorerBySource('{{ src.name | js | safe }}')">
                <span class="feed-pulse"></span><b>{{ src.name }}</b><small>{{ src.listing_count }} indexed</small><em>↗</em>
              </button>
              {% endif %}
              {% endfor %}
            </div>
            <div class="telemetry-caption"><span>18-source search fabric</span><small>Inbound packets are visual previews; pipeline state remains authoritative.</small></div>
          </aside>
        </div>

        <details class="keyword-vault">
          <summary>
            <span><i>⌘</i><b>Signal vault</b><small>Review, search, add, or remove every discovery keyword</small></span>
            <strong>{{ view.config.keywords | length }} signals <i>↓</i></strong>
          </summary>
          <div class="keyword-vault-toolbar">
            <label><span>⌕</span><input type="search" id="keyword-filter-input" class="form-control" placeholder="Filter signals…" oninput="filterKeywordVault(this.value)"></label>
            <span>Click a signal to remove it from discovery</span>
          </div>
          <div id="keywords-container" class="keyword-vault-grid">
            {% for kw in view.config.keywords | sort(attribute="name") %}
            <button type="button" class="kw-chip" data-keyword="{{ kw.name }}" onclick="toggleKeyword('{{ kw.name | js | safe }}')" title="Remove {{ kw.name }}">
              <span><i></i>{{ kw.name }}</span><b aria-hidden="true">×</b>
            </button>
            {% endfor %}
          </div>
          <div class="keyword-add-row">
            <label for="new-kw-input">Add a new career signal</label>
            <div><input type="text" id="new-kw-input" class="form-control" placeholder="e.g. Yocto, RTOS, PyTorch, ROS2…" onkeydown="if(event.key==='Enter'){event.preventDefault();addCustomKeyword();}"><button type="button" class="btn-primary" onclick="addCustomKeyword()">Add signal <span>↗</span></button></div>
          </div>
        </details>
      </section>

      <!-- Active Sources Card -->
      <div class="config-card">
        <div class="config-card-header">
          <h3>📥 Active Job Sources</h3>
          <div style="display:flex; gap:8px; align-items:center;">
            <button type="button" class="btn-primary" onclick="runCliCommand('discover', {}, this)" style="padding:4px 10px; font-size:11px;" title="Run discovery on all sources">⚡ Run Discover</button>
            <span class="badge">{{ view.config.sources | length }} sources</span>
          </div>
        </div>
        <div class="sources-list" style="max-height: 440px; overflow-y: auto; padding-right: 4px;">
          {% for src in view.config.sources %}
          <div class="source-item" style="cursor: pointer;" onclick="filterExplorerBySource('{{ src.name | js | safe }}')" title="Click to view all {{ src.name }} jobs in Explorer">
            <div class="source-main">
              <span class="source-name">⚡ {{ src.name }}</span>
              <span class="source-kind">{{ src.kind }}</span>
              <span class="source-rate-sub">
                {% if src.max_per_day > 0 %}{{ src.max_per_day }}/day{% else %}50/day{% endif %}
                {% if src.min_seconds_between > 0 %} · {{ src.min_seconds_between }}s apart{% endif %}
                {% if src.quiet_hours_utc %} · quiet {{ src.quiet_hours_utc[0] }}–{{ src.quiet_hours_utc[1] }} UTC{% endif %}
              </span>
            </div>
            <div class="source-stats">
              <span class="source-count">{{ src.listing_count }} jobs</span>
              {% if src.url %}
              <a href="{{ src.url | posting_url }}" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation();" class="source-portal-btn" title="Open {{ src.name }} portal">🌐 portal ↗</a>
              {% else %}
              <span class="source-portal-btn" style="opacity:0.2;">—</span>
              {% endif %}
              <span class="status-pill status-{{ src.status }} status-col-ready">{{ src.status }}</span>
              {% if src.submit_enabled %}
              <span class="status-pill status-active status-col-submit" title="Live submission enabled">submit on</span>
              {% else %}
              <span class="status-pill status-ready status-col-submit" title="Live submission disabled (dry-run default)">submit off</span>
              {% endif %}
            </div>
          </div>
          {% endfor %}
          {% if view.config.sources | length == 0 %}
          <div class="empty">No active sources indexed yet.</div>
          {% endif %}
        </div>
      </div>

      <!-- Interactive LLM Configuration Form Card — ALONGSIDE ACTIVE SOURCES -->
      <div class="config-card config-form-card">
        <div class="config-card-header">
          <h3>⚙️ Configure LLM Backend & API</h3>
          <span class="pill pill-info">Live Setup</span>
        </div>
        <form id="llm-config-form" onsubmit="saveLlmSettings(event)" class="config-form">
          <div class="form-group">
            <label for="cfg-strategy">⚡ Tailoring Strategy (Local Zero-LLM vs Live LLM)</label>
            <select id="cfg-strategy" class="form-control">
              <option value="local" {% if view.config.llm_strategy == "local" %}selected{% endif %}>local — Deterministic Fast-Path (0 Tokens, &lt;1ms, $0.00 Cost)</option>
              <option value="llm" {% if view.config.llm_strategy == "llm" %}selected{% endif %}>llm — Live LLM Generator (Claude / DeepSeek / Gemini / OpenAI)</option>
            </select>
          </div>
          <div class="form-group">
            <label for="cfg-backend">LLM Backend / Agentic Tool</label>
            <select id="cfg-backend" class="form-control">
              <option value="auto" {% if view.config.llm_backend == "auto" %}selected{% endif %}>auto (Auto-detect)</option>
              <option value="claude-cli" {% if view.config.llm_backend == "claude-cli" %}selected{% endif %}>claude-cli (Claude Code CLI)</option>
              <option value="agy" {% if view.config.llm_backend == "agy" %}selected{% endif %}>agy (Google Antigravity CLI)</option>
              <option value="goose" {% if view.config.llm_backend == "goose" %}selected{% endif %}>goose (Goose AI Agent)</option>
              <option value="aider" {% if view.config.llm_backend == "aider" %}selected{% endif %}>aider (Aider Pair Programmer)</option>
              <option value="codex" {% if view.config.llm_backend == "codex" %}selected{% endif %}>codex (OpenAI Codex CLI)</option>
              <option value="pi" {% if view.config.llm_backend == "pi" %}selected{% endif %}>pi (PI Agent CLI)</option>
              <option value="grok" {% if view.config.llm_backend == "grok" %}selected{% endif %}>grok (Grok / xAI CLI)</option>
              <option value="llama-cpp" {% if view.config.llm_backend == "llama-cpp" %}selected{% endif %}>llama-cpp (Llama.cpp Local)</option>
              <option value="api" {% if view.config.llm_backend == "api" %}selected{% endif %}>api (Custom HTTP API / DeepSeek / OpenAI / OpenRouter)</option>
            </select>
          </div>
          <div class="form-group">
            <label for="cfg-model">Model Name / Identifier (Optional)</label>
            <input type="text" id="cfg-model" class="form-control" placeholder="deepseek-chat, gpt-4o-mini, claude-3-5-sonnet" value="{{ view.config.llm_model }}">
          </div>
          <div class="form-group">
            <label for="cfg-api-base">Custom API Base URL (Optional)</label>
            <input type="text" id="cfg-api-base" class="form-control" placeholder="https://api.deepseek.com/v1 or http://localhost:11434/v1" value="{{ view.config.llm_api_base | default(value='') }}">
          </div>
          <div class="form-group">
            <label for="cfg-api-key">API Key / Token (Saved in config/local.yaml)</label>
            <input type="password" id="cfg-api-key" class="form-control" placeholder="sk-deepseek-... or sk-ant-api..." value="">
          </div>
          <div class="form-group">
            <label for="cfg-timeout">LLM Request Timeout in Seconds (Default: 300s / 5 mins for long prompts)</label>
            <input type="number" id="cfg-timeout" class="form-control" placeholder="300" value="{{ view.config.llm_timeout_seconds }}" min="10" max="3600">
          </div>
          <div class="form-actions">
            <button type="submit" class="btn-primary">💾 Save LLM Settings</button>
            <span id="save-status-msg" class="save-status"></span>
          </div>
        </form>
      </div>

      <!-- LLM Engine Card — SIDE-BY-SIDE WITH JACCARD MATCH THRESHOLD -->
      <div class="config-card">
        <div class="config-card-header">
          <h3>🤖 LLM Tailoring Engine</h3>
          <span class="pill pill-{{ view.llm_health }}">{{ view.llm_health }}</span>
        </div>
        <div class="config-details">
          <div class="config-row">
            <span class="config-label">Strategy</span>
            <span class="config-value accent-emerald">{% if view.config.llm_strategy == "local" %}⚡ Local Fast-Path (0 Tokens, &lt;1ms){% else %}🤖 Live LLM Model{% endif %}</span>
          </div>
          <div class="config-row">
            <span class="config-label">Provider</span>
            <span class="config-value">{{ view.config.llm_provider }}</span>
          </div>
          <div class="config-row">
            <span class="config-label">Model</span>
            <span class="config-value accent-indigo">{{ view.config.llm_model }}</span>
          </div>
          <div class="config-row">
            <span class="config-label">Prompt Version</span>
            <span class="config-value">{{ view.config.prompt_version }}</span>
          </div>
          <div class="config-row">
            <span class="config-label">Rate Limit</span>
            <span class="config-value">{{ view.config.rate_limit_per_min }} req/min</span>
          </div>
        </div>
      </div>

      <!-- Matching Score Threshold Card — SIDE-BY-SIDE WITH LLM ENGINE -->
      <div class="config-card">
        <div class="config-card-header">
          <h3>🎚️ Jaccard Match Threshold</h3>
          <span class="pill pill-info" id="threshold-status-pill">{{ view.config.score_threshold | round(precision=3) }}</span>
        </div>
        <div class="config-details" style="gap:12px;">
          <p style="font-size:12px; color:var(--text-muted); margin:0 0 8px;">
            Weighted token Jaccard similarity threshold. Listings below this score are moved to
            <em>Filtered Out</em>. Typical range: <strong>0.003</strong> (broad match) to <strong>0.035+</strong> (top-tier match).
            Click <strong>🔄 Rematch Shortlisted</strong> to re-evaluate and restore or prune listings.
          </p>

          <div style="display:flex; align-items:center; gap:10px; margin-bottom:4px;">
            <label style="font-size:12px; color:var(--text-muted); white-space:nowrap;">Threshold</label>
            <input type="range" id="threshold-slider" min="0.001" max="0.050" step="0.001"
              value="{{ view.config.score_threshold }}"
              style="flex:1; accent-color: hsl(160 84% 39%);"
              oninput="syncThresholdInput(this.value)">
            <input type="number" id="threshold-input" min="0.001" max="0.050" step="0.001"
              value="{{ view.config.score_threshold | round(precision=3) }}"
              style="width:78px; text-align:center; font-size:13px; font-weight:600; padding:4px 6px;"
              class="form-control"
              oninput="syncThresholdSlider(this.value)">
          </div>

          <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:6px;">
            <button type="button" class="btn-primary" style="flex:1; min-width:120px;"
              onclick="saveThreshold()">
              💾 Set Threshold
            </button>
            <button type="button" class="btn-primary"
              style="flex:1; min-width:140px; background: hsl(207 90% 54%);"
              onclick="rematchShortlisted()">
              🔄 Rematch Shortlisted
            </button>
          </div>
          <div id="threshold-msg" style="font-size:12px; min-height:18px; color:var(--text-muted); margin-top:4px;"></div>
        </div>
      </div>

      <!-- Generate Config from Profile — RIGHT of Configure LLM Backend -->
      <div class="config-card config-gen-card">
        <div class="config-card-header">
          <h3>⚙️ Generate Config from Profile</h3>
          <span class="pill pill-info">Auto Setup</span>
        </div>
        <p class="card-subtitle" style="margin-bottom:12px; color:var(--text-secondary); font-size:13px;">Derive discovery keywords, target roles, and job sources from <code>profile/profile.yaml</code> — review the merged <code>config/local.yaml</code> before applying.</p>
        <div class="form-actions">
          <button type="button" class="btn-primary" onclick="generateConfig()">⚙️ Generate Config from Profile</button>
          <span id="config-gen-status-msg" class="save-status"></span>
        </div>

        <!-- Config generation preview + apply (two-step, non-destructive) -->
        <div id="config-diff-panel" style="display:none; margin-top:16px;">
          <h4 style="margin-bottom:8px; color:var(--text-secondary); font-size:13px; font-weight:600;">CONFIG PREVIEW</h4>
          <p style="font-size:12px; color:var(--text-secondary); margin-bottom:8px;">Review the merged <code>config/local.yaml</code> below before applying. The existing file is backed up to <code>local.yaml.bak</code> on apply.</p>
          <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
            <div>
              <div class="config-label">BEFORE (current local.yaml)</div>
              <pre id="config-before" class="code-preview" style="max-height:280px; overflow:auto; margin:0;">&nbsp;</pre>
            </div>
            <div>
              <div class="config-label">AFTER (merged)</div>
              <pre id="config-after" class="code-preview" style="max-height:280px; overflow:auto; margin:0;">&nbsp;</pre>
            </div>
          </div>
          <div class="form-actions" style="margin-top:12px;">
            <button type="button" class="btn-primary" onclick="applyGeneratedConfig()">✅ Apply Merged Config</button>
            <button type="button" class="close-btn-secondary" onclick="dismissConfigPreview()">Discard</button>
          </div>
        </div>
      </div>

      <!-- Config Prompt Assistant — RIGHT of Generate Config from Profile -->
      <div class="config-card">
        <div class="config-card-header">
          <h3>💬 Config Prompt Assistant</h3>
          <span class="pill pill-info">AI Suggestions</span>
        </div>
        <p class="card-subtitle" style="margin-bottom:12px; color:var(--text-secondary); font-size:13px;">Describe your target jobs in plain language to get keyword suggestions for <code>config/local.yaml</code></p>
        <div style="display:flex; gap:10px; margin-bottom:12px; flex-wrap:wrap;">
          <input type="text" id="config-chat-input" class="form-control" placeholder='e.g. "Focus on Remote Embedded Linux and Freelance AI jobs in India"' style="flex:1; min-width:240px;">
          <button onclick="sendConfigPrompt()" class="btn-primary" style="flex-shrink:0;">💡 Get Suggestions</button>
        </div>
        <div id="config-chat-response" style="background:var(--bg-elevated); border:1px solid var(--border); border-radius:var(--radius-sm); padding:12px; font-family:var(--mono); font-size:12px; white-space:pre-wrap; color:var(--text-secondary); display:none;"></div>
      </div>

      <!-- LLM Token Usage & Cost Estimation Calculator — FULL WIDTH -->
      <div class="config-card config-card-full" id="card-cost-estimator">
        <div class="config-card-header">
          <h3>💰 LLM Token Usage &amp; Batch Cost Estimator</h3>
          <span class="pill pill-info">Live Analytics &amp; Projections</span>
        </div>
        <p class="card-subtitle" style="margin-bottom:14px; color:var(--text-secondary); font-size:13px;">
          Calculate token consumption, caching benefits, and projected API costs ($ / ₹) to tailor and render shortlisted jobs at scale.
        </p>

        <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap:16px; margin-bottom:16px;">
          <!-- Live Token Benchmark Stats -->
          <div style="background:var(--bg-elevated); border:1px solid var(--border); border-radius:var(--radius-sm); padding:14px;">
            <div style="font-size:12px; font-weight:600; text-transform:uppercase; color:var(--text-muted); margin-bottom:8px;">📊 Token Consumption Baseline (Per Job)</div>
            <div style="display:flex; justify-content:space-between; padding:4px 0; font-size:13px; border-bottom:1px solid var(--border-subtle);">
              <span>Input Tokens (JD + Profile):</span>
              <strong style="color:hsl(207 90% 54%);">~1,250 tokens</strong>
            </div>
            <div style="display:flex; justify-content:space-between; padding:4px 0; font-size:13px; border-bottom:1px solid var(--border-subtle);">
              <span>Output Tokens (Tailored Bullets):</span>
              <strong style="color:hsl(160 84% 39%);">~420 tokens</strong>
            </div>
            <div style="display:flex; justify-content:space-between; padding:4px 0; font-size:13px; border-bottom:1px solid var(--border-subtle);">
              <span>Prompt Cache Read Hit Rate:</span>
              <strong style="color:hsl(270 70% 60%);">~85% hit rate (-80% cost)</strong>
            </div>
            <div style="display:flex; justify-content:space-between; padding:4px 0; font-size:13px;">
              <span>Local Fast-Path Strategy:</span>
              <strong style="color:hsl(160 84% 39%);">$0.00 (0 tokens, &lt;1ms)</strong>
            </div>
          </div>

          <!-- Interactive Batch Calculator -->
          <div style="background:var(--bg-elevated); border:1px solid var(--border); border-radius:var(--radius-sm); padding:14px;">
            <div style="font-size:12px; font-weight:600; text-transform:uppercase; color:var(--text-muted); margin-bottom:8px;">🧮 Interactive Batch Cost Estimator</div>
            <div style="display:flex; gap:10px; margin-bottom:10px; flex-wrap:wrap;">
              <div style="flex:1; min-width:140px;">
                <label style="font-size:11px; color:var(--text-muted); display:block; margin-bottom:2px;">Target Model</label>
                <select id="estimator-model" class="form-control" onchange="calculateCostEstimate()" style="padding:4px 8px; font-size:12px;">
                  <option value="local">Local Deterministic ($0.00 / Zero Cost)</option>
                  <option value="gemini-flash" selected>Gemini 2.0 / 3.7 Flash ($0.10/M tokens)</option>
                  <option value="deepseek-v3">DeepSeek V3 / R1 ($0.27/M tokens)</option>
                  <option value="claude-haiku">Claude 3.5 Haiku ($0.80/M tokens)</option>
                  <option value="claude-sonnet">Claude 3.7 Sonnet ($3.00/M tokens)</option>
                  <option value="gpt-4o-mini">OpenAI GPT-4o-mini ($0.15/M tokens)</option>
                </select>
              </div>
              <div style="width:110px;">
                <label style="font-size:11px; color:var(--text-muted); display:block; margin-bottom:2px;">Shortlisted Jobs</label>
                <input type="number" id="estimator-jobs-count" class="form-control" value="100" min="1" max="1000" oninput="calculateCostEstimate()" style="padding:4px 8px; font-size:12px; text-align:center;">
              </div>
            </div>

            <div style="background:hsl(217 33% 10%); border-radius:var(--radius-sm); padding:10px 12px; display:flex; justify-content:space-between; align-items:center;">
              <div>
                <div style="font-size:11px; color:var(--text-muted);">Estimated Batch Total:</div>
                <div id="estimator-cost-usd" style="font-size:18px; font-weight:700; color:hsl(160 84% 39%);">$0.04 USD</div>
                <div id="estimator-cost-inr" style="font-size:11px; color:var(--text-muted);">≈ ₹3.40 INR</div>
              </div>
              <div style="text-align:right;">
                <div style="font-size:11px; color:var(--text-muted);">Est. Processing Time:</div>
                <div id="estimator-time" style="font-size:14px; font-weight:600; color:hsl(207 90% 54%);">~12 seconds</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Profile Import + Editable Profile Card — FULL WIDTH -->
      <div class="config-card config-card-full">
        <div class="config-card-header">
          <h3>👤 Candidate Profile</h3>
          <span class="pill pill-info">Upload &amp; Edit</span>
        </div>
        <!-- Multi-file Upload (Resume + LinkedIn ZIP) -->
        <form id="profile-import-form" onsubmit="importProfile(event)" class="config-form" style="margin-bottom:16px;">
          <div style="display:flex; gap:12px; flex-wrap:wrap; margin-bottom:8px;">
            <div class="form-group" style="flex:1; min-width:220px;">
              <label for="profile-resume-file">📄 Resume (PDF / DOCX)</label>
              <input type="file" id="profile-resume-file" name="resume" class="form-control" accept=".pdf,.doc,.docx,.yaml,.json">
            </div>
            <div class="form-group" style="flex:1; min-width:220px;">
              <label for="profile-linkedin-file">💼 LinkedIn Export ZIP</label>
              <input type="file" id="profile-linkedin-file" name="linkedin" class="form-control" accept=".zip,.pdf">
            </div>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn-primary">📥 Import &amp; Extract Profile</button>
            <span id="import-status" class="save-status"></span>
          </div>
        </form>
        <div id="import-apply-actions" style="display:none; margin-bottom:16px;">
          <button type="button" class="btn-primary" onclick="applyImportedProfile()">✅ Apply Imported Profile</button>
          <span class="save-status">Imported draft is ready — review the fields below, then apply. The current profile is backed up before replacement.</span>
        </div>
        <!-- Inline Editable Profile Form -->
        <div id="profile-editor" style="border-top:1px solid var(--border); padding-top:16px;">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
            <h4 style="color:var(--text-secondary); font-size:13px; font-weight:600; margin:0;">PROFILE DETAILS &amp; SKILLS MATRIX</h4>
            <button type="button" class="btn-primary btn-sm" onclick="toggleYamlEditor()" style="background:var(--bg-elevated); border:1px solid var(--border);">📝 Toggle Raw YAML</button>
          </div>

          <div id="profile-structured-editor">
            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap:12px; margin-bottom:12px;">
              <div class="form-group">
                <label for="pf-name">Full Name</label>
                <input type="text" id="pf-name" class="form-control" value="{{ view.config.profile.name | default(value='') }}" placeholder="Kamal Pandey">
              </div>
              <div class="form-group">
                <label for="pf-email">Email</label>
                <input type="email" id="pf-email" class="form-control" value="{{ view.config.profile.email | default(value='') }}" placeholder="you@example.com">
              </div>
              <div class="form-group">
                <label for="pf-phone">Phone</label>
                <input type="text" id="pf-phone" class="form-control" value="{{ view.config.profile.phone | default(value='') }}" placeholder="+91 7767984205">
              </div>
              <div class="form-group">
                <label for="pf-location">Location</label>
                <input type="text" id="pf-location" class="form-control" value="{{ view.config.profile.location | default(value='') }}" placeholder="Gurugram, Haryana, India">
              </div>
            </div>

            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap:12px; margin-bottom:12px;">
              <div class="form-group">
                <label for="pf-github">GitHub URL</label>
                <input type="text" id="pf-github" class="form-control" value="{{ view.config.profile.github | default(value='') }}" placeholder="https://github.com/justdoGIT">
              </div>
              <div class="form-group">
                <label for="pf-linkedin">LinkedIn URL</label>
                <input type="text" id="pf-linkedin" class="form-control" value="{{ view.config.profile.linkedin | default(value='') }}" placeholder="https://www.linkedin.com/in/...">
              </div>
              <div class="form-group">
                <label for="pf-portfolio">Portfolio</label>
                <input type="text" id="pf-portfolio" class="form-control" value="{{ view.config.profile.portfolio | default(value='') }}" placeholder="https://...">
              </div>
            </div>

            <div class="form-group" style="margin-bottom:12px;">
              <label for="pf-summary">Professional Summary</label>
              <textarea id="pf-summary" class="form-control" rows="3" placeholder="Senior Embedded System Architect with expertise in Qualcomm-based embedded Linux, Yocto BSP...">{{ view.config.profile.summary | default(value='') }}</textarea>
            </div>

            <div class="form-group" style="margin-bottom:12px;">
              <label for="pf-roles">Target Roles (comma-separated)</label>
              <input type="text" id="pf-roles" class="form-control" value="{{ view.config.profile.target_roles | default(value=[]) | join(sep=', ') }}" placeholder="Senior Embedded Developer, Software Architect, AI Solution Architect">
            </div>

            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap:12px; margin-top:12px;">
              <div class="form-group">
                <label for="pf-languages">Languages (comma-separated)</label>
                <input type="text" id="pf-languages" class="form-control" value="{{ view.config.profile.languages | default(value=[]) | join(sep=', ') }}" placeholder="C, C++, Rust, Python, Bash, QT/QML">
              </div>
              <div class="form-group">
                <label for="pf-platforms">Platforms &amp; Silicon Hardware</label>
                <input type="text" id="pf-platforms" class="form-control" value="{{ view.config.profile.platforms | default(value=[]) | join(sep=', ') }}" placeholder="Qualcomm QCM2290, TI AM665x, NXP i.MX8, Xilinx ZynqMP">
              </div>
              <div class="form-group">
                <label for="pf-frameworks">Frameworks &amp; Board Bring-Up</label>
                <input type="text" id="pf-frameworks" class="form-control" value="{{ view.config.profile.frameworks | default(value=[]) | join(sep=', ') }}" placeholder="Yocto BSP, Device Drivers, U-Boot, Kernel, Device Trees">
              </div>
              <div class="form-group">
                <label for="pf-devops">DevOps &amp; OTA Updates</label>
                <input type="text" id="pf-devops" class="form-control" value="{{ view.config.profile.devops | default(value=[]) | join(sep=', ') }}" placeholder="OSTree, SOTA, Docker, Kubernetes, CI/CD">
              </div>
              <div class="form-group">
                <label for="pf-tools">Lab Tools &amp; Hardware Instruments</label>
                <input type="text" id="pf-tools" class="form-control" value="{{ view.config.profile.tools | default(value=[]) | join(sep=', ') }}" placeholder="Oscilloscopes, Logic Analyzers, Multimeters, PCB Design">
              </div>
              <div class="form-group">
                <label for="pf-debugging">Low-Level Debugging &amp; Tracing</label>
                <input type="text" id="pf-debugging" class="form-control" value="{{ view.config.profile.debugging | default(value=[]) | join(sep=', ') }}" placeholder="JTAG, Kernel Tracing (ftrace), GDB, Valgrind">
              </div>
              <div class="form-group" style="grid-column: 1 / -1;">
                <label for="pf-protocols">Protocols &amp; Buses</label>
                <input type="text" id="pf-protocols" class="form-control" value="{{ view.config.profile.protocols | default(value=[]) | join(sep=', ') }}" placeholder="CAN Bus (J1939), MQTT, WebRTC, RTSP/RTP, TCP/IP, UART, I2C/I3C, SPI, USB/Modbus">
              </div>
            </div>
          </div>

          <div id="profile-yaml-editor" style="display:none; margin-top:12px;">
            <div class="form-group">
              <label for="pf-raw-yaml">Raw Profile YAML (<code>profile/profile.yaml</code>)</label>
              <textarea id="pf-raw-yaml" class="form-control" rows="18" style="font-family:var(--mono); font-size:12px; line-height:1.45; tab-size:2;" placeholder="personal:\n  name: ...">{{ view.config.profile.raw_yaml | default(value='') }}</textarea>
            </div>
          </div>

          <div class="form-actions" style="margin-top:16px;">
            <button type="button" class="btn-primary" onclick="saveProfile()">💾 Save Profile</button>
            <span id="profile-save-status" class="save-status"></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- TAB 4: ACTION & INTERVIEW CENTER -->
  <div id="tab-actions" class="tab-panel">
    <div class="panel-header mission-panel-head head-actions">
      <div class="panel-head-main">
        <span class="panel-kicker"><i></i> Human checkpoint</span>
        <h2>Where automation hands the wheel back to you.</h2>
        <p class="panel-desc">Review high-impact decisions, prepare for live conversations, and keep every submission intentionally controlled.</p>
      </div>
      <div class="panel-head-stats">
        <div><small>Drafted reviews</small><strong>{{ view.state_counts.drafted }}</strong></div>
        <div><small>Active actions</small><strong>{{ view.action_items | length }}</strong></div>
        <span class="panel-live"><i></i> Human approval armed</span>
      </div>
    </div>

    <div class="actions-container">
      <div class="action-command-deck">
        <article class="action-lane lane-review">
          <span class="lane-index">01</span>
          <div class="lane-icon">✓</div>
          <small>Approval queue</small>
          <h3>Review before the world sees it.</h3>
          <p>Inspect tailored packets and LinkedIn drafts before any final submission leaves the system.</p>
          <button type="button" onclick="runCliCommand('review', {}, this)">Open {{ view.state_counts.drafted }} drafted reviews <span>→</span></button>
        </article>
        <article class="action-lane lane-interview">
          <span class="lane-index">02</span>
          <div class="lane-icon">◇</div>
          <small>Interview studio</small>
          <h3>Turn every response into readiness.</h3>
          <p>Generate role-specific talking points, system-design drills, and evidence from your own career story.</p>
          <button type="button" onclick="switchTab('chat'); usePromptChip('Create an interview preparation plan from my active applications and candidate profile')">Build a prep plan <span>→</span></button>
        </article>
        <article class="action-lane lane-guardrail">
          <span class="lane-index">03</span>
          <div class="lane-icon">⌁</div>
          <small>Safety controls</small>
          <h3>Fast execution. Visible boundaries.</h3>
          <p>Dry-run defaults, traceable transitions, and explicit approval keep speed from becoming risk.</p>
          <button type="button" onclick="switchTab('commands')">Inspect command controls <span>→</span></button>
        </article>
      </div>

      <!-- Quick Actions: interview prep, email outreach, negotiation -->
      <div class="quick-actions-row" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:10px; margin-bottom:16px;">
        <div class="quick-action-card">
          <div class="quick-action-icon">🎤</div>
          <div class="quick-action-body">
            <div class="quick-action-label">Interview Prep</div>
            <p class="quick-action-desc">Generate STAR stories + role-specific questions from your profile.</p>
            <button type="button" class="btn-primary btn-sm" onclick="switchTab('commands'); setTimeout(function(){ var sel=document.getElementById('cmd-select'); if(sel){ sel.value='interview'; sel.dispatchEvent(new Event('change')); } }, 100);">Generate Prep <span>→</span></button>
        </div>
        </div>
        <div class="quick-action-card">
          <div class="quick-action-icon">✉️</div>
          <div class="quick-action-body">
            <div class="quick-action-label">Cold Email</div>
            <p class="quick-action-desc">Draft a personalized outreach email to a hiring manager or recruiter.</p>
            <button type="button" class="btn-primary btn-sm" onclick="switchTab('commands'); setTimeout(function(){ var sel=document.getElementById('cmd-select'); if(sel){ sel.value='email'; sel.dispatchEvent(new Event('change')); } }, 100);">Draft Email <span>→</span></button>
        </div>
        </div>
        <div class="quick-action-card">
          <div class="quick-action-icon">💼</div>
          <div class="quick-action-body">
            <div class="quick-action-label">Negotiate</div>
            <p class="quick-action-desc">Generate a salary negotiation script with talking points and market data.</p>
            <button type="button" class="btn-primary btn-sm" onclick="switchTab('commands'); setTimeout(function(){ var sel=document.getElementById('cmd-select'); if(sel){ sel.value='negotiate'; sel.dispatchEvent(new Event('change')); } }, 100);">Build Script <span>→</span></button>
        </div>
        </div>
        <div class="quick-action-card">
          <div class="quick-action-icon">📈</div>
          <div class="quick-action-body">
            <div class="quick-action-label">Upskill Plan</div>
            <p class="quick-action-desc">Identify skill gaps and generate a targeted learning plan for target roles.</p>
            <button type="button" class="btn-primary btn-sm" onclick="runCliCommand('upskill', {}, this)">Analyze Gaps <span>→</span></button>
        </div>
        </div>
      </div>

      <div class="actions-section">
        <h3>📝 Drafted Applications Awaiting Approval</h3>
        <button type="button" class="btn-primary" onclick="runCliCommand('review', {}, this)" style="margin:8px 0 12px; padding:6px 12px; font-size:12px;">🔍 Review Drafted LinkedIn</button>
        {% if view.action_items | length == 0 %}
        <div class="empty-card">
          <span>✨ No pending drafted applications requiring manual review right now.</span>
        </div>
        {% else %}
        <div class="actions-grid">
          {% for item in view.action_items %}
          <div class="action-card action-kind-{{ item.action_type }}">
            <div class="action-card-header">
              <div>
                <h4 class="action-title">{{ item.title }}</h4>
                <span class="action-company">🏢 {{ item.company }}</span>
              </div>
              {% if item.score %}
              <span class="score-badge score-high">{{ (item.score * 100) | round(method="floor") }}%</span>
              {% endif %}
            </div>
            <div class="action-card-footer">
              <span class="action-state-pill">{{ item.state }}</span>
              {% if item.action_url %}
              <a href="{{ item.action_url | posting_url }}" target="_blank" rel="noopener" class="action-btn">{{ item.action_label }} ↗</a>
              {% else %}
              <button class="action-btn" onclick="openAppModal('{{ item.id | js | safe }}')">{{ item.action_label }} →</button>
              {% endif %}
            </div>
          </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- TAB 5: DISCOVERED & FILTERED EXPLORER -->
  <div id="tab-explorer" class="tab-panel">
    <div class="panel-header mission-panel-head head-explorer">
      <div class="panel-head-main">
        <span class="panel-kicker"><i></i> Opportunity space</span>
        <h2>The job market, reduced to signal.</h2>
        <p class="panel-desc">Search the entire discovery universe, inspect why roles moved, and restore high-potential opportunities in one move.</p>
      </div>
      <div class="panel-head-stats">
        <div><small>Indexed listings</small><strong id="explorer-count">{{ view.explorer_total }}</strong></div>
        <div><small>Shortlisted</small><strong>{{ view.state_counts.shortlisted }}</strong></div>
        <span class="panel-live"><i></i> Ranking surface ready</span>
      </div>
    </div>

    <div class="copilot-hint-banner" style="background:hsl(217 33% 15%); border:1px solid hsl(217 33% 25%); border-left:4px solid hsl(207 90% 54%); border-radius:var(--radius-sm); padding:10px 14px; margin-bottom:16px; display:flex; justify-content:space-between; align-items:center; gap:12px;">
      <div style="font-size:13px; color:var(--text-primary); display:flex; align-items:center; gap:8px;">
        <span>💡 <strong>Explorer Hint:</strong> Browse all discovered & filtered listings. Filter by source or score threshold. If an important job was filtered out, click <em>"⚡ Force Shortlist"</em> to restore it.</span>
      </div>
      <button type="button" class="btn-primary" onclick="switchTab('chat'); usePromptChip('Analyze my current job match pipeline statistics')" style="padding:4px 10px; font-size:11px; white-space:nowrap;">🤖 Match Diagnostics ↗</button>
    </div>

    <div class="saved-search-toolbar"><span>Quick views</span><button type="button" data-search-preset="all">All opportunities</button><button type="button" data-search-preset="remote">Remote opportunities</button><button type="button" id="save-search-toggle">＋ Save this search</button><div id="saved-searches" aria-label="Saved searches"></div></div>
    <form id="save-search-form" hidden><label for="saved-search-name">Search name</label><input id="saved-search-name" class="form-control" maxlength="40" required placeholder="e.g. Remote Rust roles"><button class="btn-primary" type="submit">Save in this browser</button></form>
    <!-- E-Commerce Shopping-Style Multi-Select Filter Panel -->
    <div class="filter-panel-card" style="margin-bottom:16px;">
      <div class="filter-group-row">
        <span class="filter-group-title">📍 Location & Mode:</span>
        <label class="checkbox-pill"><input type="checkbox" id="flt-remote" onchange="filterExplorerTable()"> 🌐 Remote Only</label>
        <label class="checkbox-pill"><input type="checkbox" id="flt-india" onchange="filterExplorerTable()"> 🇮🇳 India / Gurugram</label>
        <label class="checkbox-pill"><input type="checkbox" id="flt-abroad" onchange="filterExplorerTable()"> ✈️ International / Abroad</label>
      </div>

      <div class="filter-group-row" style="margin-top:10px;">
        <span class="filter-group-title">💻 Tech Stack & Domain:</span>
        <label class="checkbox-pill"><input type="checkbox" id="flt-embedded" onchange="filterExplorerTable()"> 🔌 Embedded / Systems / Linux</label>
        <label class="checkbox-pill"><input type="checkbox" id="flt-ai" onchange="filterExplorerTable()"> 🤖 AI / ML / Robotics</label>
        <label class="checkbox-pill"><input type="checkbox" id="flt-software" onchange="filterExplorerTable()"> 💻 Fullstack / Web / Software</label>
        <label class="checkbox-pill"><input type="checkbox" id="flt-stem" onchange="filterExplorerTable()"> 🔬 STEM / Telecom / Physics</label>
      </div>

      <div class="filter-group-row" style="margin-top:10px;">
        <span class="filter-group-title">⚡ Listing Status:</span>
        <label class="checkbox-pill"><input type="checkbox" id="flt-state-discovered" onchange="filterExplorerTable()" checked> Active pipeline</label>
        <label class="checkbox-pill"><input type="checkbox" id="flt-state-filtered" onchange="filterExplorerTable()" checked> 🚫 Filtered Out</label>
        <button class="chip-btn" onclick="resetExplorerFilters()" style="margin-left:auto;">🔄 Reset All Filters</button>
      </div>
    </div>

    <div class="explorer-toolbar" style="display:flex; gap:10px; margin-bottom:16px; align-items:center;">
      <input aria-label="Search opportunities by title, company, location or source" type="search" id="explorer-search-input" class="form-control" placeholder="Search title, company, location or source…" oninput="filterExplorerTable()" style="flex:1;">
      <button type="button" class="btn-primary" onclick="runCliCommand('discover', {}, this)" style="padding:8px 14px; font-size:12px;">⚡ Run Discover</button>
      <button type="button" class="btn-primary" onclick="runCliCommand('match', {}, this)" style="padding:8px 14px; font-size:12px; background:hsl(160 84% 39%);">🎯 Run Matcher</button>
      <button type="button" class="btn-primary" onclick="runCliCommand('run', {}, this)" style="padding:8px 14px; font-size:12px; background:hsl(207 90% 54%);" title="Run the full pipeline (dry-run by default)">🚀 Run All</button>
    </div>

<p id="explorer-result-status" class="explorer-result-status" role="status"></p>
<p id="explorer-load-error" class="explorer-result-status" role="alert" hidden></p>
<div id="explorer-no-results" class="workspace-empty" hidden><strong>No roles match these filters.</strong>Try a broader search or <button class="text-button" onclick="resetExplorerFilters()">clear your filters</button>.</div>
        <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>Job Title</th>
            <th>ID</th>
            <th>Company</th>
            <th>Location</th>
            <th>Source</th>
            <th>State</th>
            <th>Score</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody id="explorer-tbody">
          {% if view.explorer_lazy %}
          <tr id="explorer-loading-row">
            <td colspan="8" class="empty-cell" style="text-align:center; padding:24px;">
              <span class="explorer-spinner"></span> Loading listings…
            </td>
          </tr>
          {% else %}
          {% if view.discovered_explorer | length == 0 %}
          <tr>
            <td colspan="8" class="empty-cell">No discovered jobs found in database. Run <code>careerai discover</code> to populate listings.</td>
          </tr>
          {% else %}
          {% for item in view.discovered_explorer %}
          <tr class="explorer-row" data-search="{% if item.title %}{{ item.title | lower }}{% endif %} {% if item.company %}{{ item.company | lower }}{% endif %} {% if item.location %}{{ item.location | lower }}{% endif %}" data-remote="{{ item.is_remote }}" data-state="{{ item.state }}">
            <td><a href="{{ item.url | posting_url }}" target="_blank" rel="noopener noreferrer" class="title-link">{% if item.title %}{{ item.title }}{% else %}Listing {{ item.id }}{% endif %}</a></td>
            <td><code class="listing-id-cell" title="Click to copy — use with `careerai tailor <id>`" onclick="copyCliCommand('{{ item.id | js | safe }}', this)">{{ item.id }}</code></td>
            <td>🏢 {% if item.company %}{{ item.company }}{% else %}Unspecified{% endif %} {% if item.legitimacy == "suspicious" %}<span class="legit-badge legit-suspicious" title="Suspicious listing — possible scam or ghost job">🔴</span>{% elif item.legitimacy == "caution" %}<span class="legit-badge legit-caution" title="Proceed with caution — minor red flags">🟡</span>{% else %}<span class="legit-badge legit-ok" title="No red flags detected">🟢</span>{% endif %}</td>
            <td>📍 {% if item.location %}{{ item.location }}{% else %}Remote / Unspecified{% endif %}</td>
            <td><span class="pill pill-info">{{ item.source }}</span></td>
            <td><span class="sev-badge sev-{% if item.state == 'discovered' %}info{% else %}warn{% endif %}">{{ item.state }}</span></td>
            <td>{% if item.score %}{{ (item.score * 100) | round(method="floor") }}%{% else %}—{% endif %}</td>
            <td>
              <button class="detail-link-btn" onclick="openAppModal('{{ item.id | js | safe }}')">Inspect →</button>
              {% if item.score %}
              <button class="detail-link-btn" style="margin-left:4px;" onclick="toggleMatchReasons('{{ item.id | js | safe }}', this)">Why?</button>
              {% endif %}
              {% if item.state == "discovered" or item.state == "filtered_out" %}
              <button class="btn-primary btn-sm" style="margin-left:4px;" onclick="forceShortlist('{{ item.id | js | safe }}')">⚡ Shortlist</button>
              {% elif item.state == "shortlisted" %}
              <button class="btn-primary btn-sm" style="margin-left:4px;" onclick="runCliCommand('tailor', {listing_id: '{{ item.id | js | safe }}'}, this)">✂️ Tailor</button>
              {% elif item.state == "tailored" and item.application_id %}
              <button class="btn-primary btn-sm" style="margin-left:4px;" onclick="runCliCommand('render', {application_id: '{{ item.application_id | js | safe }}'}, this)">📄 Render</button>
              {% elif item.state == "rendered" or item.state == "prepared" %}
              {% if item.application_id %}
              <button class="btn-primary btn-sm" style="margin-left:4px;" onclick="runCliCommand('apply', {application_id: '{{ item.application_id | js | safe }}'}, this)">📨 Apply</button>
              {% endif %}
              {% elif item.state == "drafted" %}
              <button class="btn-primary btn-sm" style="margin-left:4px;" onclick="openAppModal('{{ item.id | js | safe }}')">👀 Review Draft</button>
              {% elif item.state == "failed" and item.application_id %}
              <button class="btn-primary btn-sm" style="margin-left:4px;" onclick="runCliCommand('retry', {application_id: '{{ item.application_id | js | safe }}'}, this)">🔄 Retry</button>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
          {% endif %}
          {% endif %}
        </tbody>
      </table>
    </div>
  </div>
  <!-- TAB: REVIEW QUEUE (F03) -->
  <div id="tab-review" class="tab-panel">
    <div class="panel-header mission-panel-head head-review">
      <div class="panel-head-main">
        <span class="panel-kicker"><i></i> Approval checkpoint</span>
        <h2>Unified Review Queue</h2>
        <p class="panel-sub">Applications awaiting your explicit approval. JD, tailored resume, cover letter, and artifacts shown together. Stale or repeated clicks are rejected via content-version tracking.</p>
      </div>
    </div>
    <div id="review-queue-container" class="table-container">
      <table class="data-table" id="review-queue-table">
        <thead>
          <tr>
            <th>Job Title</th>
            <th>Company</th>
            <th>State</th>
            <th>Score</th>
            <th>Content</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="review-queue-tbody">
          <tr id="review-queue-loading">
            <td colspan="6" class="empty-cell" style="text-align:center; padding:24px;">
              <span class="explorer-spinner"></span> Loading review queue…
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <div id="review-detail-panel" hidden></div>
  </div>

  <!-- TAB 6: CLI COMMAND CENTER -->
  <div id="tab-commands" class="tab-panel">
    <div class="panel-header mission-panel-head head-commands">
      <div class="panel-head-main">
        <span class="panel-kicker"><i></i> Operator console</span>
        <h2>Power-user control, inside the cockpit.</h2>
        <p class="panel-desc">Run safe one-shots in place, compose ID-aware actions, or copy sensitive and long-running commands to the terminal.</p>
      </div>
      <div class="panel-head-stats">
        <div><small>Command groups</small><strong>{{ cli_groups | length }}</strong></div>
        <div><small>Execution model</small><strong>Local</strong></div>
        <span class="panel-live"><i></i> CLI parity connected</span>
      </div>
    </div>

    <div class="copilot-hint-banner" style="background:hsl(217 33% 15%); border:1px solid hsl(217 33% 25%); border-left:4px solid hsl(270 70% 60%); border-radius:var(--radius-sm); padding:10px 14px; margin-bottom:16px; display:flex; justify-content:space-between; align-items:center; gap:12px;">
      <div style="font-size:13px; color:var(--text-primary); display:flex; align-items:center; gap:8px;">
        <span>💡 <strong>Command Center Hint:</strong> Run one-shot CLI commands (`careerai discover`, `careerai match`, `careerai rematch`, `careerai run`) with real-time stdout/stderr streams.</span>
      </div>
      <button type="button" class="btn-primary" onclick="switchTab('chat'); usePromptChip('What does careerai rematch do?')" style="padding:4px 10px; font-size:11px; white-space:nowrap;">🤖 CLI Help ↗</button>
    </div>

    <div class="command-journey" id="command-journey">
      <aside class="journey-progress" aria-label="Command journey progress">
        <span class="journey-progress-orb" id="journey-progress-orb"></span>
        <i></i>
        <small>Foundation</small><small>Momentum</small><small>Autonomy</small>
      </aside>
      <div class="journey-chapters">
    {% for group in cli_groups %}
    <section class="cmd-group command-chapter journey-{% if group.name == 'Setup' %}foundation{% elif group.name == 'Pipeline' %}momentum{% elif group.name == 'Inspect' %}clarity{% elif group.name == 'Sources' %}reach{% elif group.name == 'Diagnose' %}resilience{% elif group.name == 'Credentials' %}trust{% elif group.name == 'Long-running' %}consistency{% else %}autonomy{% endif %}" data-chapter-index="{{ loop.index0 }}">
      <div class="chapter-marker" aria-hidden="true"><span>0{{ loop.index }}</span><i></i></div>
      <div class="chapter-body">
      <header class="command-chapter-head">
        <div class="chapter-symbol" aria-hidden="true"><i></i><b></b><span></span></div>
        <div>
          <span class="chapter-kicker">Chapter 0{{ loop.index }} · {{ group.name }}</span>
          <h3>{% if group.name == "Setup" %}Build the foundation.{% elif group.name == "Pipeline" %}Turn intent into momentum.{% elif group.name == "Inspect" %}Make progress visible.{% elif group.name == "Sources" %}Expand your opportunity horizon.{% elif group.name == "Diagnose" %}Keep the system resilient.{% elif group.name == "Credentials" %}Protect the keys to your search.{% elif group.name == "Long-running" %}Let consistency compound.{% else %}Graduate to autonomous operation.{% endif %}</h3>
          <p>{% if group.name == "Setup" %}A trustworthy career system begins with structured context.{% elif group.name == "Pipeline" %}Discover, qualify, tailor, render, and apply—each command advances the story.{% elif group.name == "Inspect" %}Evidence replaces uncertainty as every state becomes observable.{% elif group.name == "Sources" %}More thoughtful coverage creates more chances for the right role to find you.{% elif group.name == "Diagnose" %}Healthy feedback loops turn failures into recoverable moments.{% elif group.name == "Credentials" %}Sensitive access stays local, deliberate, and under your control.{% elif group.name == "Long-running" %}Small scheduled actions become a durable daily advantage.{% else %}The machinery disappears; your attention returns to interviews and decisions.{% endif %}</p>
        </div>
        <span class="cmd-group-count">{{ group.cards | length }} commands</span>
      </header>
      <div class="cmd-grid">
        {% for card in group.cards %}
        <article class="cmd-card cmd-{{ card.availability }}" data-command="{{ card.name }}" data-sequence="{{ loop.index0 }}">
          <div class="cmd-motion-glyph" aria-hidden="true"><i></i><i></i><i></i><span></span></div>
          <div class="cmd-head">
            <code class="cmd-argv">{{ card.argv }}</code>
            <span class="avail-badge avail-{{ card.availability }}">
              {% if card.availability == "runnable" %}run here{% elif card.availability == "needs_id" %}needs an id{% else %}terminal only{% endif %}
            </span>
          </div>
          <p class="cmd-summary">{{ card.summary }}</p>
          <p class="cmd-hint">{{ card.hint }}</p>
          <div class="cmd-actions">
            {% if card.availability == "runnable" %}
            <button type="button" class="btn-primary btn-sm" onclick="runCliCommand('{{ card.run_command | js | safe }}', {}, this)">▶ Run</button>
            {% elif card.availability == "needs_id" %}
            <input type="text" class="form-control cmd-id-input" placeholder="{% if card.name == 'tailor' %}listing id{% else %}application id{% endif %}" onkeydown="if(event.key==='Enter'){event.preventDefault();runCliCommandWithId('{{ card.run_command | js | safe }}', this, this.nextElementSibling);}">
            <button type="button" class="btn-primary btn-sm" onclick="runCliCommandWithId('{{ card.run_command | js | safe }}', this.previousElementSibling, this)">▶ Run</button>
            {% endif %}
            <button type="button" class="chip-btn cmd-copy" title="Copy CLI command" onclick="copyCliCommand('{{ card.argv | js | safe }}', this)">📋 Copy</button>
          </div>
        </article>
        {% endfor %}
      </div>
      </div>
    </section>
    {% endfor %}
      </div>
    </div>

    <!-- Static full-surface reference — works with JS disabled and is
         the copy-paste cheat sheet for the terminal. -->
    <details class="cli-cheatsheet">
      <summary>📜 Full CLI reference (static)</summary>
      <pre class="code-preview">careerai init                              bootstrap config/, profile/, .env
careerai config generate                   derive keywords + sources from profile
careerai profile import &lt;files&gt;           ingest resume PDF/DOCX + LinkedIn ZIP
careerai profile show                      print parsed profile.yaml
careerai profile validate                  validate profile.yaml against schema
careerai discover [--source X,Y]           pull new listings from job sources
careerai match [--tune]                    filter + rank discovered listings
careerai run [--auto-submit]               match → tailor → render → apply (dry-run default)
careerai tailor &lt;listing-id&gt;              LLM-tailor resume to one listing
careerai render &lt;application-id&gt;          render to DOCX + PDF via pandoc
careerai apply [--all] [--auto-submit]     submit prepared applications (dry-run default)
careerai retry &lt;application-id&gt;           reset a failed application and retry
careerai review                            review drafted LinkedIn Easy Apply packets
careerai shortlist show [--limit N]        list currently shortlisted listings
careerai applied [--source S] [--limit N]  show submitted applications
careerai inspect &lt;application-id&gt;         dump application row + history + artifacts
careerai digest [--since 24h]              daily pipeline summary
careerai patterns                          repost/ghost-job detection + funnel velocity
careerai upskill                           skill gap analysis vs shortlisted JDs
careerai analyze-profile                    ATS readiness + quantification audit
careerai interview &lt;listing-id&gt;            STAR stories + likely interview questions
careerai email &lt;listing-id&gt;                 draft a cold application email (draft-only)
careerai negotiate &lt;listing-id&gt;           salary negotiation script + talking points
careerai sources sync [--apply]            merge seeded ATS companies into local.yaml
careerai sources discover-web [--apply]    discover job portals via web-search agent
careerai mcp probe                         probe MCP job sources for reachability
careerai llm probe                         report + ping the resolved LLM backend
careerai notify test                       fire a test event through notify channels
careerai cookies refresh &lt;linkedin|naukri&gt; store session cookie in OS keyring
careerai daemon                            start the cron scheduler (foreground)
careerai status serve [--port N]           serve this dashboard
careerai service install [--force]         install systemd user unit
careerai service status                    systemctl --user status for careerai
careerai service uninstall                 disable + remove the systemd unit</pre>
    </details>
  </div>

  <!-- TAB: ANALYTICS -->
  <div id="tab-analytics" class="tab-panel">
    <div class="usage-summary">      <div class="kpi">
        <div class="kpi-num accent-rose">${{ view.llm_cost.total_cost_usd | round(precision=2) }}</div>
        <div class="kpi-label">LLM Cost</div>
        <div class="kpi-sub">{{ view.llm_cost.call_count }} calls · {{ view.llm_cost.model | default(value="—") }}</div>
      </div>
      <div class="kpi">
        <div class="kpi-num accent-cyan">{{ view.llm_cost.total_input_tokens }} + {{ view.llm_cost.total_output_tokens }}</div>
        <div class="kpi-label">Tokens Used</div>
        <div class="kpi-sub">{{ view.llm_cost.total_cache_read_tokens }} cache-read · {{ view.content_library.cover_letter_count }} letters in library</div>
      </div>
</div>
    <div class="panel-header" style="margin-bottom:16px;">
      <h2>📊 Pattern Analytics</h2>
      <p class="panel-sub">Repost detection, funnel velocity, advance rates, and rejection latencies across all sources.</p>
    </div>

    <div id="analytics-loading" style="text-align:center; padding:40px; color:var(--text-secondary);">
      Loading analytics data…
    </div>

    <div id="analytics-content" style="display:none;">
      <!-- LLM Cost + Content Library Summary -->
      <div class="analytics-cards-row" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:12px; margin-bottom:20px;">
        <div class="analytics-card" style="background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-sm); padding:14px;">
          <div style="font-size:11px; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em;">LLM Spend</div>
          <div style="font-size:22px; font-weight:700; color:var(--text-primary); margin-top:4px;">${{ view.llm_cost.total_cost_usd | round(precision=4) }}</div>
          <div style="font-size:12px; color:var(--text-secondary); margin-top:2px;">{{ view.llm_cost.call_count }} live calls · {{ view.llm_cost.total_cache_read_tokens }} cache-read tokens</div>
        </div>
        <div class="analytics-card" style="background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-sm); padding:14px;">
          <div style="font-size:11px; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em;">Content Library</div>
          <div style="font-size:22px; font-weight:700; color:var(--text-primary); margin-top:4px;">{{ view.content_library.cover_letter_count }} letters · {{ view.content_library.bullet_count }} bullets</div>
          <div style="font-size:12px; color:var(--text-secondary); margin-top:2px;">{{ view.content_library.domains | length }} domain{{ view.content_library.domains | length | pluralize }} indexed for reuse</div>
        </div>
        <div class="analytics-card" style="background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-sm); padding:14px;">
          <div style="font-size:11px; color:var(--text-secondary); text-transform:uppercase; letter-spacing:0.05em;">Model</div>
          <div style="font-size:16px; font-weight:700; color:var(--text-primary); margin-top:4px;">{{ view.llm_cost.model | default(value="No calls yet") }}</div>
          <div style="font-size:12px; color:var(--text-secondary); margin-top:2px;">Strategy: {{ view.config.llm_strategy }} · Backend: {{ view.config.llm_backend }}</div>
        </div>
      </div>

      <!-- Content Library Domains -->
      {% if view.content_library.domains | length > 0 %}
      <div style="margin-bottom:20px;">
        <h3 style="font-size:14px; margin-bottom:8px;">Content Library by Domain</h3>
        <table class="data-table">
          <thead>
            <tr><th>Domain</th><th>Role</th><th>Cover Letters</th><th>Bullets</th></tr>
          </thead>
          <tbody>
            {% for d in view.content_library.domains %}
            <tr>
              <td>{{ d.domain }}</td>
              <td>{{ d.role }}</td>
              <td>{{ d.cover_letters }}</td>
              <td>{{ d.bullets }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}

      <!-- Reposts -->
      <div style="margin-bottom:20px;">
        <h3 style="font-size:14px; margin-bottom:8px;">🔁 Repost Detection <span id="reposts-count" style="color:var(--text-secondary); font-weight:400;"></span></h3>
        <div id="analytics-reposts"></div>
      </div>

      <!-- Funnel Velocity -->
      <div style="margin-bottom:20px;">
        <h3 style="font-size:14px; margin-bottom:8px;">📈 Funnel Velocity by Source</h3>
        <div id="analytics-funnel"></div>
      </div>

      <!-- Advance Rates -->
      <div style="margin-bottom:20px;">
        <h3 style="font-size:14px; margin-bottom:8px;">🎯 Advance Rates (Submitted → Responded)</h3>
        <div id="analytics-advance"></div>
      </div>

      <!-- Rejection Latencies -->
      <div style="margin-bottom:20px;">
        <h3 style="font-size:14px; margin-bottom:8px;">⏱️ Rejection Latencies</h3>
        <div id="analytics-rejections"></div>
      </div>

      <!-- Source Attribution -->
      <div style="margin-bottom:20px;">
        <h3 style="font-size:14px; margin-bottom:8px;">🏆 Source Attribution — Best Performing Sources</h3>
        <div id="analytics-source-attribution"></div>
      </div>

      <!-- Application Timing Intelligence -->
      <div style="margin-bottom:20px;">
        <h3 style="font-size:14px; margin-bottom:8px;">📅 Application Timing Intelligence — Best Days to Submit</h3>
        <div id="analytics-timing"></div>
      </div>

      <!-- A/B Variant Tracking -->
      <div style="margin-bottom:20px;">
        <h3 style="font-size:14px; margin-bottom:8px;">🧪 A/B Variant Tracking — Which Resume Style Converts</h3>
        <div id="analytics-variants"></div>
      </div>

      <!-- Salary Benchmarking -->
      <div style="margin-bottom:20px;">
        <h3 style="font-size:14px; margin-bottom:8px;">💰 Salary Benchmarking</h3>
        <div id="analytics-salary"></div>
      </div>

      <!-- Weekly Market Pulse -->
      <div style="margin-bottom:20px;">
        <h3 style="font-size:14px; margin-bottom:8px;">📡 Weekly Market Pulse</h3>
        <div id="analytics-market-pulse"></div>
      </div>

      <!-- Follow-up Scheduler -->
      <div style="margin-bottom:20px;">
        <h3 style="font-size:14px; margin-bottom:8px;">📬 Follow-up Scheduler
          <button type="button" class="btn-primary" style="padding:3px 8px; font-size:10px; margin-left:8px;" onclick="checkFollowUps(this)">Check Now</button>
        </h3>
        <div id="analytics-follow-ups"></div>
      </div>

      <!-- Interview Feedback Loop -->
      <div style="margin-bottom:20px;">
        <h3 style="font-size:14px; margin-bottom:8px;">🎤 Interview Feedback Loop</h3>
        <div id="analytics-interview-feedback"></div>
        <details style="margin-top:8px;">
          <summary style="cursor:pointer; font-size:12px; color:var(--accent-cyan);">+ Log new interview feedback</summary>
          <div style="margin-top:10px; display:grid; gap:6px; max-width:500px;">
            <input id="fb-app-id" placeholder="Application ID" class="form-control" style="font-size:12px; padding:4px 8px;">
            <input id="fb-listing-id" placeholder="Listing ID" class="form-control" style="font-size:12px; padding:4px 8px;">
            <input id="fb-company" placeholder="Company" class="form-control" style="font-size:12px; padding:4px 8px;">
            <input id="fb-title" placeholder="Job Title" class="form-control" style="font-size:12px; padding:4px 8px;">
            <textarea id="fb-questions" placeholder="Questions asked (one per line)" class="form-control" style="font-size:12px; padding:4px 8px; min-height:60px;"></textarea>
            <label style="font-size:11px; color:var(--text-secondary);">Rating: <select id="fb-rating" style="font-size:12px;"><option value="5">5 - Excellent</option><option value="4">4 - Good</option><option value="3" selected>3 - OK</option><option value="2">2 - Poor</option><option value="1">1 - Bad</option></select></label>
            <textarea id="fb-went-well" placeholder="What went well" class="form-control" style="font-size:12px; padding:4px 8px;"></textarea>
            <textarea id="fb-improve" placeholder="What to improve" class="form-control" style="font-size:12px; padding:4px 8px;"></textarea>
            <button type="button" class="btn-primary" style="font-size:12px; padding:6px 12px; justify-self:start;" onclick="saveInterviewFeedback(this)">Save Feedback</button>
          </div>
        </details>
      </div>
    </div>
  </div>

  <!-- TAB 7: SPATIAL CAREER CANVAS -->
  <div id="tab-bounties" class="tab-panel">
    <div class="panel-header mission-panel-head head-bounties">
      <div class="panel-head-main">
        <span class="panel-kicker"><i></i> Reward hunting</span>
        <h2>Earn while you build. Bounties, hackathons & coding rewards.</h2>
        <p class="panel-desc">Curated platforms where developers win cash, prizes, and reputation. Filter by category, reward type, or skill match.</p>
      </div>
