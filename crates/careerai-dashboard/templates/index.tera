    } else {
      var msg = d.error || d.message || 'Failed';
      if (btn) btn.innerHTML = '❌ ' + msg;
      notif.error(msg);
      setTimeout(function() { if (btn) { btn.disabled = false; btn.innerHTML = orig; } }, 3000);
    }
  })
  .catch(function(err) {
    if (btn) btn.innerHTML = '❌ Error';
    notif.error(err.message || 'Network error');
    setTimeout(function() { if (btn) { btn.disabled = false; btn.innerHTML = orig; } }, 3000);
  });
}

