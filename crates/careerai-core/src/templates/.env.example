# Credentials. Copy to `.env` and fill in. `.env` is gitignored.
# Prefer OS keychain via the `keyring` crate; this file is the fallback.

# LLM providers (at least one required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: local Ollama endpoint
OLLAMA_HOST=http://127.0.0.1:11434

# Database
DATABASE_URL=sqlite://data/careerai.sqlite

# LinkedIn / Indeed session cookies are stored in the OS keychain at runtime,
# NOT in this file. Use `careerai auth login linkedin` (M5) to capture them.

# SMTP (only if using email-apply submitter)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Log level
RUST_LOG=careerai=info,info
